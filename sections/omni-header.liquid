<header class="omni-header">

  <div class="omni-header-inner">

    <!-- LEFT MENU -->
    <div class="omni-header-left">
      <a href="/collections/kids" class="omni-pill">Shop Kids</a>
      <a href="/collections/adults" class="omni-pill">Shop Adults</a>
    </div>

    <!-- LOGO -->
    <div class="omni-header-logo">
      <a href="{{ routes.root_url }}">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}">
        {% else %}
          {{ shop.name }}
        {% endif %}
      </a>
    </div>

    <!-- RIGHT ICONS -->
    <div class="omni-header-right">

      <a href="{{ routes.search_url }}" class="omni-icon">
        🔍
      </a>

      <a href="{{ routes.cart_url }}" class="omni-icon">
        🛒
        {% if cart.item_count > 0 %}
          <span class="omni-cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      <a href="{{ routes.account_url }}" class="omni-icon">
        👤
      </a>

    </div>

  </div>

</header>


<style>

.omni-header{
  background:#0a7a3e;
  padding:14px 40px;
}

.omni-header-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
}

/* LEFT */

.omni-header-left{
  display:flex;
  gap:12px;
}

.omni-pill{
  border:1px solid #ffd94c;
  color:#ffd94c;
  padding:6px 14px;
  border-radius:20px;
  font-size:13px;
  text-decoration:none;
}

/* LOGO */

.omni-header-logo{
  text-align:center;
}

.omni-header-logo img{
  height:32px;
}

/* RIGHT */

.omni-header-right{
  display:flex;
  gap:18px;
  align-items:center;
}

.omni-icon{
  color:#ffd94c;
  font-size:18px;
  position:relative;
  text-decoration:none;
}

.omni-cart-count{
  position:absolute;
  top:-6px;
  right:-10px;
  background:#ffd94c;
  color:#000;
  font-size:11px;
  padding:2px 6px;
  border-radius:10px;
}

@media(max-width:768px){

.omni-header-left{
  display:none;
}

}

</style>


{% schema %}
{
  "name": "OMNI Header",
  "settings": [],
  "presets": [
    {
      "name": "OMNI Header"
    }
  ]
}
{% endschema %}