{% style %}
.section-snackable-{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.section-snackable-{{ section.id }} .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.snackable-box {
  background: {{ section.settings.inner_bg }};
  border-radius: 25px;
  padding: 60px 40px;
}

.snackable-heading {
  text-align: center;
  margin-bottom: 50px;
}

.snackable-heading h2 {
  font-size: 42px;
  color: {{ section.settings.heading_color }};
  margin-bottom: 15px;
}

.snackable-heading p {
  max-width: 750px;
  margin: 0 auto;
  font-size: 18px;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
  text-align: center;
  margin-bottom: 40px;
}

.stat-item h3 {
  font-size: 70px;
  margin: 0;
  color: {{ section.settings.number_color }};
}

.stat-item p {
  margin-top: 15px;
  font-size: 15px;
}

.small-note {
  text-align: center;
  font-size: 13px;
  margin-top: 10px;
}

.divider {
  margin: 40px 0;
  border-top: 1px solid #999;
}

.quality-section {
  text-align: center;
}

.quality-section h3 {
  font-size: 34px;
  color: {{ section.settings.heading_color }};
  margin-bottom: 15px;
}

.quality-section p {
  max-width: 750px;
  margin: 0 auto 30px;
}

.quality-grid {
  display: grid;
  grid-template-columns: repeat(2, auto);
  justify-content: center;
  gap: 15px 40px;
}

.quality-item {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quality-item span.icon {
  color: #ff6a00;
  font-weight: bold;
}

/* Responsive */
@media (max-width: 991px) {
  .stats-row {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .stats-row {
    grid-template-columns: 1fr;
  }
}
{% endstyle %}

<section class="section-snackable-{{ section.id }} {{ section.settings.custom_class }}">
  <div class="container page page-width">
    <div class="snackable-box">

      <!-- Top Heading -->
      <div class="snackable-heading">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subheading }}</p>
      </div>

      <!-- Stats -->
      <div class="stats-row">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="stat-item" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.number }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.note != blank %}
        <div class="small-note">{{ section.settings.note }}</div>
      {% endif %}

      <div class="divider"></div>

      <!-- Quality Section -->
      <div class="quality-section">
        <h3>{{ section.settings.quality_heading }}</h3>
        <p>{{ section.settings.quality_text }}</p>

        <div class="quality-grid">
          {% for block in section.blocks %}
            {% if block.type == 'quality' %}
              <div class="quality-item" {{ block.shopify_attributes }}>
                <span class="icon">✖</span>
                <span>{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Snackable Tested Stats",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Top Heading",
      "default": "Snackable, Packable, Tested"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small Note Under Stats"
    },
    {
      "type": "text",
      "id": "quality_heading",
      "label": "Quality Heading",
      "default": "Quality You Can Trust"
    },
    {
      "type": "textarea",
      "id": "quality_text",
      "label": "Quality Description"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#dfe8e2"
    },
    {
      "type": "color",
      "id": "inner_bg",
      "label": "Inner Box Background",
      "default": "#efe2b6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0b6b3a"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Stats Number Color",
      "default": "#0b6b3a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "95%"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    },
    {
      "type": "quality",
      "name": "Quality Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Quality Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Snackable Tested Stats",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "quality" },
        { "type": "quality" },
        { "type": "quality" },
        { "type": "quality" }
      ]
    }
  ]
}
{% endschema %}