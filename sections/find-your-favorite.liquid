{% schema %}
{
  "name": "Find Your Favorite",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Find Your Favorite"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f3f3f3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show New Badge",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "New!"
        },
        {
          "type": "color",
          "id": "gradient_color_1",
          "label": "Gradient Color 1",
          "default": "#4CAF50"
        },
        {
          "type": "color",
          "id": "gradient_color_2",
          "label": "Gradient Color 2",
          "default": "#FFC107"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Find Your Favorite",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}

<section class="favorite-section {{ section.settings.custom_class }}"
  style="
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="favorite-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="favorite-grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product %}
        <div class="favorite-card" 
          style="background: linear-gradient(to bottom, {{ block.settings.gradient_color_1 }}, {{ block.settings.gradient_color_2 }});"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.show_badge %}
            <span class="favorite-badge">
              {{ block.settings.badge_text }}
            </span>
          {% endif %}

          <a href="{{ product.url }}">
            <div class="favorite-image">
              <img 
                src="{{ product.featured_image | image_url: width: 600 }}" 
                alt="{{ product.title }}"
                loading="lazy"
              >
            </div>
            <h3 class="favorite-title">
              {{ product.title }}
            </h3>
          </a>

        </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
.favorite-section {
  text-align: center;
}

.favorite-heading {
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 50px;
}

.favorite-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.favorite-card {
  position: relative;
  padding: 30px 20px;
  border-radius: 15px;
  transition: 0.3s ease;
}

.favorite-card:hover {
  transform: translateY(-5px);
}

.favorite-image img {
  max-width: 200px;
  margin: 0 auto 20px;
  display: block;
}

.favorite-title {
  font-size: 18px;
  font-weight: 600;
}

.favorite-badge {
  position: absolute;
  top: 15px;
  left: 15px;
  background: #ff9800;
  color: #fff;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 20px;
}

/* Responsive */
@media(max-width: 991px) {
  .favorite-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media(max-width: 576px) {
  .favorite-grid {
    grid-template-columns: 1fr;
  }

  .favorite-heading {
    font-size: 26px;
  }
}
</style>