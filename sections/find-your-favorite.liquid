{% schema %}
{
  "name": "Find Your Favorite",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Find Your Favorite"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0a6836"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f2f2f2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Upload Custom Image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text",
          "default": "Product Image"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show Badge",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "New!"
        },
        {
          "type": "color",
          "id": "gradient_color_1",
          "label": "Gradient Color Top",
          "default": "#38a169"
        },
        {
          "type": "color",
          "id": "gradient_color_2",
          "label": "Gradient Color Bottom",
          "default": "#f6ad55"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#002613"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Find Your Favorite",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}

<section 
  class="favorite-section {{ section.settings.custom_class }}"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="favorite-heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="favorite-grid">

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <div 
          class="favorite-card"
          style="background: linear-gradient(to bottom, {{ block.settings.gradient_color_1 }}, {{ block.settings.gradient_color_2 }});"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.show_badge %}
            <span class="favorite-badge">
              {{ block.settings.badge_text }}
            </span>
          {% endif %}

          {% assign card_link = product.url %}

          <a href="{{ card_link }}" class="favorite-link">

            <div class="favorite-image">

              {% if block.settings.custom_image != blank %}
                <img 
                  src="{{ block.settings.custom_image | image_url: width: 600 }}"
                  alt="{{ block.settings.image_alt | escape }}"
                  title="{{ block.settings.image_alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% elsif product %}
                <img 
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title | escape }}"
                  title="{{ product.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% endif %}

            </div>
          </a>

          <h3 class="favorite-title" style="color: {{ block.settings.title_color }};">
            <a href="{{ card_link }}">
              {% if block.settings.custom_title != blank %}
                {{ block.settings.custom_title }}
              {% elsif product %}
                {{ product.title }}
              {% endif %}
            </a>
          </h3>

        </div>
      {% endfor %}

    </div>
  </div>
</section>

<style>
.favorite-section {
  text-align: center;
}

.favorite-heading {
  font-size: 38px;
  font-weight: 700;
  margin-bottom: 50px;
}

.favorite-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.favorite-card {
  position: relative;
  padding: 40px 20px 30px;
  border-radius: 16px;
  transition: 0.3s ease;
}

.favorite-card:hover {
  transform: translateY(-6px);
}

.favorite-image img {
  max-width: 220px;
  width: 100%;
  margin: 0 auto 20px;
  display: block;
}

.favorite-title {
  font-size: 18px;
  font-weight: 600;
  margin-top: 10px;
}

.favorite-title a {
  text-decoration: none;
  color: inherit;
  transition: 0.3s ease;
}

.favorite-title a:hover {
  opacity: 0.7;
}

.favorite-badge {
  position: absolute;
  top: 15px;
  left: 15px;
  background: #ff9800;
  color: #fff;
  padding: 6px 14px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 20px;
}

.favorite-link {
  display: block;
  text-decoration: none;
}

@media (max-width: 991px) {
  .favorite-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 576px) {
  .favorite-grid {
    grid-template-columns: 1fr;
  }

  .favorite-heading {
    font-size: 28px;
  }
}
</style>