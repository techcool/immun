{% schema %}
{
  "name": "Find Your Favorite",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Find Your Favorite"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show Badge",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "New!"
        },
        {
          "type": "color",
          "id": "gradient_1",
          "label": "Top Gradient Color",
          "default": "#38a169"
        },
        {
          "type": "color",
          "id": "gradient_2",
          "label": "Bottom Gradient Color",
          "default": "#f6ad55"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Find Your Favorite",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}

<section class="favorite-wrapper">
  <div class="page-width">

    <h2 class="favorite-main-title">
      {{ section.settings.heading }}
    </h2>

    <div class="favorite-grid">

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product %}
        <div 
          class="favorite-card"
          style="background: linear-gradient(to bottom, {{ block.settings.gradient_1 }}, {{ block.settings.gradient_2 }});"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.show_badge %}
            <span class="favorite-badge">
              {{ block.settings.badge_text }}
            </span>
          {% endif %}

          <a href="{{ product.url }}" class="favorite-img-wrap">
            <img 
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >
          </a>

        </div>

        <!-- TITLE OUTSIDE CARD (IMPORTANT FIX) -->
        <div class="favorite-product-title">
          <a href="{{ product.url }}">
            {{ product.title }}
          </a>
        </div>

        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>

<style>
.favorite-wrapper {
  background: #efefef;
  padding: 80px 0;
  text-align: center;
}

.favorite-main-title {
  font-size: 40px;
  font-weight: 700;
  color: #137c3f;
  margin-bottom: 60px;
}

.favorite-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
  align-items: start;
}

.favorite-card {
  position: relative;
  border-radius: 16px;
  padding: 40px 20px;
  transition: 0.3s ease;
}

.favorite-card:hover {
  transform: translateY(-6px);
}

.favorite-img-wrap img {
  max-width: 220px;
  width: 100%;
  display: block;
  margin: 0 auto;
}

.favorite-badge {
  position: absolute;
  top: 15px;
  left: 15px;
  background: #ff9800;
  color: #fff;
  padding: 6px 14px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 20px;
}

/* TITLE FIX */
.favorite-product-title {
  margin-top: -15px;
  font-size: 18px;
  font-weight: 600;
  color: #002613;
}

.favorite-product-title a {
  text-decoration: none;
  color: #002613 !important;
}

/* Responsive */
@media (max-width: 991px) {
  .favorite-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 576px) {
  .favorite-grid {
    grid-template-columns: 1fr;
  }

  .favorite-main-title {
    font-size: 28px;
  }
}
</style>