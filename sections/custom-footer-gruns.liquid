{% style %}

.gruns-footer{
  position:relative;
  background:{{ section.settings.bg_color }};
  padding:80px 20px 40px;
  color:#fff;
  overflow:hidden;
}

.gruns-footer::before{
  content:"";
  position:absolute;
  inset:0;
  background-image:url({{ section.settings.pattern | image_url: width:2000 }});
  background-size:cover;
  background-position:center;
  opacity:{{ section.settings.pattern_opacity }};
  pointer-events:none;
}

.gruns-container{
  position:relative;
  max-width:1250px;
  margin:auto;
}

.gruns-grid{
  display:grid;
  grid-template-columns:1.4fr 1fr 1fr 1fr;
  gap:50px;
}

.gruns-newsletter h2{
  font-size:28px;
  font-weight:700;
  margin-bottom:20px;
}

.gruns-input{
  display:flex;
  border-radius:6px;
  overflow:hidden;
}

.gruns-input input{
  flex:1;
  padding:15px;
  border:none;
  font-size:15px;
}

.gruns-input button{
  width:60px;
  background:#FFC629;
  border:none;
  font-size:18px;
  cursor:pointer;
  transition:.3s;
}

.gruns-input button:hover{
  background:#ffb400;
}

.gruns-links h4{
  font-size:20px;
  margin-bottom:15px;
}

.gruns-links ul{
  padding:0;
  list-style:none;
}

.gruns-links li{
  margin-bottom:8px;
}

.gruns-links a{
  color:#fff;
  text-decoration:none;
  opacity:.85;
  transition:.25s;
}

.gruns-links a:hover{
  opacity:1;
  transform:translateX(4px);
}

.gruns-logo img{
  max-width:150px;
}

.gruns-social{
  display:flex;
  gap:10px;
  margin-top:20px;
}

.gruns-social a{
  width:36px;
  height:36px;
  background:#fff;
  color:#000;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:6px;
  font-size:14px;
  transition:.3s;
}

.gruns-social a:hover{
  transform:translateY(-3px);
}

.gruns-bottom{
  border-top:1px solid rgba(255,255,255,.2);
  margin-top:50px;
  padding-top:20px;
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:10px;
  font-size:14px;
}

.gruns-bottom a{
  color:#fff;
  margin-left:12px;
  text-decoration:none;
  opacity:.8;
}

.gruns-bottom a:hover{
  opacity:1;
}

@media(max-width:900px){

.gruns-grid{
grid-template-columns:1fr;
gap:40px;
}

.gruns-bottom{
flex-direction:column;
}

}

{% endstyle %}


<footer class="gruns-footer">

<div class="gruns-container">

<div class="gruns-grid">

<!-- Newsletter -->
<div class="gruns-newsletter">

<h2>{{ section.settings.heading }}</h2>

<div class="gruns-input">
<input type="text" placeholder="Phone number">
<button>→</button>
</div>

{% if section.settings.alt_text != blank %}
<p style="margin-top:10px;">
<a href="#">{{ section.settings.alt_text }}</a>
</p>
{% endif %}

{% if section.settings.disclaimer != blank %}
<p style="font-size:12px;margin-top:10px;opacity:.7;">
{{ section.settings.disclaimer }}
</p>
{% endif %}

</div>


<!-- Menu 1 -->
<div class="gruns-links">

<h4>{{ section.settings.menu1_title }}</h4>

<ul>
{% for link in linklists[section.settings.menu1].links %}
<li>
<a href="{{ link.url }}">{{ link.title }}</a>
</li>
{% endfor %}
</ul>

</div>


<!-- Menu 2 -->
<div class="gruns-links">

<h4>{{ section.settings.menu2_title }}</h4>

<ul>
{% for link in linklists[section.settings.menu2].links %}
<li>
<a href="{{ link.url }}">{{ link.title }}</a>
</li>
{% endfor %}
</ul>

</div>


<!-- Logo & Social -->
<div class="gruns-logo">

{% if section.settings.logo != blank %}
<img src="{{ section.settings.logo | image_url: width:300 }}">
{% endif %}

<div class="gruns-social">

{% if settings.social_instagram_link != blank %}
<a href="{{ settings.social_instagram_link }}">IG</a>
{% endif %}

{% if settings.social_tiktok_link != blank %}
<a href="{{ settings.social_tiktok_link }}">TT</a>
{% endif %}

{% if settings.social_youtube_link != blank %}
<a href="{{ settings.social_youtube_link }}">YT</a>
{% endif %}

{% if settings.social_facebook_link != blank %}
<a href="{{ settings.social_facebook_link }}">FB</a>
{% endif %}

</div>

</div>

</div>


<div class="gruns-bottom">

<div>
© {{ 'now' | date: "%Y" }} {{ shop.name }}
</div>

<div>

{% if shop.policies.refund_policy != blank %}
<a href="{{ shop.policies.refund_policy.url }}">Refund Policy</a>
{% endif %}

{% if shop.policies.privacy_policy != blank %}
<a href="{{ shop.policies.privacy_policy.url }}">Privacy Policy</a>
{% endif %}

{% if shop.policies.terms_of_service != blank %}
<a href="{{ shop.policies.terms_of_service.url }}">Terms</a>
{% endif %}

{% if shop.policies.shipping_policy != blank %}
<a href="{{ shop.policies.shipping_policy.url }}">Shipping</a>
{% endif %}

</div>

</div>

</div>

</footer>


{% schema %}
{
"name":"Gruns Footer",
"settings":[
{
"type":"color",
"id":"bg_color",
"label":"Background Color",
"default":"#063c28"
},
{
"type":"image_picker",
"id":"pattern",
"label":"Background Pattern"
},
{
"type":"range",
"id":"pattern_opacity",
"label":"Pattern Opacity",
"min":0,
"max":1,
"step":0.1,
"default":0.2
},
{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Sign Up for 52% Off"
},
{
"type":"text",
"id":"alt_text",
"label":"Alt Text",
"default":"Email me instead"
},
{
"type":"textarea",
"id":"disclaimer",
"label":"Disclaimer"
},
{
"type":"text",
"id":"menu1_title",
"label":"Menu 1 Title",
"default":"Learn"
},
{
"type":"link_list",
"id":"menu1",
"label":"Menu 1"
},
{
"type":"text",
"id":"menu2_title",
"label":"Menu 2 Title",
"default":"Connect"
},
{
"type":"link_list",
"id":"menu2",
"label":"Menu 2"
},
{
"type":"image_picker",
"id":"logo",
"label":"Footer Logo"
}
],
"presets":[
{
"name":"Gruns Footer"
}
]
}
{% endschema %}