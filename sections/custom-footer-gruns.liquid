{% style %}

.gruns-footer{
background:{{ section.settings.bg_color }};
color:#fff;
padding:80px 20px 40px;
position:relative;
overflow:hidden;
}

.gruns-footer:before{
content:"";
position:absolute;
top:0;
left:0;
width:100%;
height:100%;
background:url({{ section.settings.pattern | image_url: width:2000 }});
opacity:{{ section.settings.pattern_opacity }};
background-size:cover;
pointer-events:none;
}

.gruns-container{
max-width:1300px;
margin:auto;
position:relative;
}

.gruns-grid{
display:grid;
grid-template-columns:1.4fr 1fr 1fr 1fr;
gap:50px;
}

.gruns-newsletter h2{
color:#FFC629;
font-size:26px;
margin-bottom:20px;
}

.gruns-input{
display:flex;
}

.gruns-input input{
flex:1;
padding:15px;
border:none;
font-size:15px;
}

.gruns-input button{
width:60px;
background:#FFC629;
border:none;
font-size:18px;
cursor:pointer;
}

.gruns-links h4{
color:#FFC629;
margin-bottom:14px;
font-size:20px;
}

.gruns-links ul{
list-style:none;
padding:0;
}

.gruns-links li{
margin-bottom:8px;
}

.gruns-links a{
color:#fff;
text-decoration:none;
opacity:.85;
}

.gruns-links a:hover{
opacity:1;
}

.gruns-logo{
margin-top:40px;
}

.gruns-social{
display:flex;
gap:10px;
margin-top:10px;
}

.gruns-social a{
width:36px;
height:36px;
background:#fff;
color:#000;
display:flex;
align-items:center;
justify-content:center;
border-radius:6px;
}

.gruns-disclaimer{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
margin-top:40px;
}

.gruns-box{
border:1px solid rgba(255,255,255,.3);
padding:12px;
font-size:12px;
}

.gruns-bottom{
display:flex;
justify-content:space-between;
flex-wrap:wrap;
margin-top:20px;
font-size:13px;
}

.gruns-policy a{
color:#fff;
margin-right:15px;
text-decoration:none;
opacity:.8;
}

.gruns-policy a:hover{
opacity:1;
}

@media(max-width:900px){

.gruns-grid{
grid-template-columns:1fr;
}

.gruns-disclaimer{
grid-template-columns:1fr;
}

}

{% endstyle %}


<footer class="gruns-footer">

<div class="gruns-container">

<div class="gruns-grid">

<!-- Newsletter -->
<div class="gruns-newsletter">

<h2>{{ section.settings.heading }}</h2>

<div class="gruns-input">
<input type="text" placeholder="Phone number">
<button>→</button>
</div>

<a href="#">{{ section.settings.email_text }}</a>

<p style="margin-top:10px;font-size:12px;opacity:.8;">
{{ section.settings.description }}
</p>

</div>


<!-- Column 1 -->
<div class="gruns-links">

<h4>{{ section.settings.menu1_title }}</h4>

<ul>

{% for block in section.blocks %}
{% if block.type == 'menu1' %}
<li>
<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
</li>
{% endif %}
{% endfor %}

</ul>

</div>


<!-- Column 2 -->
<div class="gruns-links">

<h4>{{ section.settings.menu2_title }}</h4>

<ul>

{% for block in section.blocks %}
{% if block.type == 'menu2' %}
<li>
<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
</li>
{% endif %}
{% endfor %}

</ul>

</div>


<!-- Column 3 -->
<div>

{% if section.settings.logo != blank %}
<img src="{{ section.settings.logo | image_url: width:200 }}">
{% endif %}

<ul style="list-style:none;padding:0;margin-top:15px;">

{% for block in section.blocks %}
{% if block.type == 'menu3' %}
<li style="margin-bottom:8px;">
<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
</li>
{% endif %}
{% endfor %}

</ul>

<div class="gruns-social">

{% if settings.social_instagram_link != blank %}
<a href="{{ settings.social_instagram_link }}">IG</a>
{% endif %}

{% if settings.social_tiktok_link != blank %}
<a href="{{ settings.social_tiktok_link }}">TT</a>
{% endif %}

{% if settings.social_youtube_link != blank %}
<a href="{{ settings.social_youtube_link }}">YT</a>
{% endif %}

{% if settings.social_facebook_link != blank %}
<a href="{{ settings.social_facebook_link }}">FB</a>
{% endif %}

</div>

</div>

</div>


<!-- Disclaimer -->
<div class="gruns-disclaimer">

<div class="gruns-box">
{{ section.settings.disclaimer1 }}
</div>

<div class="gruns-box">
{{ section.settings.disclaimer2 }}
</div>

</div>


<!-- Bottom -->
<div class="gruns-bottom">

<div>
© {{ 'now' | date: "%Y" }} {{ shop.name }}
</div>

<div class="gruns-policy">

{% if shop.policies.refund_policy %}
<a href="{{ shop.policies.refund_policy.url }}">Refund Policy</a>
{% endif %}

{% if shop.policies.privacy_policy %}
<a href="{{ shop.policies.privacy_policy.url }}">Privacy Policy</a>
{% endif %}

{% if shop.policies.terms_of_service %}
<a href="{{ shop.policies.terms_of_service.url }}">Terms Of Service</a>
{% endif %}

{% if shop.policies.shipping_policy %}
<a href="{{ shop.policies.shipping_policy.url }}">Shipping Policy</a>
{% endif %}

</div>

</div>

</div>

</footer>


{% schema %}
{
"name":"Gruns Footer",
"settings":[
{
"type":"color",
"id":"bg_color",
"label":"Background Color",
"default":"#003c2b"
},
{
"type":"image_picker",
"id":"pattern",
"label":"Background Pattern"
},
{
"type":"range",
"id":"pattern_opacity",
"label":"Pattern Opacity",
"min":0,
"max":1,
"step":0.1,
"default":0.2
},
{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Sign Up for 52% Off"
},
{
"type":"text",
"id":"email_text",
"label":"Email Text",
"default":"Email me instead"
},
{
"type":"textarea",
"id":"description",
"label":"Description"
},
{
"type":"text",
"id":"menu1_title",
"default":"Learn",
"label":"Menu 1 Title"
},
{
"type":"text",
"id":"menu2_title",
"default":"Connect",
"label":"Menu 2 Title"
},
{
"type":"image_picker",
"id":"logo",
"label":"Footer Logo"
},
{
"type":"textarea",
"id":"disclaimer1",
"label":"Disclaimer Left"
},
{
"type":"textarea",
"id":"disclaimer2",
"label":"Disclaimer Right"
}
],

"blocks":[
{
"type":"menu1",
"name":"Learn Link",
"settings":[
{"type":"text","id":"text","label":"Text"},
{"type":"url","id":"link","label":"Link"}
]
},
{
"type":"menu2",
"name":"Connect Link",
"settings":[
{"type":"text","id":"text","label":"Text"},
{"type":"url","id":"link","label":"Link"}
]
},
{
"type":"menu3",
"name":"Product Link",
"settings":[
{"type":"text","id":"text","label":"Text"},
{"type":"url","id":"link","label":"Link"}
]
}
],

"presets":[
{
"name":"Gruns Footer"
}
]
}
{% endschema %}