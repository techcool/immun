{% style %}

.gruns-footer{
background:{{ section.settings.bg_color }};
color:#fff;
padding:80px 20px 40px;
position:relative;
overflow:hidden;
}

.gruns-footer:before{
content:"";
position:absolute;
top:0;
left:0;
width:100%;
height:100%;
{% if section.settings.pattern != blank %}
background:url({{ section.settings.pattern | image_url: width:2000 }});
{% endif %}
opacity:{{ section.settings.pattern_opacity }};
background-size:cover;
pointer-events:none;
}

.gruns-container{
max-width:1300px;
margin:auto;
position:relative;
}

.gruns-grid{
display:grid;
grid-template-columns:1.4fr 1fr 1fr 1fr;
gap:50px;
}

.gruns-newsletter h2{
color:#FFC629;
font-size:26px;
margin-bottom:20px;
}

.gruns-input{
display:flex;
}

.gruns-input input{
flex:1;
padding:15px;
border:none;
font-size:15px;
}

.gruns-input button{
width:60px;
background:#FFC629;
border:none;
font-size:18px;
cursor:pointer;
}

.gruns-links h4{
color:#FFC629;
margin-bottom:14px;
font-size:20px;
}

.gruns-links ul{
list-style:none;
padding:0;
}

.gruns-links li{
margin-bottom:8px;
}

.gruns-links a{
color:#fff;
text-decoration:none;
opacity:.85;
}

.gruns-links a:hover{
opacity:1;
}

.gruns-menu-image img{
max-width:120px;
margin-bottom:15px;
}

.gruns-social{
display:flex;
gap:10px;
margin-top:10px;
}

.gruns-social a{
width:36px;
height:36px;
background:#e6e6e6;
display:flex;
align-items:center;
justify-content:center;
border-radius:6px;
}

.gruns-social img{
width:18px;
height:18px;
}

.gruns-brand-row{
display:flex;
align-items:center;
gap:25px;
margin-top:40px;
}

.footer-logo{
max-width:200px;
}

.gruns-disclaimer{
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
margin-top:40px;
}

.gruns-box{
border:1px solid rgba(255,255,255,.3);
padding:12px;
font-size:12px;
}

.gruns-bottom{
display:flex;
justify-content:space-between;
flex-wrap:wrap;
margin-top:25px;
font-size:13px;
}

.gruns-policy{
display:flex;
flex-wrap:wrap;
gap:16px;
}

.gruns-policy a{
color:#fff;
text-decoration:none;
opacity:.85;
display:flex;
align-items:center;
gap:6px;
}

.gruns-policy img{
width:14px;
height:14px;
}

@media(max-width:900px){

.gruns-grid{
grid-template-columns:1fr;
}

.gruns-disclaimer{
grid-template-columns:1fr;
}

.gruns-brand-row{
flex-direction:column;
align-items:flex-start;
}

.gruns-bottom{
flex-direction:column;
gap:10px;
}

}

{% endstyle %}


<footer class="gruns-footer">

<div class="gruns-container">

<div class="gruns-grid">

<!-- Newsletter -->
<div class="gruns-newsletter">

<h2>{{ section.settings.heading }}</h2>

<div class="gruns-input">
<input type="email" placeholder="Email address">
<button>→</button>
</div>

<a href="#">{{ section.settings.email_text }}</a>

<p style="margin-top:10px;font-size:12px;opacity:.8;">
{{ section.settings.description }}
</p>

</div>


<!-- Menu 1 -->
<div class="gruns-links">

<h4>{{ section.settings.menu1_title }}</h4>

<ul>
{% for block in section.blocks %}
{% if block.type == 'menu1' %}
<li>
<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
</li>
{% endif %}
{% endfor %}
</ul>

</div>


<!-- Menu 2 -->
<div class="gruns-links">

<h4>{{ section.settings.menu2_title }}</h4>

<ul>
{% for block in section.blocks %}
{% if block.type == 'menu2' %}
<li>
<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
</li>
{% endif %}
{% endfor %}
</ul>

</div>


<!-- Menu 3 with Image -->
<div>

{% if section.settings.menu3_image != blank %}
<div class="gruns-menu-image">
<img src="{{ section.settings.menu3_image | image_url: width:200 }}">
</div>
{% endif %}

<ul style="list-style:none;padding:0;">
{% for block in section.blocks %}
{% if block.type == 'menu3' %}
<li style="margin-bottom:8px;">
<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
</li>
{% endif %}
{% endfor %}
</ul>

</div>

</div>


<!-- Logo + Social -->
<div class="gruns-brand-row">

{% if section.settings.logo != blank %}
<img src="{{ section.settings.logo | image_url: width:300 }}" class="footer-logo">
{% endif %}

<div class="gruns-social">

{% for block in section.blocks %}
{% if block.type == 'social' %}
<a href="{{ block.settings.link }}">
{% if block.settings.icon != blank %}
<img src="{{ block.settings.icon | image_url: width:40 }}">
{% endif %}
</a>
{% endif %}
{% endfor %}

</div>

</div>


<!-- Disclaimer -->
<div class="gruns-disclaimer">

<div class="gruns-box">
{{ section.settings.disclaimer1 }}
</div>

<div class="gruns-box">
{{ section.settings.disclaimer2 }}
</div>

</div>


<!-- Bottom -->
<div class="gruns-bottom">

<div>
© {{ 'now' | date: "%Y" }} {{ shop.name }}
</div>

<div class="gruns-policy">

{% for block in section.blocks %}
{% if block.type == 'policy' %}

<a href="{{ block.settings.link }}">

{% if block.settings.icon != blank %}
<img src="{{ block.settings.icon | image_url: width:40 }}">
{% endif %}

{{ block.settings.text }}

</a>

{% endif %}
{% endfor %}

</div>

</div>

</div>

</footer>


{% schema %}
{
"name":"Gruns Footer",
"settings":[
{
"type":"color",
"id":"bg_color",
"default":"#003c2b",
"label":"Background Color"
},
{
"type":"image_picker",
"id":"pattern",
"label":"Background Pattern"
},
{
"type":"range",
"id":"pattern_opacity",
"min":0,
"max":1,
"step":0.1,
"default":0.2,
"label":"Pattern Opacity"
},
{
"type":"text",
"id":"heading",
"default":"Sign Up for 52% Off",
"label":"Heading"
},
{
"type":"text",
"id":"email_text",
"default":"Text me instead",
"label":"Sub Link Text"
},
{
"type":"textarea",
"id":"description",
"label":"Description"
},
{
"type":"text",
"id":"menu1_title",
"default":"Learn",
"label":"Menu 1 Title"
},
{
"type":"text",
"id":"menu2_title",
"default":"Connect",
"label":"Menu 2 Title"
},
{
"type":"image_picker",
"id":"menu3_image",
"label":"Menu 3 Top Image"
},
{
"type":"image_picker",
"id":"logo",
"label":"Footer Logo"
},
{
"type":"textarea",
"id":"disclaimer1",
"label":"Disclaimer Left"
},
{
"type":"textarea",
"id":"disclaimer2",
"label":"Disclaimer Right"
}
],

"blocks":[
{
"type":"menu1",
"name":"Menu 1 Link",
"settings":[
{"type":"text","id":"text","label":"Text"},
{"type":"url","id":"link","label":"Link"}
]
},
{
"type":"menu2",
"name":"Menu 2 Link",
"settings":[
{"type":"text","id":"text","label":"Text"},
{"type":"url","id":"link","label":"Link"}
]
},
{
"type":"menu3",
"name":"Menu 3 Link",
"settings":[
{"type":"text","id":"text","label":"Text"},
{"type":"url","id":"link","label":"Link"}
]
},
{
"type":"social",
"name":"Social Icon",
"settings":[
{
"type":"image_picker",
"id":"icon",
"label":"Social Icon"
},
{
"type":"url",
"id":"link",
"label":"Link"
}
]
},
{
"type":"policy",
"name":"Policy Link",
"settings":[
{
"type":"image_picker",
"id":"icon",
"label":"Policy Icon"
},
{
"type":"text",
"id":"text",
"label":"Text"
},
{
"type":"url",
"id":"link",
"label":"Link"
}
]
}
],

"presets":[
{
"name":"Gruns Footer"
}
]
}
{% endschema %}