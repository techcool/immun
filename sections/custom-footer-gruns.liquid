
{% style %}


.gruns-footer{
  background: {{ section.settings.bg_color }};
  color:#fff;
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  position:relative;
  overflow:hidden;
}

.gruns-footer:before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;

  {% if section.settings.pattern != blank %}
    background: url({{ section.settings.pattern | image_url: width:2000 }});
  {% endif %}

  opacity: {{ section.settings.pattern_opacity }};
  background-size: cover;
  pointer-events: none;
}

.gruns-container {
  max-width: 1300px;
  margin: auto;
  position: relative;
}

.gruns-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 50px;
}

/* newsletter */

.gruns-newsletter h2 {
  color: #FFC629;
  font-size: 26px;
  margin-bottom: 20px;
}

.gruns-input {
  display: flex;
}

.gruns-input input {
  flex: 1;
  padding: 15px;
  border: none;
  font-size: 15px;
}

.gruns-input button {
  width: 60px;
  background: #FFC629;
  border: none;
  font-size: 18px;
  cursor: pointer;
}

.gruns-note {
  margin-top: 10px;
  font-size: 12px;
  opacity: .8;
  line-height: 1.6;
}

.gruns-success {
  margin-top: 10px;
  color: #9fff9f;
  font-size: 14px;
}

.gruns-error {
  margin-top: 10px;
  color: #ffb3b3;
  font-size: 14px;
}

.gruns-toggle-sms,
.gruns-toggle-email {
  display: inline-block;
  margin-top: 10px;
  text-decoration: underline;
  cursor: pointer;
}

.gruns-sms-mode {
  display: none;
}

.gruns-newsletter.sms-active .gruns-email-mode {
  display: none;
}

.gruns-newsletter.sms-active .gruns-sms-mode {
  display: block;
}

/* links */

.gruns-links h4 {
  color: #FFC629;
  margin-bottom: 14px;
  font-size: 20px;
}

.gruns-links ul {
  list-style: none;
  padding: 0;
}

.gruns-links li {
  margin-bottom: 8px;
}

.gruns-links a {
  color: #fff;
  text-decoration: none;
  opacity: .85;
}

.gruns-links a:hover {
  opacity: 1;
}

.gruns-menu-image img {
  max-width: 120px;
  margin-bottom: 15px;
}

/* social */

.gruns-social {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.gruns-social a {
  width: 36px;
  height: 36px;
  background: #e6e6e6;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
}

.gruns-social img {
  width: 18px;
  height: 18px;
}

/* brand */

.gruns-brand-row {
  display: flex;
  align-items: center;
  gap: 25px;
  margin-top: 40px;
}

.footer-logo {
  max-width: 200px;
}

/* disclaimer */

.gruns-disclaimer {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 40px;
}

.gruns-box {
  border: 1px solid rgba(255,255,255,.3);
  padding: 12px;
  font-size: 12px;
}

/* bottom */

.gruns-bottom {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-top: 25px;
  font-size: 13px;
}

.gruns-policy {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}

.gruns-policy a {
  color: #fff;
  text-decoration: none;
  opacity: .85;
  display: flex;
  align-items: center;
  gap: 6px;
}

.gruns-policy img {
  width: 14px;
  height: 14px;
}

@media (max-width: 900px) {

  .gruns-grid {
    grid-template-columns: 1fr;
  }

  .gruns-disclaimer {
    grid-template-columns: 1fr;
  }

  .gruns-brand-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .gruns-bottom {
    flex-direction: column;
    gap: 10px;
  }

}

{% endstyle %}


<footer class="gruns-footer">
  <div class="gruns-container">
    <div class="gruns-grid">

      <!-- Newsletter -->
      <div class="gruns-newsletter {{ section.settings.newsletter_class }}">
        <h2>{{ section.settings.heading }}</h2>

        <div class="gruns-email-mode">
          {% form 'customer', id: 'ContactFooter', class: 'newsletter-form' %}

            <input type="hidden" name="contact[tags]" value="newsletter">

            <div class="gruns-input">
            <input
                type="email"
                name="contact[email]"
                placeholder="Email address"
                required
            >

            <button type="submit">→</button>
            </div>

            {% if form.posted_successfully? %}
            <p class="gruns-success">Thank you for subscribing!</p>
            {% endif %}

            {% if form.errors %}
            <p class="gruns-error">
                {{ form.errors | default_errors }}
            </p>
            {% endif %}

            {% endform %}

          <a href="#" class="gruns-toggle-sms">Text me instead</a>

          <p class="gruns-note">
            {{ section.settings.email_description }}
          </p>
        </div>


        <div class="gruns-sms-mode">
          {% form 'contact', id: 'PhoneNewsletter' %}

            <input type="hidden" name="contact[email]" value="phone@lead.com">
            <input type="hidden" name="contact[body]" value="Phone newsletter signup">
            <input type="hidden" name="contact[tags]" value="phone-newsletter">

            <div class="gruns-input">
            <input 
                type="tel" 
                name="contact[phone]" 
                placeholder="Enter your phone number"
                required
            >
            <button type="submit">→</button>
            </div>

            {% if form.posted_successfully? %}
            <p class="gruns-success">Thank you! We will contact you soon.</p>
            {% endif %}

            {% if form.errors %}
            <p class="gruns-error">{{ form.errors | default_errors }}</p>
            {% endif %}

            {% endform %}

          <a href="#" class="gruns-toggle-email">Email me instead</a>

          <p class="gruns-note">
            {{ section.settings.sms_description }}
          </p>
        </div>
      </div>


      <!-- Menu 1 -->
      <div class="gruns-links">
        <h4>{{ section.settings.menu1_title }}</h4>

        <ul>
          {% for block in section.blocks %}
            {% if block.type == 'menu1' %}
              <li>
                <a href="{{ block.settings.link }}">
                  {{ block.settings.text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>


      <!-- Menu 2 -->
      <div class="gruns-links">
        <h4>{{ section.settings.menu2_title }}</h4>

        <ul>
          {% for block in section.blocks %}
            {% if block.type == 'menu2' %}
              <li>
                <a href="{{ block.settings.link }}">
                  {{ block.settings.text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>


      <!-- Menu 3 -->
      <div>
        {% if section.settings.menu3_image != blank %}
          <div class="gruns-menu-image">
            <img src="{{ section.settings.menu3_image | image_url: width:200 }}">
          </div>
        {% endif %}

        <ul style="list-style:none;padding:0;">
          {% for block in section.blocks %}
            {% if block.type == 'menu3' %}
              <li>
                <a href="{{ block.settings.link }}">
                  {{ block.settings.text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

    </div>


    <!-- logo + social -->
    <div class="gruns-brand-row">

      {% if section.settings.logo != blank %}
        <img
          src="{{ section.settings.logo | image_url: width:300 }}"
          class="footer-logo"
        >
      {% endif %}

      <div class="gruns-social">
        {% for block in section.blocks %}
          {% if block.type == 'social' %}
            <a href="{{ block.settings.link }}">
              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | image_url: width:40 }}">
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </div>

    </div>


    <!-- disclaimer -->
    <div class="gruns-disclaimer">
      <div class="gruns-box">
        {{ section.settings.disclaimer1 }}
      </div>

      <div class="gruns-box">
        {{ section.settings.disclaimer2 }}
      </div>
    </div>


    <!-- bottom -->
    <div class="gruns-bottom">

      <div>
        © {{ 'now' | date: "%Y" }} {{ shop.name }}
      </div>

      <div class="gruns-policy">
        {% for block in section.blocks %}
          {% if block.type == 'policy' %}
            <a href="{{ block.settings.link }}">

              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | image_url: width:40 }}">
              {% endif %}

              {{ block.settings.text }}
            </a>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
  <div class="gruns-container {{ section.settings.bottom_class }}">
    {% if section.settings.bottom_image1 != blank %}
        <img 
        src="{{ section.settings.bottom_image1 | image_url: width:1200 }}"
        class="{{ section.settings.bottom_image1_class }}"
        alt=""
        >
    {% endif %}

    {% if section.settings.bottom_image2 != blank %}
        <img 
        src="{{ section.settings.bottom_image2 | image_url: width:1200 }}"
        class="{{ section.settings.bottom_image2_class }}"
        alt=""
        >
    {% endif %}

    </div>
</footer>


<script>
document.addEventListener("DOMContentLoaded", function () {

  document.querySelectorAll(".gruns-newsletter").forEach(function(newsletter) {

    const smsBtn = newsletter.querySelector(".gruns-toggle-sms");
    const emailBtn = newsletter.querySelector(".gruns-toggle-email");

    if (smsBtn) {
      smsBtn.addEventListener("click", function(e) {
        e.preventDefault();
        newsletter.classList.add("sms-active");
      });
    }

    if (emailBtn) {
      emailBtn.addEventListener("click", function(e) {
        e.preventDefault();
        newsletter.classList.remove("sms-active");
      });
    }

  });

});
</script>


{% schema %}
{
  "name": "Gruns Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#003c2b"
    },
    {
      "type": "image_picker",
      "id": "pattern",
      "label": "Background Pattern"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "label": "Pattern Opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.2
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sign Up for 52% Off"
    },
    {
      "type": "text",
      "id": "newsletter_class",
      "label": "Custom Newsletter Class"
    },

    {
      "type": "textarea",
      "id": "email_description",
      "label": "Email Description"
    },
    {
      "type": "textarea",
      "id": "sms_description",
      "label": "SMS Description"
    },

    {
      "type": "text",
      "id": "menu1_title",
      "label": "Menu 1 Title",
      "default": "Learn"
    },
    {
      "type": "text",
      "id": "menu2_title",
      "label": "Menu 2 Title",
      "default": "Connect"
    },

    {
      "type": "image_picker",
      "id": "menu3_image",
      "label": "Menu 3 Top Image"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },

    {
      "type": "textarea",
      "id": "disclaimer1",
      "label": "Disclaimer Left"
    },
    {
      "type": "textarea",
      "id": "disclaimer2",
      "label": "Disclaimer Right"
    },
    {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Section Class"
    },

    {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 200,
        "step": 10,
        "default": 80,
        "unit": "px"
    },

    {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "min": 0,
        "max": 200,
        "step": 10,
        "default": 80,
        "unit": "px"
    },

    {
        "type": "text",
        "id": "bottom_class",
        "label": "Bottom Container Class"
    },

    {
        "type": "image_picker",
        "id": "bottom_image1",
        "label": "Bottom Image 1"
    },

    {
    "type": "text",
    "id": "bottom_image1_class",
    "label": "Bottom Image 1 Class"
    },

    {
    "type": "image_picker",
    "id": "bottom_image2",
    "label": "Bottom Image 2"
    },

    {
    "type": "text",
    "id": "bottom_image2_class",
    "label": "Bottom Image 2 Class"
    }
  ],

  "blocks": [
    {
      "type": "menu1",
      "name": "Menu 1 Link",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },

    {
      "type": "menu2",
      "name": "Menu 2 Link",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },

    {
      "type": "menu3",
      "name": "Menu 3 Link",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },

    {
      "type": "social",
      "name": "Social Icon",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Social Icon" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },

    {
      "type": "policy",
      "name": "Policy Link",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Policy Icon" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],

  "presets": [
    {
      "name": "Gruns Footer"
    }
  ]
}
{% endschema %}

