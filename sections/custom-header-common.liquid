<header class="custom-header">
  <div class="custom-header-wrapper">

    <!-- LEFT MENU ITEMS -->
    <nav class="custom-menu">
      {% for block in section.blocks %}
        {% if block.type == 'menu_item' %}
          <a href="{{ block.settings.menu_link }}" class="menu-link">
            {{ block.settings.menu_text }}
          </a>
        {% endif %}
      {% endfor %}
    </nav>

    <!-- CENTER LOGO -->
    <div class="custom-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.custom_logo != blank %}
          <img 
            src="{{ section.settings.custom_logo | image_url: width: 250 }}" 
            alt="{{ shop.name }}">
        {% else %}
          <span class="logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- RIGHT SIDE -->
    <div class="custom-icons">
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}">
        Cart <span class="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</header>

<style>
.custom-header {
  background: #0c7c3a;
  padding: 15px 40px;
}

.custom-header-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.custom-menu {
  display: flex;
  gap: 20px;
}

.menu-link {
  color: #fff;
  text-decoration: none;
  font-weight: 500;
}

.menu-link:hover {
  opacity: 0.8;
}

.custom-logo img {
  max-height: 45px;
}

.logo-text {
  color: #fff;
  font-size: 22px;
  font-weight: bold;
}

.custom-icons {
  display: flex;
  gap: 20px;
}

.custom-icons a {
  color: #fff;
  text-decoration: none;
  font-weight: 500;
}

.cart-count {
  background: #fff;
  color: #000;
  padding: 3px 7px;
  border-radius: 20px;
  font-size: 12px;
}

/* Responsive */
@media (max-width: 768px) {
  .custom-header-wrapper {
    flex-direction: column;
    gap: 15px;
  }

  .custom-menu {
    flex-wrap: wrap;
    justify-content: center;
  }
}
</style>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "custom_logo",
      "label": "Upload Logo"
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        {
          "type": "text",
          "id": "menu_text",
          "label": "Menu Text",
          "default": "Menu"
        },
        {
          "type": "url",
          "id": "menu_link",
          "label": "Menu Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}