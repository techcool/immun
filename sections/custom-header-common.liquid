<header class="custom-header-img color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}">
  <div class="custom-header-img__wrapper">

    <!-- LEFT: Logo -->
    <div class="custom-header-img__image">
      {% if section.settings.custom_image != blank %}
        <a href="{{ section.settings.image_link | default: routes.root_url }}">
          <img 
            src="{{ section.settings.custom_image | image_url: width: 400 }}"
            alt="{{ section.settings.custom_image.alt | escape }}"
            loading="lazy"
          >
        </a>
      {% endif %}
    </div>

    <!-- CENTER: Navigation -->
    <nav class="custom-header-img__menu">
      <ul>
        {% for block in section.blocks %}
          {% if block.type == 'nav_link' %}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link_url }}">
                {{ block.settings.link_text }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <!-- RIGHT -->
    <div class="custom-header-img__right">

      {% if section.settings.show_search %}
        <a href="{{ routes.search_url }}" class="header-icon" aria-label="Search">
          🔍
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header-icon cart-icon" aria-label="Cart">
        🛒
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="header-btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>
    <div class="hamburger" id="hamburgerBtn" aria-label="Open menu" role="button">
      <span></span>
      <span></span>
      <span></span>
    </div>

  </div>
</header>

<style>
.custom-header-img {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  padding-left: 40px;
  padding-right: 40px;
}

/* Hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  cursor: pointer;
  gap: 5px;
  z-index: 1001;
}

.hamburger span {
  width: 25px;
  height: 3px;
  background: currentColor;
  display: block;
  transition: 0.3s;
}

/* Mobile padding */
@media (max-width: 768px) {
  .custom-header-img {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
}

.custom-header-img__wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.custom-header-img__image img {
  max-height: 34px;
  display: block;
}

/* Menu */
.custom-header-img__menu ul {
  list-style: none;
  display: flex;
  gap: 35px;
  margin: 0;
  padding: 0;
}


/* Right section */
.custom-header-img__right {
  display: flex;
  align-items: center;
  gap: 18px;
}

.header-icon {
  text-decoration: none;
  font-size: 18px;
  position: relative;
  color: inherit;
}

.cart-count {
  position: absolute;
  top: -8px;
  right: -10px;
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 20px;
  background: currentColor;
  color: #fff;
}



/* Hide menu on tablet */
@media (max-width: 991px) {
  .custom-header-img__menu {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Custom Header Image",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Upload Header Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Link"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Right Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Right Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Header Image"
    }
  ]
}
{% endschema %}