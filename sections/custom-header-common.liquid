<header class="custom-header-img">
  <div class="custom-header-img__wrapper">

    <!-- LEFT: Custom Image Only -->
    <div class="custom-header-img__image">
      {% if section.settings.custom_image != blank %}
        <a href="{{ section.settings.image_link }}">
          <img 
            src="{{ section.settings.custom_image | image_url: width: 400 }}" 
            alt="Header Image">
        </a>
      {% endif %}
    </div>

    <!-- CENTER: Custom Text Links -->
    <nav class="custom-header-img__menu">
      <ul>
        {% if section.settings.link_text_1 != blank %}
          <li>
            <a href="{{ section.settings.link_url_1 }}">
              {{ section.settings.link_text_1 }}
            </a>
          </li>
        {% endif %}

        {% if section.settings.link_text_2 != blank %}
          <li>
            <a href="{{ section.settings.link_url_2 }}">
              {{ section.settings.link_text_2 }}
            </a>
          </li>
        {% endif %}

        {% if section.settings.link_text_3 != blank %}
          <li>
            <a href="{{ section.settings.link_url_3 }}">
              {{ section.settings.link_text_3 }}
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>

    <!-- RIGHT: Optional Button -->
    <div class="custom-header-img__icons">
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="header-btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

  </div>
</header>

<style>
.custom-header-img {
  background: #111;
  padding: 18px 40px;
}

.custom-header-img__wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Image */
.custom-header-img__image img {
  max-height: 60px;
  display: block;
}

/* Menu */
.custom-header-img__menu ul {
  list-style: none;
  display: flex;
  gap: 35px;
  margin: 0;
  padding: 0;
}

.custom-header-img__menu a {
  text-decoration: none;
  color: #fff;
  font-weight: 500;
  font-size: 15px;
  transition: 0.3s;
}

.custom-header-img__menu a:hover {
  color: #0c7c3a;
}

/* Button */
.header-btn {
  background: #0c7c3a;
  padding: 8px 18px;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  font-size: 14px;
  transition: 0.3s;
}

.header-btn:hover {
  background: #095c2b;
}

/* Responsive */
@media (max-width: 991px) {
  .custom-header-img__menu {
    display: none;
  }
}

@media (max-width: 768px) {
  .custom-header-img__wrapper {
    flex-direction: column;
    gap: 15px;
  }
}
</style>

{% schema %}
{
  "name": "Custom Header Image Only",
  "settings": [
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Upload Header Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Link"
    },

    {
      "type": "text",
      "id": "link_text_1",
      "label": "Menu Text 1"
    },
    {
      "type": "url",
      "id": "link_url_1",
      "label": "Menu Link 1"
    },

    {
      "type": "text",
      "id": "link_text_2",
      "label": "Menu Text 2"
    },
    {
      "type": "url",
      "id": "link_url_2",
      "label": "Menu Link 2"
    },

    {
      "type": "text",
      "id": "link_text_3",
      "label": "Menu Text 3"
    },
    {
      "type": "url",
      "id": "link_url_3",
      "label": "Menu Link 3"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Right Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Right Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Header Image Only"
    }
  ]
}
{% endschema %}