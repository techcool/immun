<header class="custom-header-img">
  <div class="custom-header-img__wrapper">

    <!-- LEFT: Logo / Image -->
    <div class="custom-header-img__image">
      {% if section.settings.custom_image != blank %}
        <a href="{{ section.settings.image_link | default: routes.root_url }}">
          <img 
            src="{{ section.settings.custom_image | image_url: width: 400 }}"
            alt="{{ section.settings.custom_image.alt | escape }}"
            loading="lazy"
          >
        </a>
      {% endif %}
    </div>

    <!-- CENTER: Dynamic Navigation -->
    <nav class="custom-header-img__menu">
      <ul>
        {% for block in section.blocks %}
          {% if block.type == 'nav_link' %}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link_url }}">
                {{ block.settings.link_text }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <!-- RIGHT: Icons + Optional Button -->
    <div class="custom-header-img__right">

      {% if section.settings.show_search %}
        <a href="{{ routes.search_url }}" class="header-icon" aria-label="Search">
          🔍
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header-icon cart-icon" aria-label="Cart">
        🛒
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="header-btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>

  </div>
</header>

<style>
.custom-header-img {
  background: #111;
  padding: 18px 40px;
}

.custom-header-img__wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

/* Image */
.custom-header-img__image img {
  max-height: 60px;
  display: block;
}

/* Menu */
.custom-header-img__menu ul {
  list-style: none;
  display: flex;
  gap: 35px;
  margin: 0;
  padding: 0;
}

.custom-header-img__menu a {
  text-decoration: none;
  color: #fff;
  font-weight: 500;
  font-size: 15px;
  transition: 0.3s ease;
}

.custom-header-img__menu a:hover {
  color: #0c7c3a;
}

/* Right Section */
.custom-header-img__right {
  display: flex;
  align-items: center;
  gap: 18px;
}

/* Icons */
.header-icon {
  color: #fff;
  text-decoration: none;
  font-size: 18px;
  position: relative;
}

/* Cart Count */
.cart-count {
  position: absolute;
  top: -8px;
  right: -10px;
  background: #0c7c3a;
  color: #fff;
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 20px;
}

/* Button */
.header-btn {
  background: #0c7c3a;
  padding: 8px 18px;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  font-size: 14px;
  transition: 0.3s ease;
}

.header-btn:hover {
  background: #095c2b;
}

/* Responsive */
@media (max-width: 991px) {
  .custom-header-img__menu {
    display: none;
  }
}

@media (max-width: 768px) {
  .custom-header-img__wrapper {
    flex-direction: column;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "Custom Header Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Upload Header Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Link"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Right Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Right Button Link"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation Link",
      "settings": [
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Header Image"
    }
  ]
}
{% endschema %}