<header class="custom-header-img">
  <div class="custom-header-img__wrapper">

    <!-- LEFT: Custom Image -->
    <div class="custom-header-img__image">
      {% if section.settings.custom_image != blank %}
        <a href="{{ section.settings.image_link }}">
          <img 
            src="{{ section.settings.custom_image | image_url: width: 300 }}" 
            alt="{{ section.settings.custom_image.alt | escape }}">
        </a>
      {% else %}
        <a href="{{ routes.root_url }}">
          <h2 style="color:#fff;margin:0;">{{ shop.name }}</h2>
        </a>
      {% endif %}
    </div>

    <!-- CENTER: Dynamic Menu -->
    <nav class="custom-header-img__menu">
      {% if section.settings.menu != blank %}
        <ul>
          {% for link in linklists[section.settings.menu].links %}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>

              {% if link.links != blank %}
                <div class="submenu-img">
                  {% for childlink in link.links %}
                    <a href="{{ childlink.url }}">
                      {{ childlink.title }}
                    </a>
                  {% endfor %}
                </div>
              {% endif %}

            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <!-- RIGHT: Account + Cart -->
    <div class="custom-header-img__icons">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}">
          {% if customer %}Account{% else %}Login{% endif %}
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}">
        Cart ({{ cart.item_count }})
      </a>
    </div>

  </div>
</header>

<style>
.custom-header-img {
  background: #111;
  padding: 18px 40px;
  position: relative;
  z-index: 20;
}

.custom-header-img__wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Image */
.custom-header-img__image img {
  max-height: 55px;
  display: block;
}

/* Menu */
.custom-header-img__menu ul {
  list-style: none;
  display: flex;
  gap: 30px;
  margin: 0;
  padding: 0;
}

.custom-header-img__menu li {
  position: relative;
}

.custom-header-img__menu a {
  text-decoration: none;
  color: #fff;
  font-weight: 500;
  font-size: 15px;
  transition: 0.3s;
}

.custom-header-img__menu a:hover {
  color: #0c7c3a;
}

/* Dropdown */
.submenu-img {
  position: absolute;
  top: 100%;
  left: 0;
  background: #222;
  padding: 15px;
  display: none;
  flex-direction: column;
  gap: 10px;
  min-width: 180px;
}

.custom-header-img__menu li:hover .submenu-img {
  display: flex;
}

.submenu-img a {
  font-size: 14px;
}

/* Icons */
.custom-header-img__icons {
  display: flex;
  gap: 20px;
}

.custom-header-img__icons a {
  color: #fff;
  text-decoration: none;
  font-size: 14px;
}

/* Responsive */
@media (max-width: 991px) {
  .custom-header-img__menu {
    display: none;
  }
}

@media (max-width: 768px) {
  .custom-header-img {
    padding: 15px 20px;
  }

  .custom-header-img__wrapper {
    flex-direction: column;
    gap: 15px;
  }
}
</style>

{% schema %}
{
  "name": "Custom Header With Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Upload Header Image"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image Link"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Select Menu"
    }
  ],
  "presets": [
    {
      "name": "Custom Header With Image"
    }
  ]
}
{% endschema %}