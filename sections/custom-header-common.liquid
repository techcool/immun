{% schema %}
{
  "name": "Custom Top Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0c7c3a"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "url",
      "id": "adults_link",
      "label": "Shop Adults Link"
    },
    {
      "type": "url",
      "id": "kids_link",
      "label": "Shop Kids Link"
    },
    {
      "type": "text",
      "id": "adults_text",
      "label": "Shop Adults Text",
      "default": "Shop Adults"
    },
    {
      "type": "text",
      "id": "kids_text",
      "label": "Shop Kids Text",
      "default": "Shop Kids"
    }
  ],
  "presets": [
    {
      "name": "Custom Top Header"
    }
  ]
}
{% endschema %}

<header class="custom-top-header" style="background: {{ section.settings.bg_color }};">
  <div class="header-wrapper">

    <!-- Left Buttons -->
    <div class="header-left">
      <a href="{{ section.settings.adults_link }}" class="header-btn">
        {{ section.settings.adults_text }}
      </a>
      <a href="{{ section.settings.kids_link }}" class="header-btn">
        {{ section.settings.kids_text }}
      </a>
    </div>

    <!-- Center Logo -->
    <div class="header-center">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="Logo">
      {% else %}
        <h2>{{ shop.name }}</h2>
      {% endif %}
    </div>

    <!-- Right Account + Cart -->
    <div class="header-right">
      <a href="{{ routes.account_url }}" class="account-link">
        Account
      </a>
      <a href="{{ routes.cart_url }}" class="cart-link">
        🛒
      </a>
    </div>

  </div>
</header>

<style>
.custom-top-header {
  padding: 15px 40px;
}

.header-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-left,
.header-right {
  display: flex;
  align-items: center;
  gap: 15px;
}

.header-btn {
  border: 2px solid #fff;
  color: #fff;
  padding: 8px 18px;
  border-radius: 30px;
  text-decoration: none;
  font-size: 14px;
  transition: 0.3s ease;
}

.header-btn:hover {
  background: #fff;
  color: #000;
}

.header-center img {
  max-height: 40px;
}

.account-link {
  color: #fff;
  text-decoration: none;
  font-size: 14px;
}

.cart-link {
  font-size: 18px;
  text-decoration: none;
  color: #fff;
}
</style>