<header class="custom-header">
  <div class="custom-header-wrapper">

    <!-- LEFT: Navigation Menu -->
    <nav class="custom-menu">
      {% if section.settings.custom_menu != blank %}
        {% for link in linklists[section.settings.custom_menu].links %}
          <a href="{{ link.url }}" class="menu-link">
            {{ link.title }}
          </a>
        {% endfor %}
      {% endif %}
    </nav>

    <!-- CENTER: Logo -->
    <div class="custom-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.custom_logo != blank %}
          <img 
            src="{{ section.settings.custom_logo | image_url: width: 250 }}" 
            alt="{{ shop.name }}" 
          >
        {% else %}
          <span class="logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- RIGHT: Account + Cart -->
    <div class="custom-icons">
      <a href="{{ routes.account_url }}" class="account-link">
        Account
      </a>

      <a href="{{ routes.cart_url }}" class="cart-link">
        Cart
        <span class="cart-count">
          {{ cart.item_count }}
        </span>
      </a>
    </div>

  </div>
</header>

<style>
.custom-header {
  width: 100%;
  background: #0c7c3a;
  padding: 15px 40px;
}

.custom-header-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.custom-menu {
  display: flex;
  gap: 25px;
}

.menu-link {
  color: #ffffff;
  text-decoration: none;
  font-weight: 500;
  position: relative;
}

.menu-link:hover {
  opacity: 0.8;
}

.custom-logo img {
  max-height: 45px;
}

.logo-text {
  color: #ffffff;
  font-size: 22px;
  font-weight: bold;
}

.custom-icons {
  display: flex;
  align-items: center;
  gap: 20px;
}

.account-link,
.cart-link {
  color: #ffffff;
  text-decoration: none;
  font-weight: 500;
}

.cart-count {
  background: #ffffff;
  color: #000;
  font-size: 12px;
  padding: 3px 7px;
  border-radius: 20px;
  margin-left: 5px;
}

/* Responsive */
@media (max-width: 768px) {
  .custom-header-wrapper {
    flex-direction: column;
    gap: 15px;
  }

  .custom-menu {
    flex-wrap: wrap;
    justify-content: center;
  }
}
</style>

{% schema %}
{
  "name": "Custom Global Header",
  "settings": [
    {
      "type": "link_list",
      "id": "custom_menu",
      "label": "Select Menu"
    },
    {
      "type": "image_picker",
      "id": "custom_logo",
      "label": "Upload Logo"
    }
  ]
}
{% endschema %}