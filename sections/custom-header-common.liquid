<header class="custom-header">
  <div class="custom-header-wrapper">

    <!-- LEFT MENU -->
    <nav class="custom-menu">
      {% assign selected_menu = section.settings.custom_menu %}
      {% if selected_menu != blank %}
        {% for link in linklists[selected_menu].links %}
          <a href="{{ link.url }}" class="menu-link">
            {{ link.title }}
          </a>
        {% endfor %}
      {% endif %}
    </nav>

    <!-- CENTER LOGO -->
    <div class="custom-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.custom_logo != blank %}
          <img 
            src="{{ section.settings.custom_logo | image_url: width: 250 }}" 
            alt="{{ shop.name }}">
        {% else %}
          <span class="logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <!-- RIGHT -->
    <div class="custom-icons">
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}">
        Cart <span class="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</header>

<style>
.custom-header {
  background: #0c7c3a;
  padding: 15px 40px;
}

.custom-header-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.custom-menu {
  display: flex;
  gap: 25px;
}

.menu-link {
  color: #fff;
  text-decoration: none;
  font-weight: 500;
}

.custom-logo img {
  max-height: 45px;
}

.logo-text {
  color: #fff;
  font-size: 22px;
  font-weight: bold;
}

.custom-icons {
  display: flex;
  gap: 20px;
}

.cart-count {
  background: #fff;
  color: #000;
  padding: 3px 7px;
  border-radius: 20px;
  font-size: 12px;
}
</style>

{% schema %}
{
  "name": "Dynamic Global Header",
  "settings": [
    {
      "type": "link_list",
      "id": "custom_menu",
      "label": "Select Menu (Per Page)"
    },
    {
      "type": "image_picker",
      "id": "custom_logo",
      "label": "Select Logo (Per Page)"
    }
  ]
}
{% endschema %}