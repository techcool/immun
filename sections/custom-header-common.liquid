<header class="manual-header">
  <div class="manual-header__wrapper">

    <!-- LEFT: Anchor Links -->
    <div class="manual-header__anchors">
      {% for block in section.blocks %}
        {% if block.type == 'anchor' %}
          <a href="{{ block.settings.link }}" class="manual-anchor">
            {{ block.settings.text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <!-- CENTER: Logo -->
    <div class="manual-header__logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img 
            src="{{ section.settings.logo | image_url: width: 200 }}" 
            alt="{{ shop.name }}">
        {% else %}
          {{ shop.name }}
        {% endif %}
      </a>
    </div>

    <!-- RIGHT: Account + Cart -->
    <div class="manual-header__icons">
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}">
        Cart ({{ cart.item_count }})
      </a>
    </div>

  </div>
</header>

<style>
.manual-header {
  background: #0c7c3a;
  padding: 15px 40px;
}

.manual-header__wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.manual-header__anchors {
  display: flex;
  gap: 15px;
}

/* Anchor Style (Button Look) */
.manual-anchor {
  border: 2px solid #fff;
  color: #fff;
  padding: 8px 18px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 500;
  transition: 0.3s ease;
}

.manual-anchor:hover {
  background: #fff;
  color: #000;
}

.manual-header__logo img {
  max-height: 45px;
}

.manual-header__icons {
  display: flex;
  gap: 20px;
}

.manual-header__icons a {
  color: #fff;
  text-decoration: none;
}

/* Mobile */
@media (max-width: 768px) {
  .manual-header__wrapper {
    flex-direction: column;
    gap: 15px;
  }

  .manual-header__anchors {
    flex-wrap: wrap;
    justify-content: center;
  }
}
</style>

{% schema %}
{
  "name": "Anchor Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ],
  "blocks": [
    {
      "type": "anchor",
      "name": "Anchor Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Anchor Text",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Anchor Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Anchor Header"
    }
  ]
}
{% endschema %}