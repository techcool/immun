<header class="custom-header">
  <div class="custom-header__wrapper">

    <!-- LEFT: Logo -->
    <div class="custom-header__logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img 
            src="{{ section.settings.logo | image_url: width: 250 }}" 
            alt="{{ shop.name }}">
        {% else %}
          {{ shop.name }}
        {% endif %}
      </a>
    </div>

    <!-- CENTER: Menu -->
    <nav class="custom-header__menu">
      {% if section.settings.menu != blank %}
        <ul>
          {% for link in linklists[section.settings.menu].links %}
            <li>
              <a href="{{ link.url }}">
                {{ link.title }}
              </a>

              {% if link.links != blank %}
                <ul class="submenu">
                  {% for childlink in link.links %}
                    <li>
                      <a href="{{ childlink.url }}">
                        {{ childlink.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <!-- RIGHT: Account + Cart -->
    <div class="custom-header__icons">
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}">
        Cart ({{ cart.item_count }})
      </a>
    </div>

  </div>
</header>

<style>
.custom-header {
  background: #111;
  padding: 18px 40px;
  position: relative;
  z-index: 20;
}

.custom-header__wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Logo */
.custom-header__logo img {
  max-height: 50px;
}

/* Menu */
.custom-header__menu ul {
  list-style: none;
  display: flex;
  gap: 30px;
  margin: 0;
  padding: 0;
}

.custom-header__menu a {
  text-decoration: none;
  color: #fff;
  font-weight: 500;
  font-size: 15px;
  transition: 0.3s;
}

.custom-header__menu a:hover {
  color: #0c7c3a;
}

/* Dropdown */
.custom-header__menu li {
  position: relative;
}

.submenu {
  position: absolute;
  top: 100%;
  left: 0;
  background: #222;
  padding: 15px;
  display: none;
  flex-direction: column;
  gap: 10px;
  min-width: 180px;
}

.custom-header__menu li:hover .submenu {
  display: flex;
}

.submenu a {
  font-size: 14px;
}

/* Icons */
.custom-header__icons {
  display: flex;
  gap: 20px;
}

.custom-header__icons a {
  color: #fff;
  text-decoration: none;
  font-size: 14px;
}

/* Responsive */
@media (max-width: 991px) {
  .custom-header__menu {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Custom Menu Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Select Menu"
    }
  ],
  "presets": [
    {
      "name": "Custom Menu Header"
    }
  ]
}
{% endschema %}