<section id="testimonial-{{ section.id }}" 
  class="testimonial-slider {{ section.settings.custom_class }}"
  style="padding-top:{{ section.settings.padding_top }}px;
         padding-bottom:{{ section.settings.padding_bottom }}px;">

  <div class="slider-wrapper">
    <div class="slides">
      {% for block in section.blocks %}
        <div class="slide" {{ block.shopify_attributes }}>
          
          {% if block.settings.subtext != blank %}
            <p class="subtext">{{ block.settings.subtext }}</p>
          {% endif %}
          
          {% if block.settings.quote != blank %}
            <h2 class="quote">{{ block.settings.quote }}</h2>
          {% endif %}

          {% if block.settings.logo != blank %}
            <div class="logo">
              <img 
                src="{{ block.settings.logo | image_url: width: 400 }}" 
                alt="{{ block.settings.logo.alt | escape }}"
                loading="lazy">
            </div>
          {% endif %}

        </div>
      {% endfor %}
    </div>

    <button class="nav prev">&#8592;</button>
    <button class="nav next">&#8594;</button>
  </div>
</section>

<style>
.testimonial-slider{
  background:#f7f7f5;
  overflow:hidden;
  position:relative;
  text-align:center;
}

.slider-wrapper{
  max-width:1200px;
  margin:auto;
  overflow:hidden;
  position:relative;
  padding:0 15%; /* This creates 1/2 preview */
}

.slides{
  display:flex;
  transition:transform .5s ease;
}

.slide{
  flex:0 0 70%; /* Main visible width */
  margin:0 15px;
  opacity:.4;
  transform:scale(.85);
  transition:all .4s ease;
}

.slide.active{
  opacity:1;
  transform:scale(1);
}

.subtext{
  font-size:14px;
  color:#777;
  margin-bottom:15px;
}

.quote{
  font-size:28px;
  margin-bottom:25px;
}

.logo img{
  max-width:180px;
  margin:auto;
}

.nav{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  width:45px;
  height:45px;
  border-radius:50%;
  background:#fff;
  border:1px solid #ddd;
  cursor:pointer;
  z-index:10;
}

.prev{ left:10px; }
.next{ right:10px; }

/* Tablet & Mobile */
@media(max-width:991px){
  .slider-wrapper{ padding:0; }
  .slide{
    flex:0 0 100%;
    margin:0;
    opacity:1;
    transform:scale(1);
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const slider = document.querySelector("#testimonial-{{ section.id }}");
  if(!slider) return;

  const slidesContainer = slider.querySelector(".slides");
  let slides = slider.querySelectorAll(".slide");
  const prevBtn = slider.querySelector(".prev");
  const nextBtn = slider.querySelector(".next");

  const total = slides.length;
  const autoplay = {{ section.settings.autoplay | json }};
  const speed = {{ section.settings.speed | json }};

  if(total < 2) return;

  let index = 1;

  // Clone slides
  const firstClone = slides[0].cloneNode(true);
  const lastClone = slides[total - 1].cloneNode(true);

  slidesContainer.appendChild(firstClone);
  slidesContainer.insertBefore(lastClone, slidesContainer.firstChild);

  slides = slider.querySelectorAll(".slide");

  function getSlideWidth(){
    return slides[0].offsetWidth + 30; // including margin
  }

  function updateSlider(animate = true){
    const slideWidth = getSlideWidth();
    slidesContainer.style.transition = animate ? "transform .5s ease" : "none";
    slidesContainer.style.transform = `translateX(-${index * slideWidth}px)`;

    slides.forEach(s => s.classList.remove("active"));
    if(slides[index]) slides[index].classList.add("active");
  }

  function nextSlide(){
    index++;
    updateSlider();
  }

  function prevSlide(){
    index--;
    updateSlider();
  }

  slidesContainer.addEventListener("transitionend", ()=>{
    if(index >= slides.length - 1){
      index = 1;
      updateSlider(false);
    }
    if(index <= 0){
      index = slides.length - 2;
      updateSlider(false);
    }
  });

  nextBtn.addEventListener("click", nextSlide);
  prevBtn.addEventListener("click", prevSlide);

  window.addEventListener("load", ()=>{
    updateSlider(false);
  });

  window.addEventListener("resize", ()=>{
    updateSlider(false);
  });

  if(autoplay){
    setInterval(nextSlide, speed);
  }

});
</script>