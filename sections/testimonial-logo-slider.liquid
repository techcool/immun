{% schema %}
{
  "name": "Testimonial Logo Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 4000,
      "label": "Autoplay Speed (ms)"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote Text" },
        { "type": "text", "id": "subtext", "label": "Sub Text" },
        { "type": "image_picker", "id": "logo", "label": "Logo Image" }
      ]
    }
  ],
  "presets": [
    { "name": "Testimonial Logo Slider" }
  ]
}
{% endschema %}

<section class="testimonial-slider">
  <div class="page-width">
    <div class="slider-wrapper">

      <div class="slides">
        {% for block in section.blocks %}
          <div class="slide">
            {% if block.settings.subtext != blank %}
              <p class="subtext">{{ block.settings.subtext }}</p>
            {% endif %}
            {% if block.settings.quote != blank %}
              <h2 class="quote">{{ block.settings.quote }}</h2>
            {% endif %}
            {% if block.settings.logo != blank %}
              <div class="logo">
                <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="">
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <button class="nav prev">&#8592;</button>
      <button class="nav next">&#8594;</button>

    </div>
  </div>
</section>

<style>
.testimonial-slider{
  background:#f7f7f5;
  overflow:hidden;
  padding:80px 0;
}

.slider-wrapper{
  max-width:1100px;
  margin:auto;
  position:relative;
}

.slides{
  display:flex;
  align-items:center;
  transition:transform .5s ease;
}

.slide{
  flex:0 0 33.3333%;
  text-align:center;
  opacity:.4;
  transform:scale(.85);
  transition:.4s ease;
  padding:20px;
}

.slide.active{
  opacity:1;
  transform:scale(1);
}

.quote{font-size:26px;margin-bottom:20px;}
.subtext{font-size:14px;color:#777;margin-bottom:10px;}
.logo img{max-width:180px;margin:auto;}

.nav{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  width:45px;
  height:45px;
  border-radius:50%;
  border:1px solid #ccc;
  background:#fff;
  cursor:pointer;
}

.prev{left:-20px;}
.next{right:-20px;}

@media(max-width:768px){
  .slide{
    flex:0 0 100%;
    opacity:1;
    transform:scale(1);
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const slider = document.querySelector(".testimonial-slider");
  if(!slider) return;

  const container = slider.querySelector(".slides");
  let slides = slider.querySelectorAll(".slide");
  const nextBtn = slider.querySelector(".next");
  const prevBtn = slider.querySelector(".prev");

  const total = slides.length;
  const autoplay = {{ section.settings.autoplay }};
  const speed = {{ section.settings.speed }};

  if(total < 3) return;

  let index = 1;

  // Clone first & last
  const first = slides[0].cloneNode(true);
  const last = slides[total - 1].cloneNode(true);

  container.appendChild(first);
  container.insertBefore(last, slides[0]);

  slides = slider.querySelectorAll(".slide");

  function update(animate = true){

    const width = slides[0].offsetWidth;
    const offset = index * width;

    container.style.transition = animate ? "transform .5s ease" : "none";
    container.style.transform = `translateX(-${offset - width}px)`;

    slides.forEach(s => s.classList.remove("active"));
    slides[index].classList.add("active");
  }

  function next(){
    index++;
    update();
  }

  function prev(){
    index--;
    update();
  }

  container.addEventListener("transitionend", function(){

    if(index === slides.length - 1){
      index = 1;
      update(false);
    }

    if(index === 0){
      index = slides.length - 2;
      update(false);
    }
  });

  nextBtn.addEventListener("click", next);
  prevBtn.addEventListener("click", prev);

  update(false);

  if(autoplay){
    setInterval(next, speed);
  }

});
</script>