{% schema %}
{
  "name": "Testimonial Logo Slider",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80,
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80,
      "label": "Padding Bottom"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 4000,
      "label": "Autoplay Speed (ms)"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote Text"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Sub Text"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Logo Slider"
    }
  ]
}
{% endschema %}

<section class="testimonial-slider {{ section.settings.custom_class }}" 
  style="padding-top:{{ section.settings.padding_top }}px;
         padding-bottom:{{ section.settings.padding_bottom }}px;">

  <div class="page-width">
    <div class="slider-wrapper">

      <div class="slides">
        {% for block in section.blocks %}
          <div class="slide" {{ block.shopify_attributes }}>
            
            {% if block.settings.subtext != blank %}
              <p class="subtext">{{ block.settings.subtext }}</p>
            {% endif %}
            
            {% if block.settings.quote != blank %}
              <h2 class="quote">{{ block.settings.quote }}</h2>
            {% endif %}

            {% if block.settings.logo != blank %}
              <div class="logo">
                <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="logo">
              </div>
            {% endif %}

          </div>
        {% endfor %}
      </div>

      <button class="nav prev">&#8592;</button>
      <button class="nav next">&#8594;</button>

    </div>
  </div>
</section>

<style>
.testimonial-slider {
  background:#f7f7f5;
  text-align:center;
  position:relative;
  overflow:hidden;
}

.slider-wrapper {
  max-width:1000px;
  margin:0 auto;
  position:relative;
  overflow:hidden;
}

.slides {
  display:flex;
  transition:transform 0.6s ease-in-out;
  will-change: transform;
}

.slide {
  flex:0 0 100%;
  padding:40px 20px;
  transition:all 0.5s ease;
  opacity:0.4;
  transform:scale(0.85);
}

.slide.active {
  opacity:1;
  transform:scale(1);
}

.slide.prev,
.slide.next {
  opacity:0.6;
  transform:scale(0.9);
}

.subtext {
  font-size:14px;
  color:#777;
  margin-bottom:15px;
}

.quote {
  font-size:28px;
  font-weight:500;
  margin-bottom:30px;
}

.logo img {
  max-width:200px;
  margin:0 auto;
}

.nav {
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  background:#fff;
  border:1px solid #ddd;
  width:45px;
  height:45px;
  border-radius:50%;
  cursor:pointer;
  z-index:5;
}

.prev { left:0; }
.next { right:0; }

.dots {
  margin-top:30px;
}

.dots span {
  display:inline-block;
  width:8px;
  height:8px;
  margin:0 5px;
  background:#ccc;
  border-radius:50%;
  cursor:pointer;
}

.dots span.active {
  background:#000;
}

@media(max-width:768px){
  .slide{
    opacity:1 !important;
    transform:scale(1) !important;
  }
  .quote{font-size:20px;}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const slider = document.querySelector(".testimonial-slider");
  if(!slider) return;

  const track = slider.querySelector(".slides");
  let slides = slider.querySelectorAll(".slide");
  const prev = slider.querySelector(".prev");
  const next = slider.querySelector(".next");

  const total = slides.length;
  if(total < 3) return;

  let index = 1;
  let isMoving = false;

  // Clone first & last
  const first = slides[0].cloneNode(true);
  const last = slides[total - 1].cloneNode(true);

  track.appendChild(first);
  track.insertBefore(last, slides[0]);

  slides = slider.querySelectorAll(".slide");

  function update(animate = true){
    const slideWidth = slides[0].offsetWidth;
    track.style.transition = animate ? "transform 0.5s ease" : "none";
    track.style.transform = `translateX(-${(index) * slideWidth}px)`;

    slides.forEach(s => s.classList.remove("active"));
    slides[index].classList.add("active");
  }

  function nextSlide(){
    if(isMoving) return;
    isMoving = true;
    index++;
    update(true);
  }

  function prevSlide(){
    if(isMoving) return;
    isMoving = true;
    index--;
    update(true);
  }

  track.addEventListener("transitionend", function(){

    if(index === total + 1){
      index = 1;
      update(false);
    }

    if(index === 0){
      index = total;
      update(false);
    }

    isMoving = false;
  });

  next.addEventListener("click", nextSlide);
  prev.addEventListener("click", prevSlide);

  window.addEventListener("resize", ()=> update(false));

  update(false);

});
</script>

