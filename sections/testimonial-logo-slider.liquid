{% schema %}
{
  "name": "Testimonial Logo Slider",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80,
      "label": "Padding Top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80,
      "label": "Padding Bottom"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 4000,
      "label": "Autoplay Speed (ms)"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote Text"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Sub Text"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Logo Slider"
    }
  ]
}
{% endschema %}

<section class="testimonial-slider {{ section.settings.custom_class }}" 
  style="padding-top:{{ section.settings.padding_top }}px;
         padding-bottom:{{ section.settings.padding_bottom }}px;">

  <div class="slider-wrapper">
    
    <div class="slides">
      {% for block in section.blocks %}
        <div class="slide" {{ block.shopify_attributes }}>
          
          {% if block.settings.subtext != blank %}
            <p class="subtext">{{ block.settings.subtext }}</p>
          {% endif %}
          
          {% if block.settings.quote != blank %}
            <h2 class="quote">{{ block.settings.quote }}</h2>
          {% endif %}

          {% if block.settings.logo != blank %}
            <div class="logo">
              <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="logo">
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <button class="nav prev">&#8592;</button>
    <button class="nav next">&#8594;</button>

    <div class="dots"></div>

  </div>
</section>

<style>
.testimonial-slider {
  background:#f7f7f5;
  text-align:center;
  position:relative;
}

.slider-wrapper {
  max-width:900px;
  margin:0 auto;
  position:relative;
}

.slides {
  display:flex;
  transition:transform 0.5s ease;
}

.slide {
  min-width:100%;
  padding:20px;
}

.subtext {
  font-size:14px;
  color:#777;
  margin-bottom:15px;
}

.quote {
  font-size:28px;
  font-weight:500;
  margin-bottom:30px;
}

.logo img {
  max-width:200px;
  margin:0 auto;
}

.nav {
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  background:#fff;
  border:1px solid #ddd;
  width:45px;
  height:45px;
  border-radius:50%;
  cursor:pointer;
}

.prev { left:-60px; }
.next { right:-60px; }

.dots {
  margin-top:30px;
}

.dots span {
  display:inline-block;
  width:8px;
  height:8px;
  margin:0 5px;
  background:#ccc;
  border-radius:50%;
  cursor:pointer;
}

.dots span.active {
  background:#000;
}

@media(max-width:768px){
  .quote{font-size:20px;}
  .prev{left:10px;}
  .next{right:10px;}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){
  const slider = document.querySelector(".testimonial-slider");
  if(!slider) return;

  const slides = slider.querySelector(".slides");
  const slide = slider.querySelectorAll(".slide");
  const prev = slider.querySelector(".prev");
  const next = slider.querySelector(".next");
  const dotsContainer = slider.querySelector(".dots");

  let index = 0;
  const total = slide.length;
  const autoplay = {{ section.settings.autoplay }};
  const speed = {{ section.settings.speed }};

  function updateSlider(){
    slides.style.transform = `translateX(-${index * 100}%)`;
    document.querySelectorAll(".dots span").forEach((dot,i)=>{
      dot.classList.toggle("active", i === index);
    });
  }

  function nextSlide(){
    index = (index + 1) % total;
    updateSlider();
  }

  function prevSlide(){
    index = (index - 1 + total) % total;
    updateSlider();
  }

  next.addEventListener("click", nextSlide);
  prev.addEventListener("click", prevSlide);

  for(let i=0;i<total;i++){
    const dot = document.createElement("span");
    dot.addEventListener("click", ()=>{
      index = i;
      updateSlider();
    });
    dotsContainer.appendChild(dot);
  }

  updateSlider();

  if(autoplay){
    setInterval(nextSlide, speed);
  }
});
</script>