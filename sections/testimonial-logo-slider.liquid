<script>
document.addEventListener("DOMContentLoaded", function(){

  const slider = document.querySelector(".testimonial-slider");
  if(!slider) return;

  const slidesContainer = slider.querySelector(".slides");
  const slides = slider.querySelectorAll(".slide");
  const prevBtn = slider.querySelector(".prev");
  const nextBtn = slider.querySelector(".next");
  const dotsContainer = slider.querySelector(".dots");

  let slidesToShow;
  let index;
  let total = slides.length;
  let autoplay = {{ section.settings.autoplay }};
  let speed = {{ section.settings.speed }};
  let interval;

  function getSlidesToShow(){
    return window.innerWidth <= 768 ? 1 :
           window.innerWidth <= 1024 ? 2 : 3;
  }

  slidesToShow = getSlidesToShow();
  index = slidesToShow;

  // Clone Slides for Infinite Effect
  function cloneSlides(){
    const currentSlides = slider.querySelectorAll(".slide");
    currentSlides.forEach(slide => slide.remove());

    slides.forEach(slide => {
      slidesContainer.appendChild(slide.cloneNode(true));
    });

    for(let i = 0; i < slidesToShow; i++){
      const firstClone = slides[i].cloneNode(true);
      const lastClone = slides[total - 1 - i].cloneNode(true);
      slidesContainer.appendChild(firstClone);
      slidesContainer.insertBefore(lastClone, slidesContainer.firstChild);
    }
  }

  cloneSlides();

  let allSlides = slider.querySelectorAll(".slide");

  function updateSlider(animate = true){
    const slideWidth = allSlides[0].offsetWidth;

    slidesContainer.style.transition = animate ? "transform 0.5s ease" : "none";

    const offset = (slidesToShow / 2) * slideWidth;
    slidesContainer.style.transform =
      `translateX(-${(index * slideWidth) - offset + (slideWidth / 2)}px)`;

    allSlides.forEach(slide => slide.classList.remove("active"));

    if(allSlides[index]){
      allSlides[index].classList.add("active");
    }

    updateDots();
  }

  function updateDots(){
    const realIndex = (index - slidesToShow + total) % total;
    dotsContainer.querySelectorAll("span").forEach((dot,i)=>{
      dot.classList.toggle("active", i === realIndex);
    });
  }

  function nextSlide(){
    index++;
    updateSlider();
  }

  function prevSlide(){
    index--;
    updateSlider();
  }

  slidesContainer.addEventListener("transitionend", ()=>{
    if(index >= total + slidesToShow){
      index = slidesToShow;
      updateSlider(false);
    }
    if(index < slidesToShow){
      index = total + slidesToShow - 1;
      updateSlider(false);
    }
  });

  nextBtn.addEventListener("click", nextSlide);
  prevBtn.addEventListener("click", prevSlide);

  // Create Dots
  function createDots(){
    dotsContainer.innerHTML = "";
    for(let i = 0; i < total; i++){
      const dot = document.createElement("span");
      dot.addEventListener("click", ()=>{
        index = i + slidesToShow;
        updateSlider();
      });
      dotsContainer.appendChild(dot);
    }
  }

  createDots();
  updateSlider(false);

  if(autoplay){
    interval = setInterval(nextSlide, speed);
    slider.addEventListener("mouseenter", ()=> clearInterval(interval));
    slider.addEventListener("mouseleave", ()=>{
      interval = setInterval(nextSlide, speed);
    });
  }

  // Handle Resize Properly
  window.addEventListener("resize", ()=>{
    slidesToShow = getSlidesToShow();
    index = slidesToShow;
    cloneSlides();
    allSlides = slider.querySelectorAll(".slide");
    createDots();
    updateSlider(false);
  });

});
</script>

