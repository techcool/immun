{% schema %}
{
  "name": "Center Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 4000,
      "label": "Autoplay speed",
      "unit": "ms"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "subtext", "label": "Subtext" },
        { "type": "image_picker", "id": "logo", "label": "Logo" }
      ]
    }
  ],
  "presets": [
    { "name": "Center Slider" }
  ]
}
{% endschema %}

<section class="center-slider">
  <div class="slider-wrapper">
    <div class="slider-track">
      {% for block in section.blocks %}
        <div class="slide" {{ block.shopify_attributes }}>
          {% if block.settings.subtext != blank %}
            <p class="subtext">{{ block.settings.subtext }}</p>
          {% endif %}
          {% if block.settings.quote != blank %}
            <h2 class="quote">{{ block.settings.quote }}</h2>
          {% endif %}
          {% if block.settings.logo != blank %}
            <div class="logo">
              <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="logo">
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <button class="nav prev">&#8592;</button>
    <button class="nav next">&#8594;</button>
  </div>
</section>

<style>
.center-slider {
  background: #f7f7f5;
  padding: 80px 0;
  overflow: hidden;
}

.slider-wrapper {
  max-width: 1100px;
  margin: auto;
  position: relative;
}

.slider-track {
  display: flex;
  align-items: center;
  transition: transform 0.5s ease;
}

.slide {
  flex: 0 0 33.333%;
  text-align: center;
  opacity: 0.4;
  transform: scale(0.8);
  transition: all 0.4s ease;
  padding: 20px;
}

.slide.active {
  opacity: 1;
  transform: scale(1);
}

.subtext {
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

.quote {
  font-size: 24px;
  margin-bottom: 20px;
}

.logo img {
  max-width: 180px;
  max-height: 80px;
}

.nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 45px;
  height: 45px;
  border-radius: 50%;
  border: 1px solid #ccc;
  background: #fff;
  cursor: pointer;
}

.prev { left: 0; }
.next { right: 0; }

@media (max-width: 768px) {
  .slide {
    flex: 0 0 100%;
    opacity: 1;
    transform: scale(1);
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const slider = document.querySelector(".center-slider");
  if (!slider) return;

  const track = slider.querySelector(".slider-track");
  let slides = slider.querySelectorAll(".slide");
  const prev = slider.querySelector(".prev");
  const next = slider.querySelector(".next");

  const total = slides.length;
  if (total < 3) return;

  let index = 1; // middle active

  // Clone first & last for infinite loop
  const firstClone = slides[0].cloneNode(true);
  const lastClone = slides[total - 1].cloneNode(true);

  track.appendChild(firstClone);
  track.insertBefore(lastClone, slides[0]);

  slides = slider.querySelectorAll(".slide");

  function updateSlider(animate = true) {
    track.style.transition = animate ? "transform 0.5s ease" : "none";
    track.style.transform = `translateX(-${index * 33.333}%)`;

    slides.forEach(s => s.classList.remove("active"));
    slides[index].classList.add("active");
  }

  function nextSlide() {
    index++;
    updateSlider();
  }

  function prevSlide() {
    index--;
    updateSlider();
  }

  track.addEventListener("transitionend", () => {
    if (index >= total + 1) {
      index = 1;
      updateSlider(false);
    }
    if (index <= 0) {
      index = total;
      updateSlider(false);
    }
  });

  next.addEventListener("click", nextSlide);
  prev.addEventListener("click", prevSlide);

  {% if section.settings.autoplay %}
    setInterval(nextSlide, {{ section.settings.speed }});
  {% endif %}

  updateSlider(false);
});
</script>