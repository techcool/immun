{% assign section_id = 'section-' | append: section.id %}

<section id="{{ section_id }}" class="testimonial-slider">
  <div class="page-width">

    <div class="swiper testimonial-swiper">
      <div class="swiper-wrapper">

        {% for block in section.blocks %}
          <div class="swiper-slide testimonial-slide" {{ block.shopify_attributes }}>

            {% if block.settings.text != blank %}
              <p class="testimonial-text">
                {{ block.settings.text }}
              </p>
            {% endif %}

            {% if block.settings.logo != blank %}
              <div class="testimonial-logo">
                <img 
                  src="{{ block.settings.logo | image_url: width: 300 }}" 
                  alt="logo"
                  loading="lazy"
                >
              </div>
            {% endif %}

          </div>
        {% endfor %}

      </div>

      <!-- NAV -->
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>

      <!-- DOTS -->
      <div class="swiper-pagination"></div>
    </div>

  </div>
</section>

<!-- SWIPER CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>

<style>
#{{ section_id }} {
  padding: 80px 0;
}

/* 🔥 CRITICAL FIX */
#{{ section_id }} .page-width,
#{{ section_id }} .swiper {
  overflow: visible;
}

/* SLIDE */
#{{ section_id }} .testimonial-slide {
  text-align: center;
  opacity: 0.4;
  transform: scale(0.85);
  transition: all 0.4s ease;
}

/* ACTIVE CENTER */
#{{ section_id }} .swiper-slide-active {
  opacity: 1;
  transform: scale(1);
}

/* TEXT */
#{{ section_id }} .testimonial-text {
  font-size: 22px;
  line-height: 1.6;
  margin-bottom: 25px;
}

/* LOGO */
#{{ section_id }} .testimonial-logo img {
  max-width: 160px;
  margin: 0 auto;
}

/* NAV BUTTON */
#{{ section_id }} .swiper-button-prev,
#{{ section_id }} .swiper-button-next {
  width: 48px;
  height: 48px;
  border: 2px solid #1f3d2b;
  border-radius: 50%;
  color: #1f3d2b;
  top: 50%;
  transform: translateY(-50%);
}

#{{ section_id }} .swiper-button-prev::after,
#{{ section_id }} .swiper-button-next::after {
  font-size: 16px;
}

/* DOTS */
#{{ section_id }} .swiper-pagination-bullet {
  background: #000;
  opacity: 0.3;
}

#{{ section_id }} .swiper-pagination-bullet-active {
  opacity: 1;
}

/* MOBILE */
@media (max-width: 768px) {
  #{{ section_id }} .testimonial-text {
    font-size: 16px;
  }
}
</style>

<!-- SWIPER JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
function initTestimonialSwiper{{ section.id }}() {
  const el = document.querySelector("#{{ section_id }} .testimonial-swiper");
  if (!el) return;

  if (el.swiper) {
    el.swiper.destroy(true, true);
  }

  const swiper = new Swiper(el, {
    loop: true,
    centeredSlides: true,
    speed: 600,

    slidesPerView: 1.2,
    spaceBetween: 20,

    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },

    navigation: {
      nextEl: "#{{ section_id }} .swiper-button-next",
      prevEl: "#{{ section_id }} .swiper-button-prev",
    },

    pagination: {
      el: "#{{ section_id }} .swiper-pagination",
      clickable: true,
    },

    breakpoints: {
      768: {
        slidesPerView: 1.5,
        spaceBetween: 30,
      },
      1024: {
        slidesPerView: 2,
        spaceBetween: 60,
      }
    },

    on: {
      init: function () {
        this.update();
      }
    }
  });

  setTimeout(() => {
    swiper.update();
  }, 300);
}

/* INIT */
document.addEventListener("DOMContentLoaded", initTestimonialSwiper{{ section.id }});

/* SHOPIFY EDITOR FIX */
document.addEventListener("shopify:section:load", initTestimonialSwiper{{ section.id }});
</script>

{% schema %}
{
  "name": "Testimonial Slider",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Quote",
          "default": "A multivitamin that doesn’t taste bad? Count us in."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Slider"
    }
  ]
}
{% endschema %}