{% style %}

.footer-top{
background: {{ section.settings.bg_color }};
color:#fff;
padding:80px 20px;
}

.footer-wrapper{
max-width:1400px;
margin:auto;
display:grid;
grid-template-columns:1.2fr 1fr 1fr 1fr;
gap:40px;
}

.footer-menu h3{
margin-bottom:20px;
font-size:22px;
}

.footer-menu ul{
list-style:none;
padding:0;
}

.footer-menu li{
margin-bottom:10px;
}

.footer-menu a{
text-decoration:none;
color:inherit;
}

.footer-menu a:hover{
text-decoration:underline;
}

@media(max-width:900px){
.footer-wrapper{
grid-template-columns:1fr;
}
}

{% endstyle %}

<section class="footer-top">

<div class="footer-wrapper">

<!-- Signup Area -->
<div>
<h2>{{ section.settings.heading }}</h2>
</div>

<!-- Column 1 -->
<div class="footer-menu">
<h3>{{ section.settings.title1 }}</h3>

<ul>
{% for block in section.blocks %}
{% if block.type == 'menu1' %}
<li>
<a href="{{ block.settings.link }}">
{{ block.settings.text }}
</a>
</li>
{% endif %}
{% endfor %}
</ul>
</div>

<!-- Column 2 -->
<div class="footer-menu">
<h3>{{ section.settings.title2 }}</h3>

<ul>
{% for block in section.blocks %}
{% if block.type == 'menu2' %}
<li>
<a href="{{ block.settings.link }}">
{{ block.settings.text }}
</a>
</li>
{% endif %}
{% endfor %}
</ul>
</div>

<!-- Column 3 -->
<div class="footer-menu">
<h3>{{ section.settings.title3 }}</h3>

<ul>
{% for block in section.blocks %}
{% if block.type == 'menu3' %}
<li>
<a href="{{ block.settings.link }}">
{{ block.settings.text }}
</a>
</li>
{% endif %}
{% endfor %}
</ul>
</div>

</div>

</section>

{% schema %}
{
"name": "Footer Top",
"settings":[

{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Sign Up for 52% Off"
},

{
"type":"color",
"id":"bg_color",
"label":"Background",
"default":"#004225"
},

{
"type":"text",
"id":"title1",
"label":"Menu Title 1",
"default":"Learn"
},

{
"type":"text",
"id":"title2",
"label":"Menu Title 2",
"default":"Connect"
},

{
"type":"text",
"id":"title3",
"label":"Menu Title 3",
"default":"Brand"
}

],

"blocks":[

{
"type":"menu1",
"name":"Menu 1 Link",
"settings":[
{
"type":"text",
"id":"text",
"label":"Link Text"
},
{
"type":"url",
"id":"link",
"label":"Link"
}
]
},

{
"type":"menu2",
"name":"Menu 2 Link",
"settings":[
{
"type":"text",
"id":"text",
"label":"Link Text"
},
{
"type":"url",
"id":"link",
"label":"Link"
}
]
},

{
"type":"menu3",
"name":"Menu 3 Link",
"settings":[
{
"type":"text",
"id":"text",
"label":"Link Text"
},
{
"type":"url",
"id":"link",
"label":"Link"
}
]
}

],

"presets":[
{
"name":"Footer Top"
}
]
}
{% endschema %}