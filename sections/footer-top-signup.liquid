{% style %}

.footer-top{
background: {{ section.settings.bg_color }};
color: {{ section.settings.text_color }};
padding:80px 20px;
}

.footer-top-wrapper{
max-width:1400px;
margin:auto;
display:grid;
grid-template-columns:1.2fr 1fr 1fr 1fr;
gap:40px;
align-items:flex-start;
}

.footer-signup h2{
font-size:28px;
margin-bottom:20px;
}

.footer-input{
display:flex;
align-items:center;
}

.footer-input input{
width:100%;
padding:14px;
border:none;
outline:none;
font-size:16px;
}

.footer-input button{
background:#ffc72c;
border:none;
padding:14px 20px;
cursor:pointer;
font-weight:600;
}

.footer-email{
margin-top:10px;
display:inline-block;
text-decoration:underline;
}

.footer-desc{
font-size:12px;
opacity:.8;
margin-top:15px;
line-height:1.6;
}

.footer-menu h4{
font-size:20px;
margin-bottom:15px;
}

.footer-menu ul{
list-style:none;
padding:0;
margin:0;
}

.footer-menu li{
margin-bottom:8px;
}

.footer-menu a{
color:inherit;
text-decoration:none;
}

.footer-menu a:hover{
text-decoration:underline;
}

@media(max-width:900px){

.footer-top-wrapper{
grid-template-columns:1fr;
gap:40px;
}

}

{% endstyle %}

<section class="footer-top">

<div class="footer-top-wrapper">

<div class="footer-signup">

<h2>{{ section.settings.heading }}</h2>

<div class="footer-input">
<input type="text" placeholder="{{ section.settings.placeholder }}">
<button>{{ section.settings.button }}</button>
</div>

<a href="#" class="footer-email">
{{ section.settings.email_text }}
</a>

<div class="footer-desc">
{{ section.settings.description }}
</div>

</div>

<div class="footer-menu">

<h4>{{ section.settings.menu_title1 }}</h4>

<ul>
{% for link in linklists[section.settings.menu1].links %}
<li><a href="{{ link.url }}">{{ link.title }}</a></li>
{% endfor %}
</ul>

</div>

<div class="footer-menu">

<h4>{{ section.settings.menu_title2 }}</h4>

<ul>
{% for link in linklists[section.settings.menu2].links %}
<li><a href="{{ link.url }}">{{ link.title }}</a></li>
{% endfor %}
</ul>

</div>

<div class="footer-menu">

<h4>{{ section.settings.menu_title3 }}</h4>

<ul>
{% for link in linklists[section.settings.menu3].links %}
<li><a href="{{ link.url }}">{{ link.title }}</a></li>
{% endfor %}
</ul>

</div>

</div>

</section>

{% schema %}
{
"name": "Footer Top Signup",
"settings":[

{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Sign Up for 52% Off"
},

{
"type":"text",
"id":"placeholder",
"label":"Input Placeholder",
"default":"Phone number"
},

{
"type":"text",
"id":"button",
"label":"Button Text",
"default":"→"
},

{
"type":"text",
"id":"email_text",
"label":"Email Link Text",
"default":"Email me instead"
},

{
"type":"textarea",
"id":"description",
"label":"Description",
"default":"By providing your number and clicking the button, you agree to receive recurring marketing SMS."
},

{
"type":"color",
"id":"bg_color",
"label":"Background Color",
"default":"#004225"
},

{
"type":"color",
"id":"text_color",
"label":"Text Color",
"default":"#ffffff"
},

{
"type":"text",
"id":"menu_title1",
"label":"Menu Title 1",
"default":"Learn"
},

{
"type":"link_list",
"id":"menu1",
"label":"Menu 1"
},

{
"type":"text",
"id":"menu_title2",
"label":"Menu Title 2",
"default":"Connect"
},

{
"type":"link_list",
"id":"menu2",
"label":"Menu 2"
},

{
"type":"text",
"id":"menu_title3",
"label":"Menu Title 3",
"default":"More"
},

{
"type":"link_list",
"id":"menu3",
"label":"Menu 3"
}

],
"presets":[
{
"name":"Footer Top Signup"
}
]
}
{% endschema %}