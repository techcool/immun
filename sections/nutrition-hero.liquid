{% assign section_id = 'section-' | append: section.id %}

<section
  id="{{ section_id }}"
  class="nutrition-hero color-{{ section.settings.color_scheme }} {{ section.settings.custom_class }}"
>
  <div class="page-width">
    <div class="nutrition-hero__wrapper">

      <!-- LEFT CONTENT -->
      <div class="nutrition-hero__content">

        {% if section.settings.rating_text != blank %}
          <div class="nutrition-rating">
            
            <div class="nutrition-stars">
              {% for i in (1..5) %}
                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.2 1 5.9L10 15.8l-5.2 2.8 1-5.9-4.3-4.2 5.9-.9L10 1.5z"/>
                </svg>
              {% endfor %}
            </div>

            <div class="nutrition-rating-text rte">
              {{ section.settings.rating_text }}
            </div>

          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="nutrition-heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="nutrition-description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="button nutrition-btn">
            {{ section.settings.button_text }}
          </a>
        {% endif %}

        {% if section.settings.button_subtext != blank %}
          <div class="nutrition-button-subtext rte">
            {{ section.settings.button_subtext }}
          </div>
        {% endif %}

        <div class="nutrition-button-subtext rte">
          <p>
            30 Day Guarantee
            <span class="tooltip">
              ⓘ
              <span class="tooltip-text">We offer a 30-day money-back guarantee on all products.</span>
            </span>
          </p>

          <p>
            Return shipping charges not included.<br>
            See <a href="#" target="_blank" title="Refund Policy">Refund Policy</a>.
          </p>
        </div>

      </div>

      <!-- RIGHT IMAGE -->
      <div class="nutrition-hero__image">
        {% if section.settings.product_image != blank %}
          <img
            src="{{ section.settings.product_image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
          >
        {% endif %}
      </div>

    </div>
  </div>

  <style>
    #{{ section_id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    @media screen and (max-width: 749px) {
      #{{ section_id }} {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      }
    }

    .nutrition-hero__wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 60px;
    }

    .nutrition-hero__content {
      flex: 1;
      max-width: 600px;
    }

    .nutrition-rating {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 15px;
    }

    .nutrition-stars {
      display: flex;
      gap: 4px;
      color: #f5b301;
    }

    .nutrition-rating-text {
      font-size: 14px;
      font-weight: 600;
    }

    .nutrition-heading {
      font-size: 44px;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 20px;
    }

    .nutrition-description {
      margin-bottom: 25px;
    }

    .nutrition-btn {
      margin-top: 10px;
    }

    .nutrition-button-subtext {
      margin-top: 12px;
      font-size: 14px;
      opacity: 0.85;
    }

    .nutrition-hero__image {
      flex: 1;
    }

    .nutrition-hero__image img {
      width: 100%;
      border-radius: 20px;
      display: block;
    }

    @media screen and (max-width: 990px) {
      .nutrition-hero__wrapper {
        flex-direction: column;
        text-align: center;
      }

      .nutrition-heading {
        font-size: 32px;
      }

      .nutrition-rating {
        justify-content: center;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Nutrition Hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Add custom class"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Rating description",
      "default": "<p>4.8 stars from 85,000 reviews | 1,000,000+ members</p>"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "You have nutrition gaps, Grüns fills them"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "richtext",
      "id": "button_subtext",
      "label": "Button sub text (below button)"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    }
  ],
  "presets": [
    {
      "name": "Nutrition Hero"
    }
  ]
}
{% endschema %}