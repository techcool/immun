<section class="faq-section {{ section.settings.custom_class }}"
style="background: {{ section.settings.bg_color }}; padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px;">

  <div class="page-width faq-container">

    {% if section.settings.heading != blank %}
    <div class="faq-left">
      <h2 class="faq-heading">{{ section.settings.heading }}</h2>
    </div>
    {% endif %}

    <div class="faq-right">

      {% for block in section.blocks %}
      <div class="faq-item {% if forloop.first %}active{% endif %}">

        <button class="faq-question">

          <span class="faq-title">
            {{ block.settings.question }}
          </span>

          <span class="faq-icon">
            {% if forloop.first %}−{% else %}+{% endif %}
          </span>

        </button>

        <div class="faq-answer">
          <div class="faq-answer-inner">
            {{ block.settings.answer }}
          </div>
        </div>

      </div>
      {% endfor %}

    </div>

  </div>
</section>


<style>

.faq-container{
  display:grid;
  grid-template-columns:1fr 1.3fr;
  gap:60px;
  align-items:start;
}

.faq-heading{
  font-size:48px;
  font-weight:700;
  margin:0;
}

.faq-item{
  border-bottom:1px solid #2e4a42;
}

.faq-question{
  width:100%;
  background:none;
  border:none;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 0;
  font-size:20px;
  font-weight:600;
  cursor:pointer;
}

.faq-title{
  text-align:left;
}

.faq-icon{
  font-size:30px;
  line-height:1;
}

.faq-answer{
  max-height:0;
  overflow:hidden;
  transition:max-height 0.45s ease;
  font-size:16px;
  line-height:1.6;
}

.faq-answer-inner{
  padding-bottom:20px;
}

.faq-item.active .faq-answer{
  max-height:500px;
}

@media(max-width:768px){

.faq-container{
  grid-template-columns:1fr;
}

.faq-heading{
  font-size:32px;
  margin-bottom:20px;
}

}

</style>


<script>

document.addEventListener("DOMContentLoaded", function(){

  const items = document.querySelectorAll(".faq-item");

  items.forEach(item => {

    const btn = item.querySelector(".faq-question");

    btn.addEventListener("click", function(){

      items.forEach(el => {

        if(el !== item){
          el.classList.remove("active");
          el.querySelector(".faq-icon").textContent = "+";
        }

      });

      item.classList.toggle("active");

      const icon = item.querySelector(".faq-icon");

      icon.textContent = item.classList.contains("active") ? "−" : "+";

    });

  });

});

</script>



{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Any last questions?"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#d9e6de"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "FAQ Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion"
    }
  ]
}
{% endschema %}