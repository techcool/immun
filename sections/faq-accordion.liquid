<section class="faq-section" style="background: {{ section.settings.bg_color }};">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="faq-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="faq-wrapper">

      {% for block in section.blocks %}
      <div class="faq-item">
        
        <button class="faq-question">
          <span>{{ block.settings.question }}</span>
          <span class="faq-icon">+</span>
        </button>

        <div class="faq-answer">
          {{ block.settings.answer }}
        </div>

      </div>
      {% endfor %}

    </div>

  </div>
</section>


<style>

.faq-section{
  padding:80px 20px;
}

.faq-heading{
  font-size:48px;
  font-weight:700;
  margin-bottom:40px;
}

.faq-wrapper{
  max-width:700px;
  margin-left:auto;
}

.faq-item{
  border-bottom:1px solid #2f4f46;
}

.faq-question{
  width:100%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:20px;
  font-weight:600;
  background:none;
  border:none;
  padding:20px 0;
  cursor:pointer;
}

.faq-icon{
  font-size:28px;
}

.faq-answer{
  display:none;
  padding-bottom:20px;
  font-size:16px;
  line-height:1.6;
}

.faq-item.active .faq-answer{
  display:block;
}

.faq-item.active .faq-icon{
  content:"-";
}

</style>


<script>

document.querySelectorAll('.faq-question').forEach((item)=>{
  item.addEventListener('click', function(){

    const parent = this.parentElement;

    parent.classList.toggle('active');

    const icon = this.querySelector('.faq-icon');

    if(parent.classList.contains('active')){
      icon.textContent = "−";
    }else{
      icon.textContent = "+";
    }

  });
});

</script>



{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Any last questions?"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#d6e3dc"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "FAQ Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion"
    }
  ]
}
{% endschema %}