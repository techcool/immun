{% style %}
 
 .custom-cta{
    background-color:#{{ section.settings.bg-color }}
 }
{% endstyle %}

<section class="custom-cta">
    <div class="page-width">
        <h2 class="heading">
           {{ section.settings.heading }}
        </h2>>
        <div class="description">
            <p>{{ section.settings.description }}</p>
        </div>
        <div class="cta">
            <a href="{{ section.settings.url }}">{{ section.settings.button-label }}</a>
        </div>
    </div>
</section>


{% schema %}

{
   "name": "CTA Banner",
   "settings": [
        {
           "type": "color",
           "id": "bg-color",
           "label": "Add bg color"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Add heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Add description"
        },
        {
          "type": "text",
          "id": "button-label",
          "label": "Add button label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Add url"
        }
   ],
   "presets": [
    {
      "name": "CTA Banner"
    }
   ]
}

{% endschema %}

