<section class="us-vs-them-section">
  <div class="page-width">

    <div class="us-vs-them-wrapper">

      <div class="us-vs-them-left">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.description }}</p>
      </div>

      <div class="us-vs-them-table-wrapper">

        {% if section.blocks.size > 0 %}

        <div class="us-vs-them-table">
          <table>

            <thead>
              <tr>
                <th></th>
                <th class="brand">{{ section.settings.brand_title }}</th>
                <th>{{ section.settings.col_two }}</th>
                <th>{{ section.settings.col_three }}</th>
              </tr>
            </thead>

            <tbody>

              {% for block in section.blocks %}
              <tr>

                <td class="feature">
                  {{ block.settings.feature }}
                </td>

                <td class="brand-value">
                  {{ block.settings.brand_value }}
                </td>

                <td>
                  {{ block.settings.col_two_value }}
                </td>

                <td>
                  {{ block.settings.col_three_value }}
                </td>

              </tr>
              {% endfor %}

            </tbody>

          </table>
        </div>

        {% else %}

        <div class="comparison-image">
          {% if section.settings.table_image != blank %}
            <img
              src="{{ section.settings.table_image | image_url: width: 1200 }}"
              alt="Comparison Image"
              loading="lazy"
            >
          {% endif %}
        </div>

        {% endif %}

      </div>

    </div>

  </div>
</section>

<style>

.us-vs-them-section{
padding:80px 20px;
background:#f7f7f7;
}

.us-vs-them-wrapper{
display:grid;
grid-template-columns:1fr 1.2fr;
gap:60px;
align-items:center;
}

.us-vs-them-left h2{
font-size:40px;
font-weight:700;
margin-bottom:15px;
}

.us-vs-them-left p{
font-size:16px;
color:#555;
}

.us-vs-them-table table{
width:100%;
border-collapse:collapse;
background:#fff;
border-radius:12px;
overflow:hidden;
border:2px solid #1c6b3c;
}

.us-vs-them-table th,
.us-vs-them-table td{
padding:16px;
text-align:center;
border-bottom:1px solid #eee;
}

.us-vs-them-table th:first-child,
.us-vs-them-table td:first-child{
text-align:left;
font-weight:600;
}

.us-vs-them-table thead{
background:#f4f4f4;
}

.us-vs-them-table .brand{
background:#1c6b3c;
color:#fff;
font-weight:700;
}

.us-vs-them-table .brand-value{
background:#1c6b3c;
color:#fff;
font-weight:600;
}

.us-vs-them-table tbody tr:last-child td{
border-bottom:none;
}

.comparison-image img{
width:100%;
border-radius:12px;
}

@media(max-width:900px){

.us-vs-them-wrapper{
grid-template-columns:1fr;
gap:40px;
}

.us-vs-them-left h2{
font-size:30px;
}

}

</style>

{% schema %}
{
"name": "Us vs Them",
"settings":[

{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Us vs. Them"
},

{
"type":"textarea",
"id":"description",
"label":"Description",
"default":"Not overhyped or overpriced. Just comprehensive nutrition made enjoyable and for everyone."
},

{
"type":"text",
"id":"brand_title",
"label":"Brand Column Title",
"default":"grüns"
},

{
"type":"text",
"id":"col_two",
"label":"Column Two Title",
"default":"Generic Multivitamin"
},

{
"type":"text",
"id":"col_three",
"label":"Column Three Title",
"default":"Overpriced Green Powder"
},

{
"type":"image_picker",
"id":"table_image",
"label":"Fallback Image (show if no table rows)"
}

],

"blocks":[

{
"type":"row",
"name":"Table Row",
"settings":[

{
"type":"text",
"id":"feature",
"label":"Feature",
"default":"Cost Per Serving"
},

{
"type":"text",
"id":"brand_value",
"label":"Brand Value",
"default":"$1.47"
},

{
"type":"text",
"id":"col_two_value",
"label":"Column Two Value",
"default":"🤔"
},

{
"type":"text",
"id":"col_three_value",
"label":"Column Three Value",
"default":"$3.60"
}

]
}

],

"presets":[
{
"name":"Us vs Them Comparison"
}
]
}
{% endschema %}