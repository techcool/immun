{% schema %}
{
  "name": "Press Slider Center",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f3f4f2"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Slider Center"
    }
  ]
}
{% endschema %}

<section class="press-slider-center" style="background: {{ section.settings.bg_color }};">
  <div class="press-wrapper">

    {% if section.blocks.size > 3 %}
      <button class="nav prev">&#8592;</button>
    {% endif %}

    <div class="slider">
      <div class="slides">
        {% for block in section.blocks %}
        <div class="slide" {{ block.shopify_attributes }}>
          
          {% if block.settings.quote != blank %}
            <p class="quote">"{{ block.settings.quote }}"</p>
          {% endif %}

          {% if block.settings.logo != blank %}
            <div class="logo">
              <img src="{{ block.settings.logo | image_url: width: 600 }}" alt="logo">
            </div>
          {% endif %}

        </div>
        {% endfor %}
      </div>
    </div>

    {% if section.blocks.size > 3 %}
      <button class="nav next">&#8594;</button>
    {% endif %}

  </div>
</section>

<style>
.press-slider-center {
  padding: 100px 20px;
  overflow: hidden;
  text-align: center;
}

.press-wrapper {
  max-width: 1200px;
  margin: auto;
  display: flex;
  align-items: center;
  position: relative;
}

.slider {
  overflow: hidden;
  width: 100%;
}

.slides {
  display: flex;
  transition: transform 0.6s ease;
}

.slide {
  flex: 0 0 33.333%;
  padding: 0 20px;
  opacity: 0.4;
  transform: scale(0.85);
  transition: all 0.4s ease;
}

.slide.active {
  opacity: 1;
  transform: scale(1);
}

.quote {
  font-size: 18px;
  line-height: 1.6;
  color: #1f3d2b;
  margin-bottom: 25px;
}

.logo img {
  max-height: 60px;
  object-fit: contain;
}

/* Arrows */
.nav {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 2px solid #1f3d2b;
  background: transparent;
  color: #1f3d2b;
  cursor: pointer;
  font-size: 18px;
  transition: 0.3s;
}

.nav:hover {
  background: #1f3d2b;
  color: #fff;
}

.prev {
  margin-right: 15px;
}

.next {
  margin-left: 15px;
}

/* Mobile */
@media (max-width: 768px) {
  .slide {
    flex: 0 0 100%;
    opacity: 1;
    transform: scale(1);
  }

  .nav {
    display: none;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const section = document.querySelector(".press-slider-center");
  if (!section) return;

  const slidesContainer = section.querySelector(".slides");
  const slides = section.querySelectorAll(".slide");
  const prev = section.querySelector(".prev");
  const next = section.querySelector(".next");

  const total = slides.length;
  let current = total > 2 ? 1 : 0;

  const autoplay = {{ section.settings.autoplay }};
  const speed = {{ section.settings.autoplay_speed }} * 1000;
  let interval;

  function updateSlider() {
    slides.forEach(slide => slide.classList.remove("active"));

    if (slides[current]) {
      slides[current].classList.add("active");
    }

    if (total > 3) {
      const offset = (current - 1) * (100 / 3);
      slidesContainer.style.transform = `translateX(-${offset}%)`;
    }
  }

  function nextSlide() {
    if (current < total - 2) {
      current++;
    } else {
      current = 1;
    }
    updateSlider();
  }

  function prevSlideFunc() {
    if (current > 1) {
      current--;
    } else {
      current = total - 2;
    }
    updateSlider();
  }

  if (next) next.addEventListener("click", nextSlide);
  if (prev) prev.addEventListener("click", prevSlideFunc);

  updateSlider();

  if (autoplay && total > 3) {
    interval = setInterval(nextSlide, speed);

    section.addEventListener("mouseenter", () => clearInterval(interval));
    section.addEventListener("mouseleave", () => {
      interval = setInterval(nextSlide, speed);
    });
  }

});
</script>