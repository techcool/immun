{% schema %}
{
  "name": "Press Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f3f4f2"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Slider"
    }
  ]
}
{% endschema %}

<section class="press-slider" style="background: {{ section.settings.bg_color }};">
  <div class="press-container">

    {% if section.blocks.size > 1 %}
      <button class="nav prev" aria-label="Previous slide">
        &#8592;
      </button>
    {% endif %}

    <div class="slides">
      {% for block in section.blocks %}
        <div class="slide" {{ block.shopify_attributes }}>
          
          {% if block.settings.quote != blank %}
            <p class="quote">"{{ block.settings.quote }}"</p>
          {% endif %}
          
          {% if block.settings.logo != blank %}
            <div class="logo">
              <img 
                src="{{ block.settings.logo | image_url: width: 600 }}" 
                alt="Press logo"
                loading="lazy"
              >
            </div>
          {% endif %}

        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <button class="nav next" aria-label="Next slide">
        &#8594;
      </button>

      <div class="dots">
        {% for block in section.blocks %}
          <span class="dot" data-index="{{ forloop.index0 }}"></span>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
.press-slider {
  padding: 100px 20px;
  position: relative;
  text-align: center;
}

.press-container {
  max-width: 1100px;
  margin: auto;
  position: relative;
}

.slides {
  position: relative;
  overflow: hidden;
  min-height: 200px;
}

.slide {
  display: none;
  animation: fade 0.5s ease;
}

.slide.active {
  display: block;
}

.quote {
  font-size: 20px;
  line-height: 1.6;
  color: #1f3d2b;
  max-width: 700px;
  margin: 0 auto 40px;
}

.logo img {
  max-height: 60px;
  width: auto;
  object-fit: contain;
  margin: 0 auto;
}

/* Navigation Arrows */
.nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 2px solid #1f3d2b;
  background: transparent;
  color: #1f3d2b;
  cursor: pointer;
  font-size: 18px;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav:hover {
  background: #1f3d2b;
  color: #ffffff;
}

.prev {
  left: 0;
}

.next {
  right: 0;
}

/* Dots */
.dots {
  margin-top: 40px;
}

.dot {
  height: 8px;
  width: 8px;
  background: #cfd8d3;
  border-radius: 50%;
  display: inline-block;
  margin: 0 6px;
  cursor: pointer;
  transition: background 0.3s ease;
}

.dot.active {
  background: #1f3d2b;
}

/* Mobile */
@media (max-width: 768px) {
  .press-slider {
    padding: 70px 20px;
  }

  .quote {
    font-size: 16px;
  }

  .nav {
    width: 38px;
    height: 38px;
    font-size: 14px;
  }
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const section = document.querySelector(".press-slider");
  if (!section) return;

  const slides = section.querySelectorAll(".slide");
  const dots = section.querySelectorAll(".dot");
  const prev = section.querySelector(".prev");
  const next = section.querySelector(".next");

  let current = 0;
  const autoplay = {{ section.settings.autoplay }};
  const speed = {{ section.settings.autoplay_speed }} * 1000;
  let interval;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      slide.classList.remove("active");
      if (dots[i]) dots[i].classList.remove("active");
    });

    slides[index].classList.add("active");
    if (dots[index]) dots[index].classList.add("active");

    current = index;
  }

  function nextSlide() {
    showSlide((current + 1) % slides.length);
  }

  function prevSlideFunc() {
    showSlide((current - 1 + slides.length) % slides.length);
  }

  if (next) next.addEventListener("click", nextSlide);
  if (prev) prev.addEventListener("click", prevSlideFunc);

  dots.forEach(dot => {
    dot.addEventListener("click", function () {
      showSlide(parseInt(this.dataset.index));
    });
  });

  if (slides.length > 0) {
    showSlide(0);
  }

  if (autoplay && slides.length > 1) {
    interval = setInterval(nextSlide, speed);

    section.addEventListener("mouseenter", () => clearInterval(interval));
    section.addEventListener("mouseleave", () => {
      interval = setInterval(nextSlide, speed);
    });
  }

});
</script>