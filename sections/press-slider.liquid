{% schema %}
{
  "name": "Press Slider Center",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f3f4f2"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "textarea", "id": "quote", "label": "Quote" }
      ]
    }
  ],
  "presets": [
    { "name": "Press Slider Center" }
  ]
}
{% endschema %}

<section class="press-slider-center" style="background: {{ section.settings.bg_color }};">
  <div class="container">

    {% if section.blocks.size > 1 %}
      <button class="nav prev">&#8592;</button>
    {% endif %}

    <div class="slider">
      <div class="slides">
        {% for block in section.blocks %}
          <div class="slide" {{ block.shopify_attributes }}>
            {% if block.settings.quote != blank %}
              <p class="quote">"{{ block.settings.quote }}"</p>
            {% endif %}
            {% if block.settings.logo != blank %}
              <div class="logo">
                <img src="{{ block.settings.logo | image_url: width: 600 }}" alt="logo">
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.blocks.size > 1 %}
      <button class="nav next">&#8594;</button>
    {% endif %}

  </div>
</section>

<style>
.press-slider-center {
  padding: 100px 20px;
  overflow: hidden;
  text-align: center;
}

.container {
  max-width: 1200px;
  margin: auto;
  display: flex;
  align-items: center;
}

.slider {
  overflow: hidden;
  width: 100%;
}

.slides {
  display: flex;
  transition: transform 0.6s ease;
}

.slide {
  flex: 0 0 33.3333%;
  padding: 0 20px;
  opacity: 0.4;
  transform: scale(0.85);
  transition: all 0.4s ease;
}

.slide.active {
  opacity: 1;
  transform: scale(1);
}

.quote {
  font-size: 18px;
  line-height: 1.6;
  color: #1f3d2b;
  margin-bottom: 25px;
}

.logo img {
  max-height: 60px;
}

/* Arrows */
.nav {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 2px solid #1f3d2b;
  background: transparent;
  color: #1f3d2b;
  cursor: pointer;
  font-size: 18px;
  margin: 0 15px;
  transition: 0.3s;
}

.nav:hover {
  background: #1f3d2b;
  color: #fff;
}

/* Mobile */
@media (max-width: 768px) {
  .slide {
    flex: 0 0 100%;
    opacity: 1;
    transform: scale(1);
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  const slider = document.querySelector(".press-slider-center");
  if (!slider) return;

  const slidesContainer = slider.querySelector(".slides");
  const slides = slider.querySelectorAll(".slide");
  const prevBtn = slider.querySelector(".prev");
  const nextBtn = slider.querySelector(".next");

  const total = slides.length;
  if (total < 3) return; // minimum 3 for center mode

  let current = 0;
  const autoplay = {{ section.settings.autoplay }};
  const speed = {{ section.settings.autoplay_speed }} * 1000;
  let interval;

  function updateSlider() {

    slides.forEach(slide => slide.classList.remove("active"));

    let centerIndex = (current + 1) % total;
    slides[centerIndex].classList.add("active");

    const slideWidth = slides[0].offsetWidth;
    slidesContainer.style.transform =
      `translateX(-${current * slideWidth}px)`;
  }

  function nextSlide() {
    current = (current + 1) % total;
    updateSlider();
  }

  function prevSlide() {
    current = (current - 1 + total) % total;
    updateSlider();
  }

  if (nextBtn) nextBtn.addEventListener("click", nextSlide);
  if (prevBtn) prevBtn.addEventListener("click", prevSlide);

  updateSlider();

  if (autoplay) {
    interval = setInterval(nextSlide, speed);

    slider.addEventListener("mouseenter", () => clearInterval(interval));
    slider.addEventListener("mouseleave", () => {
      interval = setInterval(nextSlide, speed);
    });
  }

  window.addEventListener("resize", updateSlider);

});
</script>