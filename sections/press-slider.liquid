{% schema %}
{
  "name": "Press Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f5f5f5"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Slider"
    }
  ]
}
{% endschema %}

<section class="press-slider" style="background: {{ section.settings.bg_color }};">
  <div class="press-wrapper">

    <div class="slides">
      {% for block in section.blocks %}
        <div class="slide" {{ block.shopify_attributes }}>
          {% if block.settings.quote != blank %}
            <p class="quote">{{ block.settings.quote }}</p>
          {% endif %}
          
          {% if block.settings.logo != blank %}
            <div class="logo">
              <img 
                src="{{ block.settings.logo | image_url: width: 400 }}" 
                alt="logo"
                loading="lazy"
              >
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <button class="nav prev">&#8592;</button>
      <button class="nav next">&#8594;</button>

      <div class="dots">
        {% for block in section.blocks %}
          <span class="dot" data-index="{{ forloop.index0 }}"></span>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<style>
.press-slider {
  padding: 80px 20px;
  text-align: center;
  position: relative;
}

.press-wrapper {
  max-width: 900px;
  margin: auto;
  position: relative;
}

.slides {
  position: relative;
  overflow: hidden;
}

.slide {
  display: none;
  animation: fade 0.4s ease-in-out;
}

.slide.active {
  display: block;
}

.quote {
  font-size: 18px;
  margin-bottom: 30px;
  color: #1f3d2b;
  line-height: 1.6;
}

.logo img {
  max-height: 60px;
  object-fit: contain;
}

.nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: #ffffff;
  border: 1px solid #1f3d2b;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 18px;
}

.prev { left: -60px; }
.next { right: -60px; }

.dots {
  margin-top: 30px;
}

.dot {
  height: 8px;
  width: 8px;
  background: #ccc;
  border-radius: 50%;
  display: inline-block;
  margin: 0 5px;
  cursor: pointer;
}

.dot.active {
  background: #1f3d2b;
}

@media(max-width: 768px) {
  .prev { left: 10px; }
  .next { right: 10px; }
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const section = document.querySelector(".press-slider");
  if (!section) return;

  const slides = section.querySelectorAll(".slide");
  const dots = section.querySelectorAll(".dot");
  const prev = section.querySelector(".prev");
  const next = section.querySelector(".next");

  let current = 0;
  const autoplay = {{ section.settings.autoplay }};
  const speed = {{ section.settings.autoplay_speed }} * 1000;
  let interval;

  function showSlide(index) {
    slides.forEach((slide, i) => {
      slide.classList.remove("active");
      if (dots[i]) dots[i].classList.remove("active");
    });

    slides[index].classList.add("active");
    if (dots[index]) dots[index].classList.add("active");

    current = index;
  }

  function nextSlide() {
    let newIndex = (current + 1) % slides.length;
    showSlide(newIndex);
  }

  function prevSlideFunc() {
    let newIndex = (current - 1 + slides.length) % slides.length;
    showSlide(newIndex);
  }

  if (next) next.addEventListener("click", nextSlide);
  if (prev) prev.addEventListener("click", prevSlideFunc);

  dots.forEach(dot => {
    dot.addEventListener("click", function () {
      showSlide(parseInt(this.dataset.index));
    });
  });

  if (slides.length > 0) {
    showSlide(0);
  }

  if (autoplay && slides.length > 1) {
    interval = setInterval(nextSlide, speed);
  }
});
</script>