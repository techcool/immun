<style>
/* ═══════════════════════════════════════════════════════════════
   gruns-product-section.css  –  assets/gruns-product-section.css
═══════════════════════════════════════════════════════════════ */

:root {
  --g-green-dark:  #1a4a2e;
  --g-green-mid:   #2d6a45;
  --g-green-light: #3d8f5f;
  --g-gold:        #e8a020;
  --g-gold-light:  #f5c842;
  --g-cream:       #faf7f0;
  --g-bg:          #f0f4f0;
  --g-text:        #1c2b1e;
  --g-muted:       #5a7060;
  --g-border:      #d4e0d8;
  --g-red:         #c0392b;
  --g-star:        #f5a623;
  --g-radius:      12px;
  --g-shadow:      0 4px 24px rgba(30,60,40,.10);
}

.gruns-full-width .page-width { max-width: 100% !important; padding-left: 0; padding-right: 0; }
.gruns-product-section .page-width { margin: 0 auto; color: var(--g-text); }

.gruns-page-headline {
  text-align: center; font-family: 'Playfair Display', serif;
  font-size: clamp(1.4rem, 3.5vw, 2.2rem);
  color: var(--g-green-dark); font-weight: 700; line-height: 1.3; margin-bottom: 20px;
}
.gruns-page-headline span { color: var(--g-gold); }
.gruns-badge-wrap { text-align: center; margin-bottom: 24px; }
.gruns-badge {
  display: inline-block; background: var(--g-gold); color: #fff;
  font-size: .78rem; font-weight: 800; letter-spacing: .06em;
  text-transform: uppercase; padding: 6px 18px; border-radius: 30px;
}

.gruns-product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
@media (max-width: 860px) { .gruns-product-grid { grid-template-columns: 1fr; gap: 28px; } }

.gruns-gallery { display: flex; gap: 12px; }
.gruns-thumbs { display: flex; flex-direction: column; gap: 8px; flex-shrink: 0; }
.gruns-thumb {
  width: 62px; height: 62px; border-radius: 8px; border: 2px solid transparent;
  overflow: hidden; cursor: pointer; background: var(--g-cream);
  display: flex; align-items: center; justify-content: center; padding: 0;
  transition: border-color .2s, box-shadow .2s;
}
.gruns-thumb.active, .gruns-thumb:hover { border-color: var(--g-green-mid); box-shadow: 0 2px 8px rgba(30,60,40,.15); }
.gruns-thumb img, .gruns-thumb svg { width: 100%; height: 100%; object-fit: cover; display: block; }
.gruns-main-image-wrap {
  flex: 1; border-radius: var(--g-radius); overflow: hidden;
  background: linear-gradient(145deg, #d6ead9 0%, #b8d9bf 100%);
  position: relative; min-height: 340px;
}
.gruns-offer-ribbon {
  position: absolute; top: 0; left: 0; right: 0;
  background: var(--g-green-dark); color: var(--g-gold);
  font-size: .75rem; font-weight: 900; letter-spacing: .08em;
  text-align: center; padding: 8px 12px; text-transform: uppercase; z-index: 2;
}
.gruns-main-image-inner { width: 100%; height: 100%; min-height: 340px; position: relative; }
.gruns-slide { display: none; width: 100%; height: 100%; }
.gruns-slide.active { display: block; }
.gruns-product-img, .gruns-slide svg { width: 100%; height: 100%; object-fit: cover; display: block; }
.gruns-nutrition-btn {
  display: block; width: 100%; margin-top: 12px; padding: 12px;
  background: transparent; border: 2px solid var(--g-green-dark); border-radius: 8px;
  font-weight: 700; font-size: .88rem;
  color: var(--g-green-dark); cursor: pointer; text-align: center;
  text-decoration: none; transition: background .2s, color .2s;
}
.gruns-nutrition-btn:hover { background: var(--g-green-dark); color: #fff; }
.gruns-tested-badge {
  margin-top: 12px; background: var(--g-cream); border: 1px solid var(--g-border);
  border-radius: 8px; padding: 10px 14px; display: flex; align-items: flex-start;
  gap: 10px; font-size: .78rem; color: var(--g-muted); line-height: 1.5;
}
.gruns-tested-icon { font-size: 1.1rem; flex-shrink: 0; display: flex; align-items: center; }
.gruns-tested-img { width: 28px; height: 28px; object-fit: contain; display: block; }
.gruns-tested-badge strong { color: var(--g-green-dark); }

.gruns-details-col { display: flex; flex-direction: column; gap: 16px; }
.gruns-stars-row { display: flex; align-items: center; gap: 6px; font-size: .82rem; color: var(--g-muted); flex-wrap: wrap; }
.gruns-stars { color: var(--g-star); font-size: 1rem; }
.gruns-stars-row strong { color: var(--g-text); }
.gruns-product-title {
