<style>
    /* ═══════════════════════════════════════════════════════════════
   gruns-product-section.css
   Drop in: assets/gruns-product-section.css
   ═══════════════════════════════════════════════════════════════ */

/* ── TOKENS ──────────────────────────────────────────────────── */
:root {
  --g-green-dark:  #1a4a2e;
  --g-green-mid:   #2d6a45;
  --g-green-light: #3d8f5f;
  --g-gold:        #e8a020;
  --g-gold-light:  #f5c842;
  --g-cream:       #faf7f0;
  --g-bg:          #f0f4f0;
  --g-text:        #1c2b1e;
  --g-muted:       #5a7060;
  --g-border:      #d4e0d8;
  --g-red:         #c0392b;
  --g-star:        #f5a623;
  --g-radius:      12px;
  --g-shadow:      0 4px 24px rgba(30,60,40,.10);
}

/* ── SECTION ─────────────────────────────────────────────────── */
.gruns-product-section .page-width{
  margin: 0 auto;
  color: var(--g-text);
}

/* ── HEADLINE ────────────────────────────────────────────────── */
.gruns-page-headline {
  text-align: center;
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.4rem, 3.5vw, 2.2rem);
  color: var(--g-green-dark);
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 20px;
}
.gruns-page-headline span { color: var(--g-gold); }

/* ── BADGE ───────────────────────────────────────────────────── */
.gruns-badge-wrap { text-align: center; margin-bottom: 24px; }
.gruns-badge {
  display: inline-block;
  background: var(--g-gold);
  color: #fff;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 6px 18px;
  border-radius: 30px;
}

/* ── PRODUCT GRID ─────────────────────────────────────────────── */
.gruns-product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: start;
}
@media (max-width: 860px) {
  .gruns-product-grid { grid-template-columns: 1fr; gap: 28px; }
}

/* ── GALLERY ─────────────────────────────────────────────────── */
.gruns-gallery { display: flex; gap: 12px; }

.gruns-thumbs {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
}
.gruns-thumb {
  width: 62px;
  height: 62px;
  border-radius: 8px;
  border: 2px solid transparent;
  overflow: hidden;
  cursor: pointer;
  background: var(--g-cream);
  display: flex; align-items: center; justify-content: center;
  padding: 0;
  transition: border-color .2s, box-shadow .2s;
}
.gruns-thumb.active,
.gruns-thumb:hover  { border-color: var(--g-green-mid); box-shadow: 0 2px 8px rgba(30,60,40,.15); }
.gruns-thumb img,
.gruns-thumb svg    { width: 100%; height: 100%; object-fit: cover; display: block; }

.gruns-main-image-wrap {
  flex: 1;
  border-radius: var(--g-radius);
  overflow: hidden;
  background: linear-gradient(145deg, #d6ead9 0%, #b8d9bf 100%);
  position: relative;
  min-height: 340px;
}
.gruns-offer-ribbon {
  position: absolute;
  top: 0; left: 0; right: 0;
  background: var(--g-green-dark);
  color: var(--g-gold);
  font-size: .75rem;
  font-weight: 900;
  letter-spacing: .08em;
  text-align: center;
  padding: 8px 12px;
  text-transform: uppercase;
  z-index: 2;
}
.gruns-main-image-inner {
  width: 100%;
  height: 100%;
  min-height: 340px;
  position: relative;
}
.gruns-slide { display: none; width: 100%; height: 100%; }
.gruns-slide.active { display: block; }
.gruns-product-img,
.gruns-slide svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── NUTRITION / TESTED ───────────────────────────────────────── */
.gruns-nutrition-btn {
  display: block;
  width: 100%;
  margin-top: 12px;
  padding: 12px;
  background: transparent;
  border: 2px solid var(--g-green-dark);
  border-radius: 8px;
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  font-size: .88rem;
  color: var(--g-green-dark);
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  transition: background .2s, color .2s;
}
.gruns-nutrition-btn:hover { background: var(--g-green-dark); color: #fff; }

.gruns-tested-badge {
  margin-top: 12px;
  background: var(--g-cream);
  border: 1px solid var(--g-border);
  border-radius: 8px;
  padding: 10px 14px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: .78rem;
  color: var(--g-muted);
  line-height: 1.5;
}
.gruns-tested-icon { font-size: 1.1rem; flex-shrink: 0; }
.gruns-tested-badge strong { color: var(--g-green-dark); }
.gruns-tested-badge a { color: var(--g-green-mid); font-weight: 700; }

/* ── DETAILS COL ─────────────────────────────────────────────── */
.gruns-details-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ── STARS ───────────────────────────────────────────────────── */
.gruns-stars-row { display: flex; align-items: center; gap: 6px; font-size: .82rem; color: var(--g-muted); flex-wrap: wrap; }
.gruns-stars { color: var(--g-star); font-size: 1rem; }
.gruns-stars-row strong { color: var(--g-text); }

/* ── TITLE ───────────────────────────────────────────────────── */
.gruns-product-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.5rem, 3vw, 2rem);
  color: var(--g-green-dark);
  font-weight: 700;
  line-height: 1.2;
  margin: 0;
}
.gruns-product-tagline { font-size: .9rem; color: var(--g-muted); line-height: 1.6; }

/* ── FEATURE LIST ────────────────────────────────────────────── */
.gruns-feature-list, .features-list { list-style: none; display: flex; flex-direction: column; gap: 5px; padding: 0; margin: 0; }
.gruns-feature-list li, .features-list li {
  font-size: .85rem;
  color: var(--g-text);
  display: flex;
  align-items: flex-start;
  gap: 7px;
}
.gruns-feature-list li::before, .features-list li::before { content: '✓'; color: var(--g-green-mid); font-weight: 900; flex-shrink: 0; margin-top: 1px; }

/* ── DIVIDER ─────────────────────────────────────────────────── */
.gruns-divider { border: none; border-top: 1px solid var(--g-border); margin: 0; }

/* ── OPTIONS ─────────────────────────────────────────────────── */
.gruns-option-group { display: flex; flex-direction: column; gap: 8px; }
.gruns-option-label { font-weight: 800; font-size: .88rem; color: var(--g-text); }
.gruns-toggle-group { display: flex; gap: 8px; flex-wrap: wrap; }
.gruns-toggle-btn {
  padding: 9px 22px;
  border-radius: 8px;
  border: 2px solid var(--g-border);
  background: #fff;
  font-family: 'Nunito', sans-serif;
  font-size: .85rem;
  font-weight: 700;
  color: var(--g-muted);
  cursor: pointer;
  transition: border-color .2s, color .2s, background .2s;
}
.gruns-toggle-btn.active,
.gruns-toggle-btn[aria-pressed="true"] {
  border-color: var(--g-green-dark);
  color: var(--g-green-dark);
  background: #e8f4ec;
}

/* ── ADULTS ──────────────────────────────────────────────────── */
.gruns-adults-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.gruns-save-pill {
  background: #fff8e1;
  color: var(--g-gold);
  font-size: .7rem;
  font-weight: 800;
  border-radius: 20px;
  padding: 3px 10px;
  border: 1px solid var(--g-gold-light);
}
.gruns-qty-toggle {
  display: flex;
  border-radius: 10px;
  overflow: hidden;
  border: 2px solid var(--g-border);
  width: 100%;
  max-width: 260px;
}
.gruns-qty-btn {
  flex: 1;
  padding: 11px 0;
  font-family: 'Nunito', sans-serif;
  font-size: .88rem;
  font-weight: 800;
  color: var(--g-muted);
  background: #fff;
  border: none;
  cursor: pointer;
  transition: background .2s, color .2s;
}
.gruns-qty-btn.active,
.gruns-qty-btn[aria-pressed="true"] { background: var(--g-green-dark); color: #fff; }

/* ── AUTOSHIP LABEL ──────────────────────────────────────────── */
.gruns-autoship-label { font-weight: 800; font-size: .88rem; color: var(--g-text); }

/* ── PURCHASE CARDS ──────────────────────────────────────────── */
.gruns-purchase-card {
  border: 2px solid var(--g-border);
  border-radius: var(--g-radius);
  padding: 14px 16px;
  background: #fff;
  cursor: pointer;
  transition: border-color .2s, background .2s;
  position: relative;
  user-select: none;
}
.gruns-purchase-card.active {
  border-color: var(--g-green-dark);
  background: #f0f7f2;
}
.gruns-popular-tag {
  position: absolute;
  top: -1px; left: 50%; transform: translateX(-50%);
  background: var(--g-green-dark);
  color: #fff;
  font-size: .65rem;
  font-weight: 900;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 3px 14px;
  border-radius: 0 0 8px 8px;
  white-space: nowrap;
}
.gruns-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 4px;
}
.gruns-card-title-row { display: flex; align-items: center; gap: 8px; }
.gruns-radio-dot {
  width: 16px; height: 16px;
  border-radius: 50%;
  border: 2px solid var(--g-border);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: border-color .2s;
}
.gruns-radio-dot.active { border-color: var(--g-green-dark); }
.gruns-radio-dot.active::after {
  content: ''; width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--g-green-dark);
}
.gruns-card-title { font-weight: 800; font-size: .9rem; color: var(--g-text); }
.gruns-card-price { text-align: right; }
.gruns-price-main { font-size: 1.15rem; font-weight: 900; color: var(--g-green-dark); }
.gruns-price-freq { font-size: .75rem; font-weight: 700; }
.gruns-price-sub { font-size: .7rem; color: var(--g-muted); display: block; margin-top: 1px; }
.gruns-price-old { text-decoration: line-through; color: var(--g-red); }
.gruns-card-desc { font-size: .75rem; color: var(--g-muted); margin-left: 24px; margin-bottom: 6px; }
.gruns-card-perks { margin-left: 24px; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 3px; }
.gruns-card-perks li {
  font-size: .75rem;
  color: var(--g-green-mid);
  display: flex; gap: 5px;
}
.gruns-card-perks li::before { content: '✓'; font-weight: 900; }

/* ── PRODUCT FORM ────────────────────────────────────────────── */
.gruns-product-form { margin: 0; }

/* ── CTA BUTTON ──────────────────────────────────────────────── */
.gruns-cta-btn {
  display: block;
  width: 100%;
  padding: 16px;
  background: var(--g-green-dark);
  color: #fff;
  font-family: 'Nunito', sans-serif;
  font-size: 1.05rem;
  font-weight: 900;
  border: none;
  border-radius: var(--g-radius);
  cursor: pointer;
  letter-spacing: .03em;
  transition: background .2s, transform .1s, box-shadow .2s;
  box-shadow: 0 4px 16px rgba(30,70,45,.25);
  text-align: center;
  margin-top: 4px;
}
.gruns-cta-btn:hover:not(:disabled) { background: var(--g-green-mid); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(30,70,45,.3); }
.gruns-cta-btn:active:not(:disabled) { transform: translateY(0); }
.gruns-cta-btn:disabled { background: #aaa; cursor: not-allowed; box-shadow: none; }

/* ── DISCOUNT PILL ───────────────────────────────────────────── */
.gruns-discount-pill {
  background: #fffbe6;
  border: 1px solid var(--g-gold-light);
  border-radius: 6px;
  text-align: center;
  padding: 8px;
  font-size: .78rem;
  font-weight: 700;
  color: var(--g-gold);
}

/* ── TRUST ICONS ─────────────────────────────────────────────── */
.gruns-trust-row {
  display: flex;
  gap: 8px;
  justify-content: space-between;
  flex-wrap: wrap;
}
.gruns-trust-item {
  flex: 1;
  min-width: 80px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.gruns-trust-icon { font-size: 1.4rem; color: var(--g-green-mid); }
.gruns-trust-text { font-size: .7rem; color: var(--g-muted); font-weight: 700; line-height: 1.3; }

/* ── ACCORDION ───────────────────────────────────────────────── */
.gruns-accordion { display: flex; flex-direction: column; }
.gruns-acc-item { border-top: 1px solid var(--g-border); }
.gruns-acc-item:last-child { border-bottom: 1px solid var(--g-border); }
.gruns-acc-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  background: transparent;
  border: none;
  font-family: 'Nunito', sans-serif;
  font-size: .95rem;
  font-weight: 800;
  color: var(--g-text);
  cursor: pointer;
  text-align: left;
  gap: 8px;
}
.gruns-acc-icon { font-size: 1.2rem; color: var(--g-green-dark); transition: transform .25s; flex-shrink: 0; }
