}
.gruns-perk-icon { font-size: .9rem; flex-shrink: 0; display: flex; align-items: center; }
.gruns-perk-icon--check::before { content: '✓'; font-weight: 900; color: var(--g-green-mid); }
.gruns-perk-icon--cross::before { content: '✗'; font-weight: 900; color: var(--g-red); }
.gruns-card-perks--negative li { color: var(--g-muted); }
.gruns-perk-icon--img img { width: 18px; height: 18px; object-fit: contain; display: block; }

/* ── CTA ── */
.gruns-product-form { margin: 0; }
.gruns-cta-btn {
  display: block; width: 100%; padding: 16px;
  background: var(--g-green-dark); color: #fff;
  font-size: 1.05rem; font-weight: 900;
  border: none; border-radius: var(--g-radius); cursor: pointer; letter-spacing: .03em;
  transition: background .2s, transform .1s, box-shadow .2s;
  box-shadow: 0 4px 16px rgba(30,70,45,.25); text-align: center; margin-top: 4px;
}
.gruns-cta-btn:hover:not(:disabled) { background: var(--g-green-mid); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(30,70,45,.3); }
