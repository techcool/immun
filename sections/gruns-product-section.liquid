.gruns-trust-text { font-size: 14px; color: var(--dk-green); font-weight: 500; line-height: 1.3; }

/* ── Accordion ── */
.gruns-accordion { display: flex; flex-direction: column; }
.gruns-acc-item { border-top: 1px solid var(--g-border); }
.gruns-acc-item:last-child { border-bottom: 1px solid var(--g-border); }
.gruns-acc-header {
  width: 100%; display: flex; align-items: center;
  padding: 14px 0; background: transparent; border: none;
  font-size: 24px; font-weight: 600;
  color: var(--dk-green); cursor: pointer; text-align: left; gap: 10px;
}
.gruns-acc-header-icon { font-size: 1.1rem; flex-shrink: 0; }
.gruns-acc-header-icon--img { display: flex; align-items: center; flex-shrink: 0; }
.gruns-acc-header-icon--img img { width: 24px; height: 24px; object-fit: contain; display: block; }
.gruns-acc-header-title { flex: 1; }
.gruns-acc-icon { font-size: 1.2rem; color: var(--g-green-dark); transition: transform .25s; flex-shrink: 0; margin-left: auto; }
.gruns-acc-header[aria-expanded="true"] .gruns-acc-icon { transform: rotate(45deg); }
.gruns-acc-body { max-height: 0; overflow: hidden; transition: max-height .35s ease; }
.gruns-acc-body.open { max-height: 900px; }
.gruns-acc-body-inner { font-size: .85rem; color: var(--g-muted); line-height: 1.7; padding-bottom: 14px; }
.gruns-acc-body-inner p { margin: 0 0 8px; }
.gruns-acc-body-inner p:last-child { margin-bottom: 0; }
.gruns-acc-body-inner.gruns-acc-has-image { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
.gruns-acc-image-wrap {
