{% comment %}
  ╔══════════════════════════════════════════════════════════════╗
  ║  Grüns Superfood Gummies – Custom Product Section           ║
  ║  File: sections/gruns-product-section.liquid                ║
  ╚══════════════════════════════════════════════════════════════╝
{% endcomment %}

{% assign product = all_products[section.settings.product] | default: product %}

{{ 'gruns-product-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #gruns-product-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 750px) {
    #gruns-product-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | divided_by: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign custom_classes = section.settings.custom_classes | strip
-%}

<section
  class="gruns-product-section common-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} gruns-full-width{% endif %}{% if custom_classes != blank %} {{ custom_classes }}{% endif %}"
  id="gruns-product-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="gruns-product"
>
<div class="page-width product-container">

  {% if section.settings.page_headline != blank %}
  <h2 class="gruns-page-headline">
    {{ section.settings.page_headline }}
  </h2>
  {% endif %}

  {% if section.settings.badge_text != blank %}
  <div class="gruns-badge-wrap">
    <span class="gruns-badge">{{ section.settings.badge_text }}</span>
  </div>
  {% endif %}

  <div class="gruns-product-grid">

    <!-- LEFT: GALLERY -->
    <div class="gruns-gallery-col">
      <div class="gruns-gallery">

        <div class="gruns-thumbs" role="list">
          {% if product.images.size > 0 %}
            {% for image in product.images limit: 6 %}
            <button
              class="gruns-thumb{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="View image {{ forloop.index }}"
              role="listitem"
            >
              {{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}
            </button>
            {% endfor %}
          {% else %}
            {% for i in (1..6) %}
            <button class="gruns-thumb{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" role="listitem">
              {{ 'product-' | append: i | placeholder_svg_tag: 'gruns-thumb-svg' }}
            </button>
            {% endfor %}
          {% endif %}
        </div>

        <div class="gruns-main-image-wrap">
          {% if section.settings.show_offer_ribbon %}
          <div class="gruns-offer-ribbon" aria-label="{{ section.settings.offer_ribbon_text }}">
            {{ section.settings.offer_ribbon_icon }} {{ section.settings.offer_ribbon_text }} {{ section.settings.offer_ribbon_icon }}
          </div>
          {% endif %}

          <div class="gruns-main-image-inner" id="gruns-main-image-{{ section.id }}">
            {% if product.images.size > 0 %}
              {% for image in product.images limit: 6 %}
              <div class="gruns-slide{% if forloop.first %} active{% endif %}" data-slide="{{ forloop.index0 }}">
                {{ image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    alt: image.alt | default: product.title,
                    class: 'gruns-product-img'
                }}
              </div>
              {% endfor %}
            {% else %}
              <div class="gruns-slide active" data-slide="0">
                {{ 'product-1' | placeholder_svg_tag: 'gruns-product-img' }}
              </div>
            {% endif %}
          </div>
        </div>

      </div>

      {% if section.settings.nutrition_label_url != blank %}
      <a href="{{ section.settings.nutrition_label_url }}" class="gruns-nutrition-btn" target="_blank" rel="noopener">
        {{ section.settings.nutrition_label_text }}
      </a>
      {% endif %}

      {% if section.settings.tested_text != blank %}
      <div class="gruns-tested-badge">
        <span class="gruns-tested-icon" aria-hidden="true">
          {% if section.settings.tested_icon_image != blank %}
            {{ section.settings.tested_icon_image | image_url: width: 48 | image_tag: loading: 'lazy', alt: '', class: 'gruns-tested-img' }}
          {% else %}
            {{ section.settings.tested_icon }}
          {% endif %}
        </span>
        <div>{{ section.settings.tested_text }}</div>
      </div>
      {% endif %}

    </div>


    <!-- RIGHT: PRODUCT DETAILS -->
    <div class="gruns-details-col">

      {% if section.settings.show_reviews %}
      <div class="gruns-stars-row">
        <span class="gruns-stars" aria-label="{{ section.settings.review_score }} stars">{{ section.settings.star_icons }}</span>
        <strong>{{ section.settings.review_score }}</strong>
        <span>({{ section.settings.review_count }}) · {{ section.settings.customer_count }}</span>
      </div>
      {% endif %}

      <h2 class="gruns-product-title">{{ product.title | default: section.settings.product_title }}</h2>

      {% if product.description != blank %}
      <div class="gruns-product-description">
        {{ product.description }}
      </div>
      {% endif %}

      <hr class="gruns-divider">

      <!-- VARIANT OPTIONS -->
      {% if product.has_only_default_variant == false %}
        {% for option in product.options_with_values %}
        <div class="gruns-option-group" data-option-index="{{ forloop.index0 }}">
          <div class="gruns-option-label">{{ option.name }}</div>
          <div class="gruns-toggle-group" role="group" aria-label="{{ option.name }}">
            {% for value in option.values %}
            {% assign is_selected = false %}
            {% if option.selected_value == value %}{% assign is_selected = true %}{% endif %}
            <button
              class="gruns-toggle-btn{% if is_selected %} active{% endif %}"
              data-option="{{ forloop.parentloop.index0 }}"
              data-value="{{ value | escape }}"
              aria-pressed="{{ is_selected }}"
            >
              {{ value }}
            </button>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      {% else %}
        <div class="gruns-option-group">
          <div class="gruns-option-label">{{ section.settings.variant_fallback_label }}</div>
          <div class="gruns-toggle-group" role="group" aria-label="{{ section.settings.variant_fallback_label }}">
            <button class="gruns-toggle-btn active" data-option="sugar" data-value="low" aria-pressed="true">{{ section.settings.variant_option1_label }}</button>
            <button class="gruns-toggle-btn" data-option="sugar" data-value="free" aria-pressed="false">{{ section.settings.variant_option2_label }}</button>
          </div>
        </div>
      {% endif %}

      <!-- QTY -->
      <div class="gruns-option-group">
        <div class="gruns-adults-row">
          <div class="gruns-option-label">{{ section.settings.qty_label }}</div>
          <span class="gruns-save-pill">{{ section.settings.qty_save_icon }} {{ section.settings.qty_save_text }}</span>
        </div>
        <div class="gruns-qty-toggle" id="gruns-qty-{{ section.id }}" role="group" aria-label="{{ section.settings.qty_label }}">
          <button class="gruns-qty-btn active" data-qty="1" aria-pressed="true">{{ section.settings.qty_btn1_label }}</button>
          <button class="gruns-qty-btn" data-qty="2" aria-pressed="false">{{ section.settings.qty_btn2_label }}</button>
        </div>
      </div>

      <hr class="gruns-divider">

      <!-- PURCHASE OPTIONS -->
      <div class="gruns-autoship-label">{{ section.settings.autoship_label }}</div>

      <!-- ═══════════════════════════════════════════════════════
           Subscribe & Save Card
           Perks: blocks of type "sub_perk" (limit 5)
           Fallback: settings sub_perk_1 … sub_perk_5
      ════════════════════════════════════════════════════════ -->
      {%- assign sub_perk_blocks = section.blocks | where: 'type', 'sub_perk' -%}

      <div
        class="gruns-purchase-card active"
        id="gruns-card-sub-{{ section.id }}"
        data-type="subscription"
        role="radio"
        aria-checked="true"
        tabindex="0"
      >
        <div class="gruns-popular-tag">{{ section.settings.sub_popular_prefix }} · {{ section.settings.sub_popular_suffix_prefix }} {{ section.settings.subscribe_discount }}% {{ section.settings.sub_popular_suffix_postfix }}</div>
        <div class="gruns-card-top">
          <div class="gruns-card-title-row">
            <div class="gruns-radio-dot active" aria-hidden="true"></div>
            <div class="gruns-card-title">{{ section.settings.sub_card_title }}</div>
          </div>
          <div class="gruns-card-price">
            <div class="gruns-price-main" id="gruns-sub-price-{{ section.id }}">
              {{ product.selected_or_first_available_variant.price | times: 0.51 | money }}<span class="gruns-price-freq">{{ section.settings.price_freq_suffix }}</span>
            </div>
            <span class="gruns-price-sub">
              <span class="gruns-price-old" id="gruns-sub-old-{{ section.id }}">
                {{ product.selected_or_first_available_variant.price | money }}
              </span>
              · <span id="gruns-sub-day-{{ section.id }}">₹0.00{{ section.settings.per_day_suffix }}</span>
            </span>
          </div>
        </div>
        <div class="gruns-card-desc">{{ section.settings.sub_card_desc }}</div>

        {% if sub_perk_blocks.size > 0 %}
        <ul class="gruns-card-perks">
          {% for block in sub_perk_blocks %}
            {% if block.settings.text != blank %}
            <li {{ block.shopify_attributes }}>
              <span class="gruns-perk-icon{% unless block.settings.icon_image != blank or block.settings.icon_emoji != blank %} gruns-perk-icon--check{% endunless %}" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  <span class="gruns-perk-icon--img">{{- block.settings.icon_image | image_url: width: 32 | image_tag: loading: 'lazy', alt: '' -}}</span>
                {%- elsif block.settings.icon_emoji != blank -%}
                  {{ block.settings.icon_emoji }}
                {%- endif -%}
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
            {% endif %}
          {% endfor %}
        </ul>
        {% else %}
        <ul class="gruns-card-perks">
          {% if section.settings.sub_perk_1 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--check" aria-hidden="true"></span><span>{{ section.settings.sub_perk_1 }}</span></li>{% endif %}
          {% if section.settings.sub_perk_2 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--check" aria-hidden="true"></span><span>{{ section.settings.sub_perk_2 }}</span></li>{% endif %}
          {% if section.settings.sub_perk_3 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--check" aria-hidden="true"></span><span>{{ section.settings.sub_perk_3 }}</span></li>{% endif %}
          {% if section.settings.sub_perk_4 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--check" aria-hidden="true"></span><span>{{ section.settings.sub_perk_4 }}</span></li>{% endif %}
          {% if section.settings.sub_perk_5 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--check" aria-hidden="true"></span><span>{{ section.settings.sub_perk_5 }}</span></li>{% endif %}
        </ul>
        {% endif %}
      </div>

      <!-- ═══════════════════════════════════════════════════════
           One Time Purchase Card
           Perks: blocks of type "once_perk" (limit 5)
           Fallback: settings once_perk_1 … once_perk_5
      ════════════════════════════════════════════════════════ -->
      {%- assign once_perk_blocks = section.blocks | where: 'type', 'once_perk' -%}

      <div
        class="gruns-purchase-card"
        id="gruns-card-once-{{ section.id }}"
        data-type="onetime"
        role="radio"
        aria-checked="false"
        tabindex="0"
      >
        <div class="gruns-card-top">
          <div class="gruns-card-title-row">
            <div class="gruns-radio-dot" aria-hidden="true"></div>
            <div class="gruns-card-title">{{ section.settings.once_card_title }}</div>
          </div>
          <div class="gruns-card-price">
            <div class="gruns-price-main" id="gruns-once-price-{{ section.id }}">
              {{ product.selected_or_first_available_variant.price | money }}
            </div>
            <span class="gruns-price-sub">
              <span class="gruns-price-old" id="gruns-once-old-{{ section.id }}">
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              </span>
              · <span id="gruns-once-day-{{ section.id }}">₹0.00{{ section.settings.per_day_suffix }}</span>
            </span>
          </div>
        </div>
        <div class="gruns-card-desc">{{ section.settings.once_card_desc }}</div>

        {% if once_perk_blocks.size > 0 %}
        <ul class="gruns-card-perks gruns-card-perks--negative">
          {% for block in once_perk_blocks %}
            {% if block.settings.text != blank %}
            <li {{ block.shopify_attributes }}>
              <span class="gruns-perk-icon{% unless block.settings.icon_image != blank or block.settings.icon_emoji != blank %} gruns-perk-icon--cross{% endunless %}" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  <span class="gruns-perk-icon--img">{{- block.settings.icon_image | image_url: width: 32 | image_tag: loading: 'lazy', alt: '' -}}</span>
                {%- elsif block.settings.icon_emoji != blank -%}
                  {{ block.settings.icon_emoji }}
                {%- endif -%}
              </span>
              <span>{{ block.settings.text }}</span>
            </li>
            {% endif %}
          {% endfor %}
        </ul>
        {% else %}
        <ul class="gruns-card-perks gruns-card-perks--negative">
          {% if section.settings.once_perk_1 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--cross" aria-hidden="true"></span><span>{{ section.settings.once_perk_1 }}</span></li>{% endif %}
          {% if section.settings.once_perk_2 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--cross" aria-hidden="true"></span><span>{{ section.settings.once_perk_2 }}</span></li>{% endif %}
          {% if section.settings.once_perk_3 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--cross" aria-hidden="true"></span><span>{{ section.settings.once_perk_3 }}</span></li>{% endif %}
          {% if section.settings.once_perk_4 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--cross" aria-hidden="true"></span><span>{{ section.settings.once_perk_4 }}</span></li>{% endif %}
          {% if section.settings.once_perk_5 != blank %}<li><span class="gruns-perk-icon gruns-perk-icon--cross" aria-hidden="true"></span><span>{{ section.settings.once_perk_5 }}</span></li>{% endif %}
        </ul>
        {% endif %}
      </div>

      <!-- ADD TO CART -->
      {%- assign gruns_form_id = 'gruns-product-form-' | append: section.id -%}
      {%- form 'product', product, id: gruns_form_id, class: 'gruns-product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" id="gruns-variant-id-{{ section.id }}"
               value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" id="gruns-quantity-{{ section.id }}" value="1">

        <button
          type="submit"
          name="add"
          class="gruns-cta-btn"
          id="gruns-cta-{{ section.id }}"
          {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
          aria-label="Add to cart"
        >
          {% if product.selected_or_first_available_variant.available %}
            {{ section.settings.cta_available_text }}
          {% else %}
            {{ section.settings.cta_soldout_text }}
          {% endif %}
        </button>
      {%- endform -%}

      {% if section.settings.discount_pill_text != blank %}
      <div class="gruns-discount-pill">
        <span>{{ section.settings.discount_pill_icon }}</span> {{ section.settings.discount_pill_text }}
      </div>
      {% endif %}

      <!-- ═══════════════════════════════════════════════════════
           Trust Icons — up to 3
           image_picker takes priority over emoji per item
      ════════════════════════════════════════════════════════ -->
      <div class="gruns-trust-row">

        {% if section.settings.trust_1_text != blank %}
        <div class="gruns-trust-item">
          <div class="gruns-trust-icon" aria-hidden="true">
            {% if section.settings.trust_1_image != blank %}
              {{ section.settings.trust_1_image | image_url: width: 56 | image_tag: loading: 'lazy', alt: '', class: 'gruns-trust-img' }}
            {% elsif section.settings.trust_1_icon != blank %}
              {{ section.settings.trust_1_icon }}
            {% endif %}
          </div>
          <div class="gruns-trust-text">{{ section.settings.trust_1_text }}</div>
        </div>
        {% endif %}

        {% if section.settings.trust_2_text != blank %}
        <div class="gruns-trust-item">
          <div class="gruns-trust-icon" aria-hidden="true">
            {% if section.settings.trust_2_image != blank %}
              {{ section.settings.trust_2_image | image_url: width: 56 | image_tag: loading: 'lazy', alt: '', class: 'gruns-trust-img' }}
            {% elsif section.settings.trust_2_icon != blank %}
              {{ section.settings.trust_2_icon }}
            {% endif %}
          </div>
          <div class="gruns-trust-text">{{ section.settings.trust_2_text }}</div>
        </div>
        {% endif %}

        {% if section.settings.trust_3_text != blank %}
        <div class="gruns-trust-item">
          <div class="gruns-trust-icon" aria-hidden="true">
            {% if section.settings.trust_3_image != blank %}
              {{ section.settings.trust_3_image | image_url: width: 56 | image_tag: loading: 'lazy', alt: '', class: 'gruns-trust-img' }}
            {% elsif section.settings.trust_3_icon != blank %}
              {{ section.settings.trust_3_icon }}
            {% endif %}
          </div>
          <div class="gruns-trust-text">{{ section.settings.trust_3_text }}</div>
        </div>
        {% endif %}

      </div>

      <!-- ═══════════════════════════════════════════════════════
           ACCORDION
           Header icon: image_picker first, then emoji
           Body: optional acc_image with position control
      ════════════════════════════════════════════════════════ -->
      <div class="gruns-accordion" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
          <div class="gruns-acc-item" {{ block.shopify_attributes }} role="listitem">
            <button
              class="gruns-acc-header"
              aria-expanded="false"
              aria-controls="gruns-acc-body-{{ block.id }}"
            >
              {% if block.settings.icon_image != blank %}
                <span class="gruns-acc-header-icon gruns-acc-header-icon--img" aria-hidden="true">
                  {{- block.settings.icon_image | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' -}}
                </span>
              {% elsif block.settings.icon_emoji != blank %}
                <span class="gruns-acc-header-icon" aria-hidden="true">{{ block.settings.icon_emoji }}</span>
              {% endif %}
              <span class="gruns-acc-header-title">{{ block.settings.title }}</span>
              <span class="gruns-acc-icon" aria-hidden="true">{{ section.settings.accordion_open_icon }}</span>
            </button>
            <div
              class="gruns-acc-body"
              id="gruns-acc-body-{{ block.id }}"
              role="region"
            >
              <div
                class="gruns-acc-body-inner{% if block.settings.acc_image != blank %} gruns-acc-has-image{% endif %}"
                {% if block.settings.acc_image != blank %}data-img-pos="{{ block.settings.image_position | default: 'left' }}"{% endif %}
              >
                {% if block.settings.acc_image != blank %}
                <div class="gruns-acc-image-wrap">
                  {{
                    block.settings.acc_image
                    | image_url: width: 600
                    | image_tag:
                        loading: 'lazy',
                        alt: block.settings.acc_image.alt | default: block.settings.title,
                        class: 'gruns-acc-image',
                        widths: '300, 400, 600',
                        sizes: '(max-width: 640px) 100vw, 260px'
                  }}
                </div>
                {% endif %}
                <div class="gruns-acc-text-wrap">
                  {{ block.settings.content }}
                </div>
              </div>
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- TASTE & PACKED -->
      {% assign taste_blocks  = section.blocks | where: 'type', 'taste' %}
      {% assign packed_blocks = section.blocks | where: 'type', 'ingredient' %}

      {% if taste_blocks.size > 0 or packed_blocks.size > 0 %}
      <div class="gruns-extra-section">

        {% if taste_blocks.size > 0 %}
        <h3 class="gruns-extra-heading">{{ section.settings.taste_heading }}</h3>
        <div class="gruns-taste-row">
          {% for block in taste_blocks %}
          <div class="gruns-taste-item" {{ block.shopify_attributes }}>
            <div class="gruns-taste-icon">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.label | default: '', class: 'gruns-taste-img' }}
              {% else %}
                {{ block.settings.icon }}
              {% endif %}
            </div>
            <span>{{ block.settings.label }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {% if packed_blocks.size > 0 %}
        <h3 class="gruns-extra-heading">{{ section.settings.packed_heading }}</h3>
        <div class="gruns-packed-row">
          {% for block in packed_blocks %}
          <div class="gruns-packed-item" {{ block.shopify_attributes }}>
            <span class="gruns-packed-icon">
              {% if block.settings.icon_image != blank %}
                {{ block.settings.icon_image | image_url: width: 48 | image_tag: loading: 'lazy', alt: block.settings.label | default: '', class: 'gruns-packed-img' }}
              {% else %}
                {{ block.settings.icon }}
              {% endif %}
            </span>
            {{ block.settings.label }}
          </div>
          {% endfor %}
        </div>
        {% endif %}

      </div>
      {% endif %}

    </div>
  </div>

</div>
</section>

<script src="{{ 'gruns-product-section.js' | asset_url }}" defer></script>

<script>
  window.GrunsProduct_{{ section.id | replace: '-', '_' }} = {
    sectionId:               '{{ section.id }}',
    productHandle:           '{{ product.handle }}',
    variantsJson:            {{ product.variants | json }},
    subscribeDiscount:       {{ section.settings.subscribe_discount }},
    currencySymbol:          '₹',
    perDaySuffix:            '{{ section.settings.per_day_suffix | escape }}',
    priceFreqSuffix:         '{{ section.settings.price_freq_suffix | escape }}',
    ctaAvailableText:        '{{ section.settings.cta_available_text | escape }}',
    ctaSoldoutText:          '{{ section.settings.cta_soldout_text | escape }}',
    subPopularPrefix:        '{{ section.settings.sub_popular_prefix | escape }}',
    subPopularSuffixPrefix:  '{{ section.settings.sub_popular_suffix_prefix | escape }}',
    subPopularSuffixPostfix: '{{ section.settings.sub_popular_suffix_postfix | escape }}',
    variantImages: {
      {%- for variant in product.variants -%}
        {%- if variant.featured_image -%}
          "{{ variant.id }}": {
            "src":      "{{ variant.featured_image | image_url: width: 800 }}",
            "thumb":    "{{ variant.featured_image | image_url: width: 120 }}",
            "alt":      {{ variant.featured_image.alt | default: variant.title | json }},
            "position": {{ variant.featured_image.position | minus: 1 }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    }
  };
</script>

<script>
/* ═══════════════════════════════════════════════════════════════
   gruns-product-section.js  –  assets/gruns-product-section.js
═══════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  function formatMoney(cents, symbol) {
    symbol = symbol || '₹';
    return symbol + (cents / 100).toFixed(2);
  }

  function GrunsProductSection(sectionEl) {
    this.section   = sectionEl;
    this.sectionId = sectionEl.dataset.sectionId;
    var configKey        = 'GrunsProduct_' + this.sectionId.replace(/-/g, '_');
    this.config          = window[configKey] || {};
    this.variants        = this.config.variantsJson || [];
    this.discount        = parseInt(this.config.subscribeDiscount, 10) || 49;
    this.currency        = this.config.currencySymbol || '₹';
    this.perDaySuffix    = this.config.perDaySuffix    || '/day';
    this.priceFreqSuffix = this.config.priceFreqSuffix || '/mo';
    this.selectedOptions = {};
    this.qty             = 1;
    this.purchaseType    = 'subscription';
    this._initGallery();
    this._initVariantToggles();
    this._initQtyToggle();
    this._initPurchaseCards();
    this._initAccordion();
    this._updatePricing();
  }

  GrunsProductSection.prototype._initGallery = function () {
    var self   = this;
    var thumbs = this.section.querySelectorAll('.gruns-thumb');
    var slides = this.section.querySelectorAll('.gruns-slide');
    if (!thumbs.length) return;
    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var idx = parseInt(this.dataset.index, 10);
        thumbs.forEach(function (t) { t.classList.remove('active'); });
        this.classList.add('active');
        slides.forEach(function (s) { s.classList.remove('active'); });
        var target = self.section.querySelector('.gruns-slide[data-slide="' + idx + '"]');
        if (target) target.classList.add('active');
      });
    });
  };

  GrunsProductSection.prototype._initVariantToggles = function () {
    var self    = this;
    var buttons = this.section.querySelectorAll('.gruns-toggle-btn');
    if (!buttons.length) return;
    buttons.forEach(function (btn) {
      if (btn.classList.contains('active') || btn.getAttribute('aria-pressed') === 'true') {
        self.selectedOptions[btn.dataset.option] = btn.dataset.value;
      }
    });
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var optIdx = this.dataset.option;
        self.section.querySelectorAll('.gruns-toggle-btn[data-option="' + optIdx + '"]')
          .forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
        this.classList.add('active');
        this.setAttribute('aria-pressed', 'true');
        self.selectedOptions[optIdx] = this.dataset.value;
        self._matchVariant();
        self._updatePricing();
      });
    });
  };

  GrunsProductSection.prototype._initQtyToggle = function () {
    var self    = this;
    var buttons = this.section.querySelectorAll('.gruns-qty-btn');
    var pill    = this.section.querySelector('.gruns-save-pill');
    if (!buttons.length) return;
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
        this.classList.add('active');
        this.setAttribute('aria-pressed', 'true');
        self.qty = parseInt(this.dataset.qty, 10) || 1;
        var qtyInput = self.section.querySelector('#gruns-quantity-' + self.sectionId);
        if (qtyInput) qtyInput.value = self.qty;
        if (pill) pill.classList.toggle('gruns-save-pill--active', self.qty >= 2);
        self._updatePricing();
      });
    });
  };

  GrunsProductSection.prototype._initPurchaseCards = function () {
    var self  = this;
    var cards = this.section.querySelectorAll('.gruns-purchase-card');
    if (!cards.length) return;
    cards.forEach(function (card) {
      card.addEventListener('click', function () { self._selectCard(this.dataset.type); });
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); self._selectCard(this.dataset.type); }
      });
    });
  };

  GrunsProductSection.prototype._selectCard = function (type) {
    var self = this;
    this.purchaseType = type;
    this.section.querySelectorAll('.gruns-purchase-card').forEach(function (card) {
      var isActive = card.dataset.type === type;
      card.classList.toggle('active', isActive);
      card.setAttribute('aria-checked', isActive ? 'true' : 'false');
      var dot = card.querySelector('.gruns-radio-dot');
      if (dot) dot.classList.toggle('active', isActive);
    });
    self._updatePricing();
  };

  GrunsProductSection.prototype._initAccordion = function () {
    var headers = this.section.querySelectorAll('.gruns-acc-header');
    if (!headers.length) return;
    headers.forEach(function (header) {
      header.addEventListener('click', function () {
        var bodyId = this.getAttribute('aria-controls');
        var body   = document.getElementById(bodyId);
        var isOpen = this.getAttribute('aria-expanded') === 'true';
        headers.forEach(function (h) {
          h.setAttribute('aria-expanded', 'false');
          var b = document.getElementById(h.getAttribute('aria-controls'));
          if (b) b.classList.remove('open');
        });
        if (!isOpen) {
          this.setAttribute('aria-expanded', 'true');
          if (body) body.classList.add('open');
        }
      });
    });
  };

  GrunsProductSection.prototype._matchVariant = function () {
    if (!this.variants.length) return;
    var self         = this;
    var optionValues = Object.values(self.selectedOptions);
    var matched      = null;
    this.variants.forEach(function (v) {
      var match = v.options.every(function (opt, idx) {
        return optionValues[idx] === undefined || opt === optionValues[idx];
      });
      if (match) matched = v;
    });
    if (matched) {
      this.currentVariant = matched;
      var varInput = this.section.querySelector('#gruns-variant-id-' + this.sectionId);
      if (varInput) varInput.value = matched.id;
      var ctaBtn = this.section.querySelector('#gruns-cta-' + this.sectionId);
      if (ctaBtn) {
        ctaBtn.disabled = !matched.available;
        if (!matched.available) ctaBtn.textContent = self.config.ctaSoldoutText || 'Sold Out';
      }
      this._switchVariantImage(matched);
    }
  };

  GrunsProductSection.prototype._switchVariantImage = function (variant) {
    var variantImages = this.config.variantImages || {};
    var imgData  = variantImages[variant.id];
    if (!imgData) return;
    var slides   = this.section.querySelectorAll('.gruns-slide');
    var thumbs   = this.section.querySelectorAll('.gruns-thumb');
    var position = imgData.position;
    var targetSlide = this.section.querySelector('.gruns-slide[data-slide="' + position + '"]');
    if (targetSlide) {
      slides.forEach(function (s) { s.classList.remove('active'); });
      targetSlide.classList.add('active');
      thumbs.forEach(function (t) { t.classList.remove('active'); });
      var th = this.section.querySelector('.gruns-thumb[data-index="' + position + '"]');
      if (th) th.classList.add('active');
      return;
    }
    var firstSlide = this.section.querySelector('.gruns-slide[data-slide="0"]');
    if (!firstSlide) return;
    var existingImg = firstSlide.querySelector('img.gruns-variant-injected');
    if (existingImg) {
      existingImg.src = imgData.src; existingImg.alt = imgData.alt;
    } else {
      var img = document.createElement('img');
      img.src = imgData.src; img.alt = imgData.alt;
      img.className = 'gruns-product-img gruns-variant-injected';
      img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0;';
      firstSlide.style.position = 'relative';
      firstSlide.appendChild(img);
    }
    slides.forEach(function (s) { s.classList.remove('active'); });
    firstSlide.classList.add('active');
    var th2 = this.section.querySelector('.gruns-thumb[data-index="0"]');
    if (th2) {
      thumbs.forEach(function (t) { t.classList.remove('active'); });
      th2.classList.add('active');
      var tImg = th2.querySelector('img');
      if (tImg) { tImg.src = imgData.thumb; tImg.alt = imgData.alt; }
    }
  };

  GrunsProductSection.prototype._updatePricing = function () {
    var variant = this.currentVariant || (this.variants.length ? this.variants[0] : null);
    if (!variant) return;
    var basePrice    = variant.price;
    var comparePrice = variant.compare_at_price || basePrice;
    var qty          = this.qty;
    var sid          = this.sectionId;
    var sym          = this.currency;
    var daySuffix    = this.perDaySuffix;
    var freqSuffix   = this.priceFreqSuffix;
    var cfg          = this.config;
    var qtyDiscount    = qty >= 2 ? 0.95 : 1.0;
    var subDiscountPct = this.discount + (qty >= 2 ? 3 : 0);
    var subMultiplier  = 1 - (subDiscountPct / 100);
    var oncePrice = Math.round(basePrice * qty * qtyDiscount);
    var subPrice  = Math.round(oncePrice * subMultiplier);
    var oldOnce   = comparePrice * qty;
    var onceDayPrice = (oncePrice / 100 / 28).toFixed(2);
    var subDayPrice  = (subPrice  / 100 / 28).toFixed(2);

    var subPriceEl = this.section.querySelector('#gruns-sub-price-' + sid);
    if (subPriceEl) subPriceEl.innerHTML = formatMoney(subPrice, sym) + '<span class="gruns-price-freq">' + freqSuffix + '</span>';
    var subOldEl = this.section.querySelector('#gruns-sub-old-' + sid);
    if (subOldEl) subOldEl.textContent = formatMoney(oldOnce, sym) + freqSuffix;
    var subDayEl = this.section.querySelector('#gruns-sub-day-' + sid);
    if (subDayEl) subDayEl.textContent = sym + subDayPrice + daySuffix;

    var popularTag = this.section.querySelector('#gruns-card-sub-' + sid + ' .gruns-popular-tag');
    if (popularTag) {
      popularTag.textContent =
        (cfg.subPopularPrefix || 'Most Popular') + ' · ' +
        (cfg.subPopularSuffixPrefix || 'Get') + ' ' +
        subDiscountPct + '% ' +
        (cfg.subPopularSuffixPostfix || 'Off');
    }

    var oncePriceEl = this.section.querySelector('#gruns-once-price-' + sid);
    if (oncePriceEl) oncePriceEl.textContent = formatMoney(oncePrice, sym);
    var onceOldEl = this.section.querySelector('#gruns-once-old-' + sid);
    if (onceOldEl) onceOldEl.textContent = formatMoney(oldOnce, sym);
    var onceDayEl = this.section.querySelector('#gruns-once-day-' + sid);
    if (onceDayEl) onceDayEl.textContent = sym + onceDayPrice + daySuffix;

    var ctaBtn = this.section.querySelector('#gruns-cta-' + sid);
    if (ctaBtn && !ctaBtn.disabled) {
      var displayPrice = this.purchaseType === 'subscription'
        ? formatMoney(subPrice, sym) + freqSuffix
        : formatMoney(oncePrice, sym);
      ctaBtn.textContent = (cfg.ctaAvailableText || 'Start Now') + ' — ' + displayPrice;
    }
  };

  function boot() {
    document.querySelectorAll('[data-section-type="gruns-product"]').forEach(function (el) {
      new GrunsProductSection(el);
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
  document.addEventListener('shopify:section:load', function (e) {
    var el = e.target.querySelector('[data-section-type="gruns-product"]');
    if (el) new GrunsProductSection(el);
  });

})();
</script>

