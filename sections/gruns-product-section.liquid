}
.gruns-acc-image { width: 100%; height: auto; display: block; object-fit: cover; }
.gruns-acc-text-wrap { flex: 1; min-width: 140px; }
.gruns-acc-has-image[data-img-pos="right"]  { flex-direction: row-reverse; }
