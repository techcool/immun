}

/* ── Trust icons ── */
.gruns-trust-row { display: flex; gap: 8px; justify-content: space-between; flex-wrap: wrap; }
.gruns-trust-item { flex: 1; min-width: 80px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 4px; }
