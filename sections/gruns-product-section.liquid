.gruns-card-desc { font-size: .75rem; color: var(--g-muted); margin-left: 0; margin-bottom: 8px; }

/* ── Perks list ── */
.gruns-card-perks {
  padding: 0; list-style: none;
  display: flex; flex-direction: column; gap: 6px; margin-top: 8px;
}
.gruns-card-perks li {
  font-size: .78rem; color: var(--g-green-mid);
