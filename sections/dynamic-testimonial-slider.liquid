{% schema %}
{
  "name": "Press Slider",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f6f6f4"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Autoplay Speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Slider"
    }
  ]
}
{% endschema %}

<style>
.press-section {
  background: {{ section.settings.bg_color }};
  padding: 120px 20px;
  overflow: hidden;
  position: relative;
  text-align: center;
}

.press-wrapper {
  display: flex;
  transition: transform 0.6s ease;
}

.press-slide {
  min-width: 100%;
  opacity: 0.4;
  transition: opacity 0.5s ease;
}

.press-slide.active {
  opacity: 1;
}

.press-quote {
  font-size: 20px;
  max-width: 700px;
  margin: 0 auto 40px;
  color: #1f3d2b;
}

.press-logo img {
  max-height: 70px;
  margin: 0 auto;
}

.press-arrows {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  transform: translateY(-50%);
  padding: 0 40px;
}

.press-arrow {
  width: 50px;
  height: 50px;
  border: 2px solid #1f3d2b;
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
  font-size: 18px;
  color: #1f3d2b;
}

.press-dots {
  margin-top: 40px;
}

.press-dots span {
  width: 8px;
  height: 8px;
  margin: 0 5px;
  background: #b7c2b9;
  display: inline-block;
  border-radius: 50%;
  cursor: pointer;
}

.press-dots span.active {
  background: #1f3d2b;
}

@media(max-width:768px){
  .press-section {
    padding: 80px 20px;
  }

  .press-quote {
    font-size: 16px;
  }

  .press-arrows {
    padding: 0 15px;
  }
}
</style>

<section class="press-section">
  <div class="press-wrapper" id="pressWrapper">
    {% for block in section.blocks %}
      <div class="press-slide {% if forloop.first %}active{% endif %}">
        <div class="press-quote">
          "{{ block.settings.quote }}"
        </div>
        {% if block.settings.logo %}
        <div class="press-logo">
          <img src="{{ block.settings.logo | image_url }}" alt="logo">
        </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
  <div class="press-arrows">
    <button class="press-arrow" id="prev">&#8592;</button>
    <button class="press-arrow" id="next">&#8594;</button>
  </div>

  <div class="press-dots" id="pressDots">
    {% for block in section.blocks %}
      <span class="{% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></span>
    {% endfor %}
  </div>
  {% endif %}
</section>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const wrapper = document.getElementById("pressWrapper");
  const slides = document.querySelectorAll(".press-slide");
  const dots = document.querySelectorAll("#pressDots span");
  const prev = document.getElementById("prev");
  const next = document.getElementById("next");

  let index = 0;
  let total = slides.length;
  let autoplay = {{ section.settings.autoplay }};
  let speed = {{ section.settings.speed }} * 1000;
  let interval;

  function updateSlider(){
    wrapper.style.transform = "translateX(-" + index * 100 + "%)";
    slides.forEach(s => s.classList.remove("active"));
    dots.forEach(d => d.classList.remove("active"));
    slides[index].classList.add("active");
    dots[index].classList.add("active");
  }

  if(next){
    next.addEventListener("click", function(){
      index = (index + 1) % total;
      updateSlider();
    });
  }

  if(prev){
    prev.addEventListener("click", function(){
      index = (index - 1 + total) % total;
      updateSlider();
    });
  }

  dots.forEach(dot=>{
    dot.addEventListener("click", function(){
      index = parseInt(this.dataset.index);
      updateSlider();
    });
  });

  if(autoplay && total > 1){
    interval = setInterval(function(){
      index = (index + 1) % total;
      updateSlider();
    }, speed);
  }

});
</script>