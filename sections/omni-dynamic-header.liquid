<header class="omni-header" style="background: {{ section.settings.bg_color }};">

  <div class="omni-header-inner logo-{{ section.settings.logo_position }}">

    <!-- LEFT -->
    <div class="omni-left">
      {% if section.settings.show_shop_link %}
        <a href="{{ section.settings.shop_link }}" class="shop-link">
          {{ section.settings.shop_text }}
        </a>
      {% endif %}
    </div>


    <!-- LOGO -->
    <div class="omni-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            loading="lazy"
          >
        {% else %}
          {{ shop.name }}
        {% endif %}
      </a>
    </div>


    <!-- RIGHT -->
    <div class="omni-right">

      {% if section.settings.show_account %}
      <a href="{{ section.settings.account_link | default: routes.account_url }}" class="header-icon">

        {% if section.settings.account_icon != blank %}
          <img
            src="{{ section.settings.account_icon | image_url: width: 60 }}"
            alt="Account"
          >
        {% else %}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2"/>
            <path d="M4 20c0-4 4-6 8-6s8 2 8 6" stroke="currentColor" stroke-width="2"/>
          </svg>
        {% endif %}

      </a>
      {% endif %}


      {% if section.settings.show_cart %}
      <a href="{{ section.settings.cart_link | default: routes.cart_url }}" class="header-icon cart-icon">

        {% if section.settings.cart_icon != blank %}
          <img
            src="{{ section.settings.cart_icon | image_url: width: 60 }}"
            alt="Cart"
          >
        {% else %}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <circle cx="9" cy="21" r="1" stroke="currentColor" stroke-width="2"/>
            <circle cx="20" cy="21" r="1" stroke="currentColor" stroke-width="2"/>
            <path d="M1 1h4l2.7 13h11.6l2-8H6" stroke="currentColor" stroke-width="2"/>
          </svg>
        {% endif %}

        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}

      </a>
      {% endif %}

    </div>

  </div>

</header>


<style>

.omni-header{
  padding:14px 40px;
  border-bottom:1px solid rgba(0,0,0,0.08);
}

.omni-header-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
}


/* LEFT */

.omni-left{
  flex:1;
}

.shop-link{
  text-decoration:underline;
  font-size:14px;
  font-weight:500;
}


/* LOGO */

.omni-logo{
  flex:1;
  text-align:center;
}

.logo-left .omni-logo{
  text-align:left;
}

.logo-right .omni-logo{
  text-align:right;
}

.omni-logo img{
  max-height:42px;
}


/* RIGHT */

.omni-right{
  flex:1;
  display:flex;
  justify-content:flex-end;
  gap:18px;
  align-items:center;
}

.header-icon{
  position:relative;
  display:flex;
  align-items:center;
}

.header-icon img{
  height:22px;
  width:auto;
}


/* CART COUNT */

.cart-count{
  position:absolute;
  top:-6px;
  right:-8px;
  background:#000;
  color:#fff;
  font-size:10px;
  padding:2px 6px;
  border-radius:20px;
}


@media(max-width:768px){

  .shop-link{
    display:none;
  }

  .omni-header{
    padding:12px 20px;
  }

}

</style>



{% schema %}
{
  "name": "OMNI Flex Header",
  "settings": [

    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background",
      "default": "#f3f5f8"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },

    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo Position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    {
      "type": "checkbox",
      "id": "show_shop_link",
      "label": "Show Shop Link",
      "default": true
    },

    {
      "type": "text",
      "id": "shop_text",
      "label": "Shop Link Text",
      "default": "SHOP NOW"
    },

    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop Link URL"
    },

    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },

    {
      "type": "image_picker",
      "id": "account_icon",
      "label": "Account Icon (PNG / SVG)"
    },

    {
      "type": "url",
      "id": "account_link",
      "label": "Account Icon Link"
    },

    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    },

    {
      "type": "image_picker",
      "id": "cart_icon",
      "label": "Cart Icon (PNG / SVG)"
    },

    {
      "type": "url",
      "id": "cart_link",
      "label": "Cart Icon Link"
    }

  ],

  "presets": [
    {
      "name": "OMNI Flex Header"
    }
  ]
}
{% endschema %}