<header class="omni-header" style="background: {{ section.settings.bg_color }}">

  <div class="omni-header-container logo-{{ section.settings.logo_position }}">

    <!-- LEFT -->
    <div class="omni-left">

      {% if section.settings.show_shop_link %}
        <a href="{{ section.settings.shop_link }}" class="shop-link">
          {{ section.settings.shop_text }}
        </a>
      {% endif %}

    </div>


    <!-- LOGO -->
    <div class="omni-logo">

      <a href="{{ routes.root_url }}">

        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            loading="lazy"
          >
        {% else %}
          {{ shop.name }}
        {% endif %}

      </a>

    </div>


    <!-- RIGHT -->
    <div class="omni-right">

      {% if section.settings.show_account %}
      <a href="{{ routes.account_url }}" class="header-icon">
        {% render 'icon-account' %}
      </a>
      {% endif %}

      {% if section.settings.show_cart %}
      <a href="{{ routes.cart_url }}" class="header-icon cart-icon">

        {% render 'icon-cart' %}

        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}

      </a>
      {% endif %}

    </div>

  </div>

</header>


<style>

.omni-header{
  padding:14px 40px;
}

.omni-header-container{
  display:flex;
  align-items:center;
  justify-content:space-between;
}


/* LOGO CENTER */

.logo-center .omni-left{
  flex:1;
}

.logo-center .omni-logo{
  flex:1;
  text-align:center;
}

.logo-center .omni-right{
  flex:1;
  display:flex;
  justify-content:flex-end;
  gap:18px;
}


/* LOGO LEFT */

.logo-left .omni-left{
  display:flex;
  gap:20px;
}

.logo-left .omni-logo{
  margin-right:auto;
  margin-left:20px;
}


/* LOGO */

.omni-logo img{
  max-height:40px;
}


/* SHOP LINK */

.shop-link{
  text-decoration:underline;
  font-weight:500;
  font-size:14px;
}


/* ICON */

.header-icon{
  position:relative;
}


/* CART COUNT */

.cart-count{
  position:absolute;
  top:-6px;
  right:-10px;
  font-size:10px;
  padding:2px 6px;
  border-radius:20px;
  background:#000;
  color:#fff;
}

</style>


{% schema %}
{
  "name": "OMNI Dynamic Header",
  "settings": [

    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background",
      "default": "#f3f5f8"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },

    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo Position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },

    {
      "type": "checkbox",
      "id": "show_shop_link",
      "label": "Show Shop Link",
      "default": true
    },

    {
      "type": "text",
      "id": "shop_text",
      "label": "Shop Link Text",
      "default": "SHOP NOW"
    },

    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop Link URL"
    },

    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    }

  ],

  "presets": [
    {
      "name": "OMNI Dynamic Header"
    }
  ]
}
{% endschema %}