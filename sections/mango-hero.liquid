<section
  class="mango-hero {{ section.settings.custom_class }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">

    <div class="mango-hero-wrapper">

      <!-- Left Content -->
      <div class="mango-hero-left">

        {% if section.settings.heading != blank %}
          <h2 class="hero-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="hero-desc">
            {{ section.settings.text }}
          </p>
        {% endif %}

        {% if section.settings.btn_label != blank %}
          <a
            href="{{ section.settings.btn_link }}"
            class="hero-btn"
          >
            {{ section.settings.btn_label }}
          </a>
        {% endif %}

      </div>




      <!-- Right Image -->
      <div class="mango-hero-right">

        {% if section.settings.product_image != blank %}
          <img
            src="{{ section.settings.product_image | image_url: width: 900 }}"
            alt=""
            loading="lazy"
            class="product-img"
          >
        {% endif %}

        {% if section.settings.gummy_one != blank %}
          <img
            src="{{ section.settings.gummy_one | image_url: width: 200 }}"
            alt=""
            class="gummy gummy-one"
          >
        {% endif %}

        {% if section.settings.gummy_two != blank %}
          <img
            src="{{ section.settings.gummy_two | image_url: width: 200 }}"
            alt=""
            class="gummy gummy-two"
          >
        {% endif %}

      </div>

    </div>

  </div>
</section>



<style>

.mango-hero{
  overflow:hidden;
  background: linear-gradient(180deg, #000000ff 0%, #00b5e2ff 0%, #ffcc2fff 71.36%, #ff8e2cff 100.29%);
}

.mango-hero-wrapper{
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:60px;
}

.hero-heading{
  font-size:48px;
  font-weight:700;
  margin-bottom:15px;
  color:#063b2e;
}

.hero-desc{
  font-size:16px;
  color:#083b2b;
  margin-bottom:30px;
}


.mango-hero-right{
  position:relative;
  text-align:center;
}

.product-img{
  width:100%;
  position:relative;
  z-index:2;
  margin-bottom: -40px;
}

.gummy{
  position:absolute;
  width:120px;
  z-index:1;
}

.gummy-one{
  left:-40px;
  top:120px;
}

.gummy-two{
  right:-40px;
  top:80px;
}

/* Mobile */

@media(max-width:990px){

  .mango-hero-wrapper{
    grid-template-columns:1fr;
    text-align:center;
    gap:40px;
  }

  .hero-heading{
    font-size:34px;
  }

  .product-img{
    max-width:260px;
    margin:auto;
  }

  .gummy{
    display:none;
  }

}

</style>


{% schema %}
{
  "name": "Mango Product Hero",
  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mango Sorbet Won't Stick Around"
    },

    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Grab this summery flavor before it's gone for good."
    },

    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Stock Up While You Can!"
    },

    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },

    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },

    {
      "type": "image_picker",
      "id": "gummy_one",
      "label": "Left Gummy Image"
    },

    {
      "type": "image_picker",
      "id": "gummy_two",
      "label": "Right Gummy Image"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },

    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }

  ],

  "presets": [
    {
      "name": "Mango Product Hero"
    }
  ]
}
{% endschema %}