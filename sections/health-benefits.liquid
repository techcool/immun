{% style %}
  .your-health {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .your-health .health-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .your-health .health-heading {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--green-color);
  }

  .your-health .health-subheading {
    font-size: 18px;
    color: #555;
    margin-bottom: 60px;
  }

  .your-health .health-grid {
    display: grid;
    grid-template-columns: 1fr 500px 1fr;
    align-items: center;
    gap: 40px;
  }

  .your-health .health-features {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }

  .your-health .health-item {
    text-align: center;
  }

  .your-health .health-icon img {
    width: 40px;
    margin: 0 auto 15px auto;
  }

  .your-health .health-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--green-color)
  }

  .your-health .health-desc {
      font-size: 18px;
      color: #000000;
      line-height: 1.6;
      max-width: 226px;
      margin: 0 auto;
      display: block;
  }

  .your-health .health-center img {
    width: 100%;
    max-width: 450px;
  }
  @media (max-width: 1024px) {
    .your-health .health-grid {
      grid-template-columns: 1fr 300px 1fr;
      gap: 20px;
  }
  }
  @media (max-width: 767px) {
    .your-health .health-grid {
      grid-template-columns: 1fr;
    }

    .your-health .health-center {
      order: -1;
    }
    .your-health .health-features {
      display: flex;
      flex-flow: row wrap;
      gap: 50px;
      justify-content: center;
  }
  .your-health .health-desc{
    max-width: unset;
  }
  .your-health .health-item {
    text-align: center;
    width: calc(50% - 25px);
}
  }
@media (max-width: 576px) {
.your-health .health-features {
      display: flex;
      flex-flow: row wrap;
      gap: 30px;
      justify-content: center;
  }
  .your-health .health-item {
    text-align: center;
    width: calc(50% - 15px);
}
}


{% endstyle %}

<section class="your-health section-{{ section.id }}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}">
  <div class="health-wrapper page-width">
    {% if section.settings.heading != blank %}
      <h2 class="health-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="health-subheading">{{ section.settings.subheading }}</div>
    {% endif %}

    <div class="health-grid">
      <!-- Left Features -->
      <div class="health-features">
        {% for block in section.blocks limit: 2 %}
          <div class="health-item" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="health-icon">
                <img src="{{ block.settings.icon | image_url }}" alt="">
              </div>
            {% endif %}
            <div class="health-title">{{ block.settings.title }}</div>
            <div class="health-desc">{{ block.settings.description }}</div>
          </div>
        {% endfor %}
      </div>

      <!-- Center Image -->
      <div class="health-center">
        {% if section.settings.center_image != blank %}
          <img src="{{ section.settings.center_image | image_url }}" alt="">
        {% endif %}
      </div>

      <!-- Right Features -->
      <div class="health-features">
        {% for block in section.blocks offset: 2 %}
          <div class="health-item" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="health-icon">
                <img src="{{ block.settings.icon | image_url }}" alt="">
              </div>
            {% endif %}
            <div class="health-title">{{ block.settings.title }}</div>
            <div class="health-desc">{{ block.settings.description }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Health Benefits Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Transform Your Health"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Over 35,000 research publications support the ingredients."
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Image"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Gut Health"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Add feature description here."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Health Benefits Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
