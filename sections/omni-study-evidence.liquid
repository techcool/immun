<section class="study-evidence">

<div class="study-container">

<!-- LEFT CONTENT -->
<div class="study-left">

{% if section.settings.badge != blank %}
<div class="study-badge">
{{ section.settings.badge }}
</div>
{% endif %}

{% if section.settings.heading != blank %}
<h2 class="study-title">
{{ section.settings.heading }}
</h2>
{% endif %}

{% if section.settings.description != blank %}
<p class="study-desc">
{{ section.settings.description }}
</p>
{% endif %}


<!-- STATS -->

<div class="study-stats">

<div class="stat-item">

<h3>{{ section.settings.stat1_number }}</h3>
<p>{{ section.settings.stat1_text }}</p>

</div>

<div class="stat-divider"></div>

<div class="stat-item">

<h3>{{ section.settings.stat2_number }}</h3>
<p>{{ section.settings.stat2_text }}</p>

</div>

</div>


<!-- BUTTON -->

{% if section.settings.button_text != blank %}
<a href="{{ section.settings.button_link }}" class="study-btn">

<span>{{ section.settings.button_text }}</span>

{% if section.settings.button_icon != blank %}
<img
src="{{ section.settings.button_icon | image_url: width: 40 }}"
alt="icon"
>
{% endif %}

</a>
{% endif %}


<!-- GUARANTEE -->

{% if section.settings.guarantee_text != blank %}
<div class="study-guarantee">

{% if section.settings.guarantee_icon != blank %}
<img
src="{{ section.settings.guarantee_icon | image_url: width: 30 }}"
alt="icon"
>
{% endif %}

<span>{{ section.settings.guarantee_text }}</span>

</div>
{% endif %}

</div>



<!-- RIGHT IMAGE -->

<div class="study-right">

{% if section.settings.chart_image != blank %}
<img
src="{{ section.settings.chart_image | image_url: width: 900 }}"
alt="Study chart"
>
{% endif %}

</div>

</div>

</section>



<style>

#shopify-section-{{ section.id }} .study-evidence{
background:#cfd6e1;
padding:80px 40px;
}

#shopify-section-{{ section.id }} .study-container{
max-width:1300px;
margin:auto;
display:flex;
align-items:center;
gap:80px;
}

/* LEFT */

#shopify-section-{{ section.id }} .study-left{
flex:1;
}

/* BADGE */

#shopify-section-{{ section.id }} .study-badge{
display:inline-block;
border:1px solid #2e4f82;
padding:6px 14px;
border-radius:20px;
font-size:13px;
margin-bottom:20px;
}

/* TITLE */

#shopify-section-{{ section.id }} .study-title{
font-size:46px;
margin-bottom:18px;
color:#0c2c55;
}

#shopify-section-{{ section.id }} .study-desc{
margin-bottom:35px;
color:#2b3d55;
}

/* STATS */

#shopify-section-{{ section.id }} .study-stats{
display:flex;
align-items:flex-start;
gap:40px;
margin-bottom:35px;
}

#shopify-section-{{ section.id }} .stat-item h3{
font-size:64px;
margin-bottom:8px;
color:#2e4f82;
}

#shopify-section-{{ section.id }} .stat-divider{
width:1px;
background:#a8b2c1;
height:90px;
}

/* BUTTON */

#shopify-section-{{ section.id }} .study-btn{
display:inline-flex;
align-items:center;
gap:10px;
padding:18px 40px;
background:#345b93;
color:#fff;
border-radius:40px;
text-decoration:none;
font-weight:600;
margin-top:10px;
}

#shopify-section-{{ section.id }} .study-btn img{
width:20px;
}

/* GUARANTEE */

#shopify-section-{{ section.id }} .study-guarantee{
display:flex;
align-items:center;
gap:8px;
margin-top:16px;
font-size:15px;
}

#shopify-section-{{ section.id }} .study-guarantee img{
width:18px;
}

/* RIGHT IMAGE */

#shopify-section-{{ section.id }} .study-right{
flex:1;
}

#shopify-section-{{ section.id }} .study-right img{
width:100%;
border-radius:30px;
}

/* MOBILE */

@media(max-width:900px){

#shopify-section-{{ section.id }} .study-container{
flex-direction:column;
}

#shopify-section-{{ section.id }} .study-title{
font-size:34px;
}

}

</style>



{% schema %}
{
"name":"Study Evidence Section",

"settings":[

{
"type":"text",
"id":"badge",
"label":"Badge",
"default":"BACKED BY 700+ STUDIES"
},

{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Results Start With Evidence"
},

{
"type":"textarea",
"id":"description",
"label":"Description"
},

{
"type":"text",
"id":"stat1_number",
"label":"Stat 1 Number",
"default":"77%"
},

{
"type":"textarea",
"id":"stat1_text",
"label":"Stat 1 Text"
},

{
"type":"text",
"id":"stat2_number",
"label":"Stat 2 Number",
"default":"700+"
},

{
"type":"textarea",
"id":"stat2_text",
"label":"Stat 2 Text"
},

{
"type":"text",
"id":"button_text",
"label":"Button Text",
"default":"TRY OMNI TODAY"
},

{
"type":"url",
"id":"button_link",
"label":"Button Link"
},

{
"type":"image_picker",
"id":"button_icon",
"label":"Button Icon"
},

{
"type":"image_picker",
"id":"guarantee_icon",
"label":"Guarantee Icon"
},

{
"type":"text",
"id":"guarantee_text",
"label":"Guarantee Text",
"default":"30-day money-back guarantee"
},

{
"type":"image_picker",
"id":"chart_image",
"label":"Chart Image"
}

],

"presets":[
{
"name":"Study Evidence Section"
}
]

}
{% endschema %}