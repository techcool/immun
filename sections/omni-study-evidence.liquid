<section class="evidence-results">

  <div class="evidence-results__container">

    <!-- LEFT CONTENT -->
    <div class="evidence-results__left">

      {% if section.settings.badge != blank %}
        <div class="evidence-results__badge">
          {{ section.settings.badge }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="evidence-results__title">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="evidence-results__desc">
          {{ section.settings.description }}
        </p>
      {% endif %}

      <!-- STATS -->
      <div class="evidence-results__stats">

        <div class="stat">
          <h3>{{ section.settings.stat1_number }}</h3>
          <p>{{ section.settings.stat1_text }}</p>
        </div>

        <div class="divider"></div>

        <div class="stat">
          <h3>{{ section.settings.stat2_number }}</h3>
          <p>{{ section.settings.stat2_text }}</p>
        </div>

      </div>

      <!-- BUTTON -->
      {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="evidence-results__btn">

        <span>{{ section.settings.button_text }}</span>

        {% if section.settings.button_icon != blank %}
        <img
          src="{{ section.settings.button_icon | image_url: width: 40 }}"
          alt="{{ section.settings.button_text }}"
          loading="lazy"
        >
        {% endif %}

      </a>
      {% endif %}

      <!-- GUARANTEE -->
      {% if section.settings.guarantee_text != blank %}
      <div class="evidence-results__guarantee">

        {% if section.settings.guarantee_icon != blank %}
        <img
          src="{{ section.settings.guarantee_icon | image_url: width: 30 }}"
          alt="Guarantee"
          loading="lazy"
        >
        {% endif %}

        <span>{{ section.settings.guarantee_text }}</span>

      </div>
      {% endif %}

    </div>


    <!-- RIGHT IMAGE -->
    <div class="evidence-results__right">

      {% if section.settings.chart_image != blank %}
      <img
        src="{{ section.settings.chart_image | image_url: width: 900 }}"
        alt="Study Chart"
        loading="lazy"
      >
      {% endif %}

    </div>

  </div>

</section>


<style>

#shopify-section-{{ section.id }} .evidence-results{
  background:#cfd6e1;
  padding:80px 40px;
}

#shopify-section-{{ section.id }} .evidence-results__container{
  max-width:1300px;
  margin:auto;
  display:flex;
  align-items:center;
  gap:80px;
}

.evidence-results__left{
  flex:1;
}

.evidence-results__right{
  flex:1;
}

.evidence-results__right img{
  width:100%;
  border-radius:28px;
}

/* BADGE */

.evidence-results__badge{
  display:inline-block;
  border:1px solid #2e4f82;
  padding:6px 14px;
  border-radius:20px;
  font-size:13px;
  margin-bottom:20px;
}

/* TITLE */

.evidence-results__title{
  font-size:46px;
  margin-bottom:18px;
  color:#0c2c55;
}

/* DESCRIPTION */

.evidence-results__desc{
  color:#2b3d55;
  margin-bottom:35px;
}

/* STATS */

.evidence-results__stats{
  display:flex;
  gap:40px;
  margin-bottom:35px;
}

.stat h3{
  font-size:64px;
  color:#2e4f82;
}

.divider{
  width:1px;
  background:#a8b2c1;
}

/* BUTTON */

.evidence-results__btn{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:18px 40px;
  background:#345b93;
  color:#fff;
  border-radius:40px;
  text-decoration:none;
  font-weight:600;
}

.evidence-results__btn img{
  width:20px;
}

/* GUARANTEE */

.evidence-results__guarantee{
  display:flex;
  align-items:center;
  gap:8px;
  margin-top:16px;
}

.evidence-results__guarantee img{
  width:18px;
}

/* MOBILE */

@media(max-width:900px){

  #shopify-section-{{ section.id }} .evidence-results__container{
    flex-direction:column;
    gap:40px;
  }

  .evidence-results__title{
    font-size:34px;
  }

}

</style>


{% schema %}
{
  "name": "Evidence Results",
  "settings": [

    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "BACKED BY 700+ STUDIES"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Results Start With Evidence"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },

    {
      "type": "text",
      "id": "stat1_number",
      "label": "Stat 1 Number",
      "default": "77%"
    },

    {
      "type": "textarea",
      "id": "stat1_text",
      "label": "Stat 1 Text"
    },

    {
      "type": "text",
      "id": "stat2_number",
      "label": "Stat 2 Number",
      "default": "700+"
    },

    {
      "type": "textarea",
      "id": "stat2_text",
      "label": "Stat 2 Text"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "TRY OMNI TODAY"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },

    {
      "type": "image_picker",
      "id": "button_icon",
      "label": "Button Icon"
    },

    {
      "type": "image_picker",
      "id": "guarantee_icon",
      "label": "Guarantee Icon"
    },

    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Text",
      "default": "30-day money-back guarantee"
    },

    {
      "type": "image_picker",
      "id": "chart_image",
      "label": "Chart Image"
    }

  ],

  "presets": [
    {
      "name": "Evidence Results"
    }
  ]
}
{% endschema %}