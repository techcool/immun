{% comment %}
  Press / Media Testimonials Carousel
  - Shows centre slide full + partial slides on each side (½ + 1 + ½)
  - Infinite loop (clone-based)
  - Autoplay
  - Touch / swipe support
  - Keyboard navigation
{% endcomment %}





<section
  class="pc"
  id="pc-{{ section.id }}"
  aria-label="{{ section.settings.section_aria_label | default: 'Press mentions' }}"
>
  <div class="pc__viewport">
    <div class="pc__track" id="pcTrack-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <div class="pc__slide" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <blockquote class="pc__quote">{{ block.settings.quote | escape }}</blockquote>
            <div class="pc__pub">
              {% if block.settings.logo != blank %}
                <img
                  src="{{ block.settings.logo | img_url: '360x120', crop: 'center' }}"
                  alt="{{ block.settings.pub_name | escape }}"
                  class="pc__logo"
                  loading="lazy"
                >
              {% else %}
                <span class="pc__pub-name">{{ block.settings.pub_name }}</span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {%- assign block_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'item' -%}{%- assign block_count = block_count | plus: 1 -%}{%- endif -%}
  {%- endfor -%}


  {% if block_count > 1 %}
    <button class="pc__btn pc__btn--prev" aria-label="Previous" data-id="{{ section.id }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 8 8 12 12 16"/>
        <line x1="16" y1="12" x2="8" y2="12"/>
      </svg>
    </button>
    <button class="pc__btn pc__btn--next" aria-label="Next" data-id="{{ section.id }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 16 16 12 12 8"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
      </svg>
    </button>


    <div class="pc__dots" role="tablist">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <button
            class="pc__dot{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-label="Slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-i="{{ forloop.index0 }}"
            data-id="{{ section.id }}"
          ></button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

<style>
#pc-{{ section.id }} {
  --pc-bg:          {{ section.settings.bg_color }};
  --pc-quote-color: {{ section.settings.quote_color }};
  --pc-pub-color:   {{ section.settings.pub_color }};
  --pc-btn-border:  {{ section.settings.btn_border }};
  --pc-btn-fg:      {{ section.settings.btn_fg }};
  --pc-btn-bg:      {{ section.settings.btn_bg }};
  --pc-dot-off:     {{ section.settings.dot_off }};
  --pc-dot-on:      {{ section.settings.dot_on }};
  --pc-pt:          {{ section.settings.padding_top }}px;
  --pc-pb:          {{ section.settings.padding_bottom }}px;
  /* 66.6667% = 1 full centre slide + ½ visible on each side */
  --pc-slide-w:     66.6667%;
}


@media (max-width: 767px) {
  #pc-{{ section.id }} { --pc-slide-w: 80%; }
}

.pc {
  position: relative;
  background: var(--pc-bg);
  padding: var(--pc-pt) 0 var(--pc-pb);
  overflow: hidden;

}

/* Viewport clips overflow */
.pc__viewport {
  overflow: hidden;
  width: 100%;
}

/* Track: offset left so first slide is centred */
.pc__track {
  display: flex;
  will-change: transform;
  margin-left: calc((100% - var(--pc-slide-w)) / 2);
}


/* Slide */
.pc__slide {
  flex: 0 0 var(--pc-slide-w);
  min-width: var(--pc-slide-w);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 20px;
  padding: 0 48px;
  text-align: center;
  box-sizing: border-box;
  opacity: 0.3;
  transition: opacity 0.45s ease;
}

.pc__slide.is-active {
  opacity: 1;
}

/* Quote */
.pc__quote {
  margin: 0;
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: clamp(13px, 1.4vw, 15.5px);
  color: var(--pc-quote-color);
  line-height: 1.72;
  max-width: 380px;
}

/* Publication */
.pc__pub {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56px;
}

.pc__logo {
  max-width: 160px;
  max-height: 56px;
  width: auto;
  height: auto;
  object-fit: contain;
}

.pc__pub-name {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(26px, 3.2vw, 40px);
  font-weight: 700;
  font-style: italic;
  letter-spacing: -0.02em;
  color: var(--pc-pub-color);
  line-height: 1;
}


/* Arrow buttons */
.pc__btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1.5px solid var(--pc-btn-border);
  background: var(--pc-btn-bg);
  color: var(--pc-btn-fg);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  padding: 0;
  transition: background 0.2s ease, border-color 0.2s ease;
}
.pc__btn:hover {
  background: #f2f2f2;
  border-color: #000;
}
.pc__btn--prev { left: 20px; }
.pc__btn--next { right: 20px; }

@media (max-width: 767px) {
  .pc__btn--prev { left: 6px; }
  .pc__btn--next { right: 6px; }
}


/* Dots */
.pc__dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 28px;
}

.pc__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  padding: 0;
  cursor: pointer;
  background: var(--pc-dot-off);
  transition: background 0.25s, transform 0.25s;
}
.pc__dot.is-active {
  background: var(--pc-dot-on);
  transform: scale(1.3);
}
</style>


<script>
(function () {
  var ID    = '{{ section.id }}';
  var SPEED = {{ section.settings.autoplay_speed }} * 1000;
  var AUTO  = {{ section.settings.autoplay | json }};
  var CLONE = 3; /* clones on each side */

  var track = document.getElementById('pcTrack-' + ID);
  if (!track) return;

  var orig  = Array.from(track.querySelectorAll('.pc__slide'));
  var total = orig.length;
  if (total < 2) { orig[0] && orig[0].classList.add('is-active'); return; }

  /* ── Clone for infinite loop ── */
  for (var p = total - CLONE; p < total; p++) {
    var cp = orig[p].cloneNode(true);
    cp.setAttribute('aria-hidden', 'true');
    cp.removeAttribute('data-index');
    track.insertBefore(cp, track.firstChild);
  }
  for (var a = 0; a < CLONE; a++) {
    var ca = orig[a].cloneNode(true);
    ca.setAttribute('aria-hidden', 'true');
    ca.removeAttribute('data-index');
    track.appendChild(ca);
  }

  var all     = Array.from(track.querySelectorAll('.pc__slide'));
  var cur     = CLONE; /* start at first real slide */
  var moving  = false;
  var timer;

  function sw() { return all[0].offsetWidth; }

  function move(idx, anim) {
    track.style.transition = anim !== false
      ? 'transform 0.55s cubic-bezier(0.4,0,0.2,1)'
      : 'none';
    track.style.transform = 'translateX(-' + (sw() * idx) + 'px)';
  }

  function activate() {
    all.forEach(function (s) { s.classList.remove('is-active'); });
    all[cur].classList.add('is-active');

    var ri   = (cur - CLONE + total) % total;
    var dots = document.querySelectorAll('.pc__dot[data-id="' + ID + '"]');
    dots.forEach(function (d, i) {
      var on = (i === ri);
      d.classList.toggle('is-active', on);
      d.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  function jump(idx) {
    move(idx, false);
    track.offsetHeight; /* force reflow */
  }

  function goTo(idx, anim) {
    cur = idx;
    move(cur, anim);
    activate();
  }

  function step(dir) {
    if (moving) return;
    moving = true;
    goTo(cur + dir, true);
  }

  track.addEventListener('transitionend', function () {
    moving = false;
    if (cur < CLONE) {
      cur += total;
      jump(cur);
      activate();
    } else if (cur >= CLONE + total) {
      cur -= total;
      jump(cur);
      activate();
    }
  });





  /* Buttons */
  var btnP = document.querySelector('.pc__btn--prev[data-id="' + ID + '"]');
  var btnN = document.querySelector('.pc__btn--next[data-id="' + ID + '"]');
  if (btnP) btnP.addEventListener('click', function () { resetAuto(); step(-1); });
  if (btnN) btnN.addEventListener('click', function () { resetAuto(); step(1);  });

  /* Dots */
  document.querySelectorAll('.pc__dot[data-id="' + ID + '"]').forEach(function (d) {
    d.addEventListener('click', function () {
      if (moving) return;
      resetAuto();
      goTo(parseInt(d.dataset.i, 10) + CLONE, true);
    });
  });

  
  /* Touch / swipe */
  var tx0 = 0;
  track.addEventListener('touchstart', function (e) { tx0 = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', function (e) {
    var diff = tx0 - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) { resetAuto(); step(diff > 0 ? 1 : -1); }
  }, { passive: true });

  /* Keyboard */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowLeft')  { resetAuto(); step(-1); }
    if (e.key === 'ArrowRight') { resetAuto(); step(1);  }
  });

  /* Autoplay */
  function startAuto() {
    if (!AUTO) return;
    timer = setInterval(function () { step(1); }, SPEED);
  }
  function resetAuto() { clearInterval(timer); startAuto(); }

  /* Resize: recalculate position without animation */
  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () { jump(cur); }, 100);
  });

  /* Init */
  jump(cur);
  activate();
  startAuto();
})();
</script>




{% schema %}
{
  "name": "Press Carousel",
  "tag": "section",
  "class": "shopify-section--press-carousel",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "pub_color",
      "label": "Publication name",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Arrow buttons"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_border",
      "label": "Border",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "btn_fg",
      "label": "Icon color",
      "default": "#2b2b2b"
    },
    {
      "type": "header",
      "content": "Dots"
    },
    {
      "type": "color",
      "id": "dot_on",
      "label": "Active dot",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "dot_off",
      "label": "Inactive dot",
      "default": "#c0c0c0"
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Speed",
      "min": 2, "max": 12, "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "text",
      "id": "section_aria_label",
      "label": "Accessibility label",
      "default": "Press mentions"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Press item",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "\"A multivitamin that doesn't taste bad? Count us in.\""
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Publication logo (optional)"
        },
        {
          "type": "text",
          "id": "pub_name",
          "label": "Publication name (shown when no logo)",
          "default": "theSkimm'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Carousel",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "quote": "\"Of all the gummies, there's only one that I liked enough to recommend — Grüns superfood gummies.\"",
            "pub_name": "pétit"
          }
        },
        {
          "type": "item",
          "settings": {
            "quote": "\"A multivitamin that doesn't taste bad? Count us in.\"",
            "pub_name": "theSkimm'"
          }
        },
        {
          "type": "item",
          "settings": {
            "quote": "\"If you know you're not getting all of the nutrients you need, consider adding Grüns.\"",
            "pub_name": "GLA"
          }
        }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}