<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">

{% style %}

.section-{{ section.id }}{
padding-top:{{ section.settings.padding_top }}px;
padding-bottom:{{ section.settings.padding_bottom }}px;
background:#f7f7f7;
position:relative;
}

.gruns-testimonial .page-width{
max-width:1200px;
margin:auto;
padding:0 20px;
}

.gruns-testimonial .owl-stage-outer{
overflow:visible;
}

/* Testimonial Card */

.gruns-testimonial .testimonial-item{
background:#fff;
padding:50px 40px;
border-radius:16px;
box-shadow:0 15px 40px rgba(0,0,0,0.08);
transition:all .4s ease;
text-align:center;
}

/* Quote */

.gruns-testimonial .testimonial-text{
font-size:18px;
line-height:1.6;
color:#555;
margin-bottom:25px;
font-style:italic;
}

/* Logo */

.gruns-testimonial .testimonial-logo img{
max-width:140px;
margin:auto;
}

.gruns-testimonial .owl-item{
opacity:.4;
transform:scale(.85);
transition:all .4s ease;
}

.gruns-testimonial .owl-item.active{
opacity:.6;
transform:scale(.9);
}

.gruns-testimonial .owl-item.active.center{
opacity:1;
transform:scale(1.08);
z-index:2;
}

/* Center Card Style */


/* Navigation */

.section-{{ section.id }} .owl-nav{
position:absolute;
top:45%;
width:100%;
}

.section-{{ section.id }} .owl-nav button{
width:48px;
height:48px;
border-radius:50%;
border:2px solid #0f3d2e!important;
background:#fff!important;
color:#0f3d2e!important;
font-size:20px;
transition:.3s;
}

.section-{{ section.id }} .owl-nav button:hover{
background:#0f3d2e!important;
color:#fff!important;
}

.section-{{ section.id }} .owl-prev{
position:absolute;
left:-60px;
}

.section-{{ section.id }} .owl-next{
position:absolute;
right:-60px;
}

/* Dots */

.section-{{ section.id }} .owl-dots{
margin-top:35px;
text-align:center;
}

.section-{{ section.id }} .owl-dot span{
width:10px;
height:10px;
background:#ccc!important;
}

.section-{{ section.id }} .owl-dot.active span{
background:#0f3d2e!important;
}
.gruns-testimonial .page-width{
    overflow: hidden;
}
/* Responsive */

@media(max-width:991px){

.section-{{ section.id }} .testimonial-item{
padding:35px;
}

.section-{{ section.id }} .owl-prev{
left:-20px;
}

.section-{{ section.id }} .owl-next{
right:-20px;
}

}

@media(max-width:600px){

.section-{{ section.id }} .testimonial-text{
font-size:16px;
}

}

{% endstyle %}


<section class="custom-testimonials section-{{ section.id }} {{ section.settings.custom_class }}">

<div class="page-width">

<div class="owl-carousel testimonial-slider-{{ section.id }}">

{% for block in section.blocks %}

<div class="testimonial-item">

<div class="testimonial-text">
{{ block.settings.quote }}
</div>

<div class="testimonial-logo">
{% if block.settings.logo != blank %}
<img src="{{ block.settings.logo | image_url: width:300 }}">
{% endif %}
</div>

</div>

{% endfor %}

</div>

</div>

</section>


<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>


<script>

$(document).ready(function(){

$('.testimonial-slider-{{ section.id }}').owlCarousel({

loop:true,
margin:30,
nav:true,
dots:true,
center:true,
items:1,
stagePadding:400,
autoplay:false,
autoplayTimeout:4000,
smartSpeed:700,

navText:[
'<span>&larr;</span>',
'<span>&rarr;</span>'
],

responsive:{

0:{
items:1,
stagePadding:30
},

600:{
items:1,
stagePadding:120
},

1000:{
items:1,
stagePadding:400
}

}

});

});

</script>


{% schema %}
{
"name": "Testimonial Owl Slider",
"settings": [
{
"type": "text",
"id": "custom_class",
"label": "Custom Class"
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 200,
"step": 10,
"default": 80,
"label": "Padding Top"
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 200,
"step": 10,
"default": 80,
"label": "Padding Bottom"
}
],
"blocks":[
{
"type":"testimonial",
"name":"Testimonial",
"settings":[
{
"type":"textarea",
"id":"quote",
"label":"Quote Text"
},
{
"type":"image_picker",
"id":"logo",
"label":"Logo"
}
]
}
],
"presets":[
{
"name":"Testimonial Owl Slider"
}
]
}
{% endschema %}