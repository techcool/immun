<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">

<style>
.section-{{ section.id }}{
  padding:80px 20px;
  background:#f5f5f5;
  text-align:center;
}

.section-{{ section.id }} .testimonial-item{
  max-width:700px;
  margin:auto;
}

.section-{{ section.id }} .testimonial-text{
  font-size:18px;
  margin-bottom:20px;
  color:#555;
}

.section-{{ section.id }} .testimonial-logo img{
  max-width:160px;
  margin:auto;
}

.section-{{ section.id }} .owl-nav button{
  width:45px;
  height:45px;
  border:2px solid #0f3d2e!important;
  border-radius:50%;
  color:#0f3d2e!important;
}

.section-{{ section.id }} .owl-nav{
  position:absolute;
  width:100%;
  top:40%;
}

.section-{{ section.id }} .owl-prev{
  position:absolute;
  left:-60px;
}

.section-{{ section.id }} .owl-next{
  position:absolute;
  right:-60px;
}

.section-{{ section.id }} .owl-dots{
  margin-top:20px;
}
</style>

<div class="section-{{ section.id }}">
  
  <div class="owl-carousel testimonial-slider-{{ section.id }}">
    
    {% for block in section.blocks %}
    
    <div class="testimonial-item">

      <div class="testimonial-text">
        {{ block.settings.quote }}
      </div>

      <div class="testimonial-logo">
        {% if block.settings.logo != blank %}
        <img src="{{ block.settings.logo | image_url: width:300 }}">
        {% endif %}
      </div>

    </div>

    {% endfor %}
    
  </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>

<script>
$(document).ready(function(){

$('.testimonial-slider-{{ section.id }}').owlCarousel({
    loop:true,
    margin:20,
    nav:true,
    dots:true,
    items:2.5,
    autoplay:true,
    autoplayTimeout:4000,
    navText:[
      '<span>&larr;</span>',
      '<span>&rarr;</span>'
    ]
});

});
</script>


{% schema %}
{
  "name": "Testimonial Owl Slider",
  "settings": [],
  "blocks":[
    {
      "type":"testimonial",
      "name":"Slide",
      "settings":[
        {
          "type":"textarea",
          "id":"quote",
          "label":"Quote Text"
        },
        {
          "type":"image_picker",
          "id":"logo",
          "label":"Logo"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"Testimonial Owl Slider"
    }
  ]
}
{% endschema %}