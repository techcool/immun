{{ 'section-gruns-product.css' | asset_url | stylesheet_tag }}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'gruns-product-form-' | append: section.id -%}

<div class="gruns-product" data-section-id="{{ section.id }}">

  {%- if section.settings.show_promo_banner -%}
  <div class="gruns-promo-banner">
    <h2>{{ section.settings.promo_heading }}</h2>
    <p>{{ section.settings.promo_subtext }}</p>
  </div>
  {%- endif -%}

  <div class="gruns-product__inner">

    {%- comment -%} ── GALLERY ── {%- endcomment -%}
    <div class="gruns-gallery">
      <div class="gruns-gallery__thumbs" id="GrunsGalleryThumbs-{{ section.id }}">
        {%- for media in product.media -%}
        <button
          class="gruns-gallery__thumb {% if forloop.first %}active{% endif %}"
          data-media-id="{{ media.id }}"
          aria-label="{{ media.alt | escape }}"
          type="button">
          {{- media | image_url: width: 144 | image_tag: loading: 'lazy', class: 'gruns-gallery__thumb-img' -}}
        </button>
        {%- endfor -%}
      </div>

      <div class="gruns-gallery__main" id="GrunsGalleryMain-{{ section.id }}">
        <div class="gruns-gallery__badge">
          🔥 {{ section.settings.gallery_badge_text }} 🔥
        </div>

        {%- for media in product.media -%}
        <div
          class="gruns-gallery__slide {% if forloop.first %}active{% endif %}"
          data-media-id="{{ media.id }}">
          {%- if media.media_type == 'image' -%}
            {{ media | image_url: width: 900 | image_tag:
              loading: 'lazy',
              class: 'gruns-gallery__img',
              widths: '400, 600, 800, 900',
              sizes: '(max-width: 768px) 100vw, 50vw'
            }}
          {%- elsif media.media_type == 'video' -%}
            {{ media | video_tag: autoplay: false, loop: true, muted: true, controls: true, class: 'gruns-gallery__video' }}
          {%- endif -%}
        </div>
        {%- endfor -%}

        <div class="gruns-gallery__benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit_pill' -%}
            <div class="gruns-benefit-pill" {{ block.shopify_attributes }}>
              <span class="gruns-benefit-pill__icon">{{ block.settings.icon }}</span>
              {{ block.settings.label }}
            </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} ── PRODUCT FORM ── {%- endcomment -%}
    <div class="gruns-form-col">

      {%- if section.settings.show_reviews -%}
      <div class="gruns-reviews-row">
        <span class="gruns-stars">★★★★★</span>
        <span class="gruns-rating">{{ section.settings.review_score }}</span>
        <span class="gruns-review-count">
          ({{ section.settings.review_count }}) · {{ section.settings.customer_count }} Customers
        </span>
      </div>
      {%- endif -%}

      <h1 class="gruns-product__title">{{ product.title }}</h1>
      <p class="gruns-product__subtitle">{{ product.description | strip_html | truncate: 160 }}</p>

      <ul class="gruns-benefit-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit_item' -%}
          <li class="gruns-benefit-item" {{ block.shopify_attributes }}>
            <span class="gruns-check">✓</span>
            {{ block.settings.text }}
          </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <hr class="gruns-divider">

      {%- comment -%} PRODUCT FORM {%- endcomment -%}
      {%- form 'product', product, id: product_form_id, class: 'gruns-product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}

        <input type="hidden" name="id" value="{{ current_variant.id }}" id="GrunsVariantInput-{{ section.id }}">

        {%- comment -%} ── VARIANTS / OPTIONS ── {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}

          {%- for option in product.options_with_values -%}
          <div class="gruns-option" data-option-index="{{ forloop.index0 }}">

            {%- assign option_name_lower = option.name | downcase -%}

            <div class="gruns-option__label">
              {{ option.name }}:
              <span class="gruns-option__selected" id="GrunsOptionSelected-{{ section.id }}-{{ forloop.index0 }}">
                {{ option.selected_value }}
              </span>
            </div>

            {%- if option_name_lower == 'flavor' or option_name_lower == 'flavour' -%}
              {%- comment -%} Flavor – image swatch style {%- endcomment -%}
              <div class="gruns-flavor-grid">
                {%- for value in option.values -%}
                  {%- assign variant_for_value = product.variants | where: 'option1', value | first -%}
                  <label
                    class="gruns-flavor-option {% if option.selected_value == value %}selected{% endif %}"
                    for="GrunsOpt-{{ section.id }}-{{ forloop.index0 }}-{{ value | handleize }}">
                    <input
                      type="radio"
                      id="GrunsOpt-{{ section.id }}-{{ forloop.index0 }}-{{ value | handleize }}"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                      class="gruns-swatch-radio visually-hidden"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                    >
                    <span class="gruns-flavor-swatch">
                      {%- if variant_for_value.featured_media -%}
                        {{ variant_for_value.featured_media | image_url: width: 128 | image_tag: loading: 'lazy', class: 'gruns-swatch-img' }}
                      {%- else -%}
                        {{ value | slice: 0 }}
                      {%- endif -%}
                    </span>
                    <span class="gruns-flavor-name">{{ value }}</span>
                    {%- if value contains 'New' or value contains 'new' -%}
                      <span class="gruns-flavor-new">NEW</span>
                    {%- endif -%}
                  </label>
                {%- endfor -%}
              </div>

            {%- elsif option_name_lower == 'sugar' or option_name_lower == 'sugar level' -%}
              {%- comment -%} Sugar – pill button style {%- endcomment -%}
              <div class="gruns-sugar-grid">
                {%- for value in option.values -%}
                  <label
                    class="gruns-sugar-option {% if option.selected_value == value %}selected{% endif %}"
                    for="GrunsOpt-{{ section.id }}-{{ forloop.index0 }}-{{ value | handleize }}">
                    <input
                      type="radio"
                      id="GrunsOpt-{{ section.id }}-{{ forloop.index0 }}-{{ value | handleize }}"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                      class="gruns-swatch-radio visually-hidden"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                    >
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>

            {%- elsif option_name_lower == 'quantity' or option_name_lower == 'pack' -%}
              {%- comment -%} Quantity option – number tile style {%- endcomment -%}
              <div class="gruns-qty-header">
                <span class="gruns-qty-badge">💰 Buy 2 Save 9%</span>
              </div>
              <div class="gruns-qty-grid">
                {%- for value in option.values -%}
                  <label
                    class="gruns-qty-option {% if option.selected_value == value %}selected{% endif %}"
                    for="GrunsOpt-{{ section.id }}-{{ forloop.index0 }}-{{ value | handleize }}">
                    <input
                      type="radio"
                      id="GrunsOpt-{{ section.id }}-{{ forloop.index0 }}-{{ value | handleize }}"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                      class="gruns-swatch-radio visually-hidden"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                    >
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>

            {%- else -%}
              {%- comment -%} Generic option – pill buttons {%- endcomment -%}
              <div class="gruns-generic-grid">
                {%- for value in option.values -%}
                  <label
                    class="gruns-generic-option {% if option.selected_value == value %}selected{% endif %}"
                    for="GrunsOpt-{{ section.id }}-{{ forloop.index0 }}-{{ value | handleize }}">
                    <input
                      type="radio"
                      id="GrunsOpt-{{ section.id }}-{{ forloop.index0 }}-{{ value | handleize }}"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}checked{% endif %}
                      class="gruns-swatch-radio visually-hidden"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-value="{{ value | escape }}"
                    >
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>
            {%- endif -%}

          </div>{%- comment -%} /gruns-option {%- endcomment -%}
          {%- endfor -%}

        {%- endunless -%}

        {%- comment -%} ── SELLING PLAN (Subscribe & Save) ── {%- endcomment -%}
        {%- if product.selling_plan_groups.size > 0 -%}
        <div class="gruns-option">
          <div class="gruns-option__label">Select Offer</div>
          <div class="gruns-offer-cards" id="GrunsOfferCards-{{ section.id }}">

            {%- for group in product.selling_plan_groups -%}
              {%- for plan in group.selling_plans -%}
              <label
                class="gruns-offer-card {% if forloop.first and forloop.parentloop.first %}selected{% endif %}"
                for="GrunsPlan-{{ section.id }}-{{ plan.id }}">
                {%- if forloop.first and forloop.parentloop.first -%}
                  <span class="gruns-offer-popular">MOST POPULAR: GET 49% OFF</span>
                {%- endif -%}
                <input
                  type="radio"
                  id="GrunsPlan-{{ section.id }}-{{ plan.id }}"
                  name="selling_plan"
                  value="{{ plan.id }}"
                  class="visually-hidden gruns-plan-radio"
                  {% if forloop.first and forloop.parentloop.first %}checked{% endif %}
                >
                <div class="gruns-offer-header">
                  <span class="gruns-offer-radio"><span class="gruns-offer-radio-dot"></span></span>
                  <span class="gruns-offer-title">{{ plan.name }}</span>
                  <div class="gruns-offer-price-wrap">
                    <span class="gruns-offer-price" data-plan-price="{{ plan.id }}">
                      {%- assign price_after = current_variant.price -%}
                      {%- for adjustment in plan.price_adjustments -%}
                        {%- if adjustment.value_type == 'percentage' -%}
                          {%- assign price_after = current_variant.price | times: adjustment.value | divided_by: 100 | minus: current_variant.price | abs -%}
                          {%- assign price_after = current_variant.price | minus: price_after -%}
                        {%- elsif adjustment.value_type == 'fixed_amount' -%}
                          {%- assign price_after = current_variant.price | minus: adjustment.value -%}
                        {%- elsif adjustment.value_type == 'price' -%}
                          {%- assign price_after = adjustment.value -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {{ price_after | money }}
                    </span>
                    <span class="gruns-offer-price-old">{{ current_variant.compare_at_price | money }}</span>
                  </div>
                </div>
                <p class="gruns-offer-sub">{{ plan.description }}</p>
                {%- if forloop.first and forloop.parentloop.first -%}
                <div class="gruns-offer-perks">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'subscription_perk' -%}
                    <div class="gruns-offer-perk" {{ block.shopify_attributes }}>
                      <span class="gruns-perk-check">✓</span> {{ block.settings.text }}
                    </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- endif -%}
              </label>
              {%- endfor -%}
            {%- endfor -%}

            {%- comment -%} One-time purchase option {%- endcomment -%}
            <label class="gruns-offer-card" for="GrunsPlan-{{ section.id }}-onetime">
              <input
                type="radio"
                id="GrunsPlan-{{ section.id }}-onetime"
                name="selling_plan"
                value=""
                class="visually-hidden gruns-plan-radio"
              >
              <div class="gruns-offer-header">
                <span class="gruns-offer-radio"><span class="gruns-offer-radio-dot"></span></span>
                <span class="gruns-offer-title">One Time Purchase</span>
                <div class="gruns-offer-price-wrap">
                  <span class="gruns-offer-price" id="GrunsOnetimePrice-{{ section.id }}">
                    {{ current_variant.price | money }}
                  </span>
                  <span class="gruns-offer-price-old">{{ current_variant.compare_at_price | money }}</span>
                </div>
              </div>
              <p class="gruns-offer-sub">28 packs delivered once</p>
            </label>

          </div>
        </div>
        {%- else -%}
          {%- comment -%} No selling plans — show price only {%- endcomment -%}
          <div class="gruns-price-row">
            <span class="gruns-price" id="GrunsPrice-{{ section.id }}">{{ current_variant.price | money }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="gruns-price-old">{{ current_variant.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} ── ADD TO CART ── {%- endcomment -%}
        <button
          type="submit"
          name="add"
          class="gruns-btn-cta"
          id="GrunsAddToCart-{{ section.id }}"
          {% unless current_variant.available %}disabled{% endunless %}>
          <span class="gruns-btn-cta__text">
            {%- if current_variant.available -%}
              {{ section.settings.cta_label | default: 'Start Now' }}
            {%- else -%}
              Sold Out
            {%- endif -%}
          </span>
          <span class="gruns-btn-cta__spinner" style="display:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
          </span>
        </button>

      {%- endform -%}

      {%- if section.settings.show_discount_badge -%}
      <div class="gruns-discount-applied">
        ✅ {{ section.settings.discount_badge_text | default: 'Limited Time Discount Auto-Applied' }}
      </div>
      {%- endif -%}

      {%- comment -%} ── TRUST BADGES ── {%- endcomment -%}
      {%- if section.settings.show_trust -%}
      <div class="gruns-trust-row">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
          <div class="gruns-trust-item" {{ block.shopify_attributes }}>
            <span class="gruns-trust-icon">{{ block.settings.icon }}</span>
            <span class="gruns-trust-label">{{ block.settings.label }}</span>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- comment -%} ── ACCORDION ── {%- endcomment -%}
      <div class="gruns-accordion">
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
          <div class="gruns-accordion__item" {{ block.shopify_attributes }}>
            <button class="gruns-accordion__trigger" type="button" aria-expanded="false">
              {{ block.settings.title }}
              <span class="gruns-acc-icon" aria-hidden="true">+</span>
            </button>
            <div class="gruns-accordion__body" hidden>
              {{ block.settings.content }}
            </div>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>{%- comment -%} /gruns-form-col {%- endcomment -%}
  </div>{%- comment -%} /gruns-product__inner {%- endcomment -%}

  {%- comment -%} ── BOTTOM TASTE + PACKED SECTION ── {%- endcomment -%}
  {%- assign taste_blocks = section.blocks | where: 'type', 'taste_item' -%}
  {%- assign packed_blocks = section.blocks | where: 'type', 'packed_item' -%}
  {%- if taste_blocks.size > 0 or packed_blocks.size > 0 -%}
  <div class="gruns-bottom-section">
    <div class="gruns-bottom-inner">
      <div class="gruns-bottom-grid">

        {%- if taste_blocks.size > 0 -%}
        <div>
          <h3 class="gruns-section-heading">Tastes Like</h3>
          <div class="gruns-taste-grid">
            {%- for block in taste_blocks -%}
            <div class="gruns-taste-item" {{ block.shopify_attributes }}>
              <div class="gruns-taste-icon">{{ block.settings.icon }}</div>
              <span class="gruns-taste-name">{{ block.settings.label }}</span>
            </div>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        {%- if packed_blocks.size > 0 -%}
        <div>
          <h3 class="gruns-section-heading">Packed With</h3>
          <div class="gruns-packed-list">
            {%- for block in packed_blocks -%}
            <div class="gruns-packed-item" {{ block.shopify_attributes }}>
              <div class="gruns-packed-dot">{{ block.settings.icon }}</div>
              {{ block.settings.label }}
            </div>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

      </div>
    </div>
  </div>
  {%- endif -%}

</div>{%- comment -%} /gruns-product {%- endcomment -%}

{%- comment -%} Variant JSON for JS {%- endcomment -%}
<script type="application/json" id="GrunsVariantData-{{ section.id }}">
  {{ product.variants | json }}
</script>

{{ 'section-gruns-product.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Grüns Product",
  "tag": "section",
  "class": "gruns-product-section",
  "settings": [
    {
      "type": "header",
      "content": "Promo Banner"
    },
    {
      "type": "checkbox",
      "id": "show_promo_banner",
      "label": "Show promo banner",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Promo heading",
      "default": "Limited Time Offer! Save Up To 52% on Your First Order!"
    },
    {
      "type": "text",
      "id": "promo_subtext",
      "label": "Promo subtext",
      "default": "Use code AUTO-APPLIED at checkout · Free shipping on all orders"
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "text",
      "id": "gallery_badge_text",
      "label": "Gallery badge text",
      "default": "LIMITED TIME OFFER: SAVE UP TO 52%"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show review row",
      "default": true
    },
    {
      "type": "text",
      "id": "review_score",
      "label": "Review score",
      "default": "4.8/5.0"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "85,000"
    },
    {
      "type": "text",
      "id": "customer_count",
      "label": "Customer count text",
      "default": "1M+"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Start Now"
    },
    {
      "type": "header",
      "content": "Discount Badge"
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show discount badge",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_badge_text",
      "label": "Discount badge text",
      "default": "Limited Time Discount Auto-Applied"
    },
    {
      "type": "header",
      "content": "Trust Badges"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust badges",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "benefit_pill",
      "name": "Benefit Pill (on image)",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🌿" },
        { "type": "text", "id": "label", "label": "Label", "default": "Full-body health" }
      ]
    },
    {
      "type": "benefit_item",
      "name": "Benefit List Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Promotes mental clarity + energy" }
      ]
    },
    {
      "type": "subscription_perk",
      "name": "Subscription Perk",
      "settings": [
        { "type": "text", "id": "text", "label": "Perk text", "default": "30-Day Guarantee" }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "✓" },
        { "type": "text", "id": "label", "label": "Label (use line break with \\n)", "default": "30-day guarantee" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Why Grüns?" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add your content here.</p>" }
      ]
    },
    {
      "type": "taste_item",
      "name": "Taste Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🌿" },
        { "type": "text", "id": "label", "label": "Label", "default": "Fresh & Light" }
      ]
    },
    {
      "type": "packed_item",
      "name": "Packed With Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🥦" },
        { "type": "text", "id": "label", "label": "Label", "default": "Whole Veggies" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grüns Product",
      "blocks": [
        { "type": "benefit_pill", "settings": { "icon": "🧠", "label": "Full-body health" } },
        { "type": "benefit_pill", "settings": { "icon": "🚀", "label": "On-the-go" } },
        { "type": "benefit_pill", "settings": { "icon": "🌿", "label": "Gut health" } },
        { "type": "benefit_pill", "settings": { "icon": "⚡", "label": "Crash-free energy" } },
        { "type": "benefit_pill", "settings": { "icon": "😋", "label": "Great taste" } },
        { "type": "benefit_item", "settings": { "text": "Promotes mental clarity + energy" } },
        { "type": "benefit_item", "settings": { "text": "Supports immunity + stress relief" } },
        { "type": "benefit_item", "settings": { "text": "Supports digestion and gut health" } },
        { "type": "benefit_item", "settings": { "text": "Clinically tested for nutrient absorption" } },
        { "type": "subscription_perk", "settings": { "text": "30-Day Guarantee" } },
        { "type": "subscription_perk", "settings": { "text": "FAST & FREE Shipping" } },
        { "type": "subscription_perk", "settings": { "text": "Pause Or Cancel Any Time" } },
        { "type": "subscription_perk", "settings": { "text": "Online Exclusive" } },
        { "type": "trust_badge", "settings": { "icon": "✓", "label": "30-day guarantee" } },
        { "type": "trust_badge", "settings": { "icon": "🔬", "label": "Clinically & 3rd party tested" } },
        { "type": "trust_badge", "settings": { "icon": "💳", "label": "HSA/FSA eligible with Truemed" } },
