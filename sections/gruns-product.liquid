<script>
/**
 * section-gruns-product.js
 * Drop into: assets/section-gruns-product.js
 *
 * Handles:
 *  - Variant switching (updates price, availability, hidden input)
 *  - Gallery thumb switching
 *  - Selling plan (subscribe) selection & swatch card selection
 *  - Option swatch UI (selected class sync)
 *  - Add-to-cart via Shopify AJAX cart API
 *  - Accordion expand/collapse with animation
 */

(function () {
  'use strict';

  /* ── Utils ── */
  function qs(sel, ctx) { return (ctx || document).querySelector(sel); }
  function qsa(sel, ctx) { return [...(ctx || document).querySelectorAll(sel)]; }

  /* ══════════════════════════════════════════════════
     GrunsProduct — one instance per section
  ══════════════════════════════════════════════════ */
  class GrunsProduct {
    constructor(section) {
      this.section     = section;
      this.sectionId   = section.dataset.sectionId;
      this.form        = qs('.gruns-product-form', section);
      this.variantInput = qs(`#GrunsVariantInput-${this.sectionId}`, section);
      this.addBtn      = qs(`#GrunsAddToCart-${this.sectionId}`, section);
      this.variants    = this._parseVariants();

      this._bindGallery();
      this._bindSwatches();
      this._bindOfferCards();
      this._bindAccordions();
      this._bindAddToCart();
    }

    /* ── Variants JSON ── */
    _parseVariants() {
      const el = qs(`#GrunsVariantData-${this.sectionId}`);
      try { return el ? JSON.parse(el.textContent) : []; }
      catch (e) { return []; }
    }

    /* ── Gallery ── */
    _bindGallery() {
      const thumbs = qsa('.gruns-gallery__thumb', this.section);
      const slides = qsa('.gruns-gallery__slide', this.section);
      thumbs.forEach(thumb => {
        thumb.addEventListener('click', () => {
          const id = thumb.dataset.mediaId;
          thumbs.forEach(t => t.classList.remove('active'));
          slides.forEach(s => s.classList.remove('active'));
          thumb.classList.add('active');
          const target = slides.find(s => s.dataset.mediaId === id);
          if (target) target.classList.add('active');
        });
      });
    }

    /* ── Option Swatches ── */
    _bindSwatches() {
      const radios = qsa('.gruns-swatch-radio', this.section);
      radios.forEach(radio => {
        radio.addEventListener('change', () => {
          if (!radio.checked) return;
          const optIdx  = parseInt(radio.dataset.optionIndex, 10);
          const value   = radio.dataset.value;

          /* Update selected label span */
          const labelSpan = qs(`#GrunsOptionSelected-${this.sectionId}-${optIdx}`, this.section);
          if (labelSpan) labelSpan.textContent = value;

          /* Update selected class on parent label */
          const siblings = qsa(`.gruns-swatch-radio[data-option-index="${optIdx}"]`, this.section);
          siblings.forEach(r => {
            const lbl = r.closest('label');
            if (lbl) lbl.classList.toggle('selected', r === radio);
          });

          /* Find & activate matching variant */
          this._updateVariant();
        });
      });
    }

    /* ── Resolve current selected options → variant ── */
    _currentOptions() {
      const options = [];
      const groups = qsa('.gruns-option', this.section);
      groups.forEach(group => {
        const checked = qs('.gruns-swatch-radio:checked', group);
        if (checked) options.push(checked.dataset.value);
      });
      return options;
    }

    _updateVariant() {
      const selected = this._currentOptions();
      const match = this.variants.find(v => {
        return selected.every((val, i) => v[`option${i + 1}`] === val);
      });
      if (!match) return;

      /* Update hidden variant id */
      if (this.variantInput) this.variantInput.value = match.id;

      /* Update CTA state */
      if (this.addBtn) {
        this.addBtn.disabled = !match.available;
        const txt = qs('.gruns-btn-cta__text', this.addBtn);
        if (txt) txt.textContent = match.available ? this.addBtn.dataset.addLabel || 'Start Now' : 'Sold Out';
      }

      /* Update one-time price display */
      const otpEl = qs(`#GrunsOnetimePrice-${this.sectionId}`, this.section);
      if (otpEl && match.price) {
        otpEl.textContent = this._formatMoney(match.price);
      }

      /* Update plain price (no selling plans) */
      const priceEl = qs(`#GrunsPrice-${this.sectionId}`, this.section);
      if (priceEl && match.price) {
        priceEl.textContent = this._formatMoney(match.price);
      }

      /* Swap gallery to variant featured media */
      if (match.featured_media) {
        const mediaId = String(match.featured_media.id);
        const thumbs  = qsa('.gruns-gallery__thumb', this.section);
        const slides  = qsa('.gruns-gallery__slide', this.section);
        const matchThumb = thumbs.find(t => t.dataset.mediaId === mediaId);
        const matchSlide = slides.find(s => s.dataset.mediaId === mediaId);
        if (matchThumb && matchSlide) {
          thumbs.forEach(t => t.classList.remove('active'));
          slides.forEach(s => s.classList.remove('active'));
          matchThumb.classList.add('active');
          matchSlide.classList.add('active');
        }
      }

      /* Dispatch custom event for theme compatibility */
      this.section.dispatchEvent(new CustomEvent('gruns:variant-changed', {
        bubbles: true,
        detail: { variant: match }
      }));
    }

    /* ── Offer Card (Subscribe/One-time) ── */
    _bindOfferCards() {
      const cards = qsa('.gruns-offer-card', this.section);
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const radio = qs('input[type="radio"]', card);
          if (!radio) return;
          radio.checked = true;
          cards.forEach(c => c.classList.remove('selected'));
          card.classList.add('selected');
        });
      });
    }

    /* ── Accordion ── */
    _bindAccordions() {
      qsa('.gruns-accordion__trigger', this.section).forEach(trigger => {
        trigger.addEventListener('click', () => {
          const body    = trigger.nextElementSibling;
          const isOpen  = trigger.getAttribute('aria-expanded') === 'true';

          /* Close all */
          qsa('.gruns-accordion__trigger', this.section).forEach(t => {
            t.setAttribute('aria-expanded', 'false');
          });
          qsa('.gruns-accordion__body', this.section).forEach(b => {
            this._collapseBody(b);
          });

          /* Open clicked if it was closed */
          if (!isOpen) {
            trigger.setAttribute('aria-expanded', 'true');
            this._expandBody(body);
          }
        });
      });
    }

    _expandBody(body) {
      body.hidden = false;
      body.style.maxHeight = '0';
      body.style.overflow  = 'hidden';
      body.style.transition = 'max-height 0.35s ease';
      requestAnimationFrame(() => {
        body.style.maxHeight = body.scrollHeight + 'px';
      });
      body.addEventListener('transitionend', () => {
        body.style.maxHeight = '';
        body.style.overflow  = '';
      }, { once: true });
    }

    _collapseBody(body) {
      if (body.hidden) return;
      body.style.maxHeight = body.scrollHeight + 'px';
      body.style.overflow  = 'hidden';
      body.style.transition = 'max-height 0.3s ease';
      requestAnimationFrame(() => {
        body.style.maxHeight = '0';
      });
      body.addEventListener('transitionend', () => {
        body.hidden = true;
        body.style.maxHeight = '';
        body.style.overflow  = '';
      }, { once: true });
    }

    /* ── Add to Cart ── */
    _bindAddToCart() {
      if (!this.form) return;
      this.form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (this.addBtn.disabled) return;
        this._setLoading(true);

        const formData = new FormData(this.form);
        const body = {
          id: formData.get('id'),
          quantity: 1,
          selling_plan: formData.get('selling_plan') || undefined,
          properties: {}
        };
        /* Remove undefined keys */
        if (!body.selling_plan) delete body.selling_plan;

        try {
          const res = await fetch('/cart/add.js', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body:    JSON.stringify(body)
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            this._showToast(err.description || 'Could not add to cart.', true);
            return;
          }

          /* Success */
          this._showToast('Added to cart!');

          /* Open cart drawer / mini-cart — try common theme events */
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('theme:cart:open', { bubbles: true }));

          /* Fallback: reload Shopify cart count badge */
          this._refreshCartCount();

        } catch (err) {
          this._showToast('Network error. Please try again.', true);
        } finally {
          this._setLoading(false);
        }
      });
    }

    _setLoading(on) {
      if (!this.addBtn) return;
      const txt     = qs('.gruns-btn-cta__text', this.addBtn);
      const spinner = qs('.gruns-btn-cta__spinner', this.addBtn);
      this.addBtn.disabled = on;
      if (txt)     txt.style.display     = on ? 'none' : '';
      if (spinner) spinner.style.display = on ? 'inline-flex' : 'none';
    }

    async _refreshCartCount() {
      try {
        const r = await fetch('/cart.js', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const cart = await r.json();
        qsa('[data-cart-count], .cart-count, .cart__count').forEach(el => {
          el.textContent = cart.item_count;
        });
      } catch (_) {}
    }

    _showToast(msg, isError = false) {
      let toast = qs('#gruns-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'gruns-toast';
        Object.assign(toast.style, {
          position: 'fixed', bottom: '30px', right: '30px',
          padding: '14px 22px', borderRadius: '10px',
          fontFamily: 'var(--gp-font-body, sans-serif)',
          fontSize: '14px', fontWeight: '600',
          zIndex: '9999', transition: 'opacity 0.3s ease',
          pointerEvents: 'none'
        });
        document.body.appendChild(toast);
      }
      toast.textContent = (isError ? '❌ ' : '✅ ') + msg;
      toast.style.background = isError ? '#c0392b' : '#1a3d1f';
      toast.style.color      = '#fff';
      toast.style.opacity    = '1';
      clearTimeout(toast._timer);
      toast._timer = setTimeout(() => { toast.style.opacity = '0'; }, 2800);
    }

    /* ── Money formatter (respects shop currency) ── */
    _formatMoney(cents) {
      const amount = cents / 100;
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: window.Shopify?.currency?.active || 'USD' }).format(amount);
    }
  }

  /* ── Init all sections on page ── */
  function init() {
    qsa('[data-section-id]').forEach(section => {
      if (qs('.gruns-product-form', section)) {
        new GrunsProduct(section);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  /* ── Shopify theme editor live reload ── */
  document.addEventListener('shopify:section:load', (e) => {
    const section = e.target;
    if (qs('.gruns-product-form', section)) new GrunsProduct(section);
  });

})();
</script>