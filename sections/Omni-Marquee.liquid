<section class="omni-marquee">

<div class="marquee-track">

<div class="marquee-group">

{% for block in section.blocks %}

<div class="marquee-item" {{ block.shopify_attributes }}>

{% if block.settings.icon != blank %}

<img
src="{{ block.settings.icon | image_url: width: 80 }}"
alt="{{ block.settings.text }}"
class="marquee-icon"
>

{% endif %}

<p class="marquee-text">
{{ block.settings.text }}
</p>

</div>

{% endfor %}

</div>


<div class="marquee-group">

{% for block in section.blocks %}

<div class="marquee-item">

{% if block.settings.icon != blank %}

<img
src="{{ block.settings.icon | image_url: width: 80 }}"
alt="{{ block.settings.text }}"
class="marquee-icon"
>

{% endif %}

<p class="marquee-text">
{{ block.settings.text }}
</p>

</div>

{% endfor %}

</div>

</div>

</section>


<style>

#shopify-section-{{ section.id }} .omni-marquee{
background: {{ section.settings.bg_color }};
overflow:hidden;
padding-top: {{ section.settings.padding_top }}px;
padding-bottom: {{ section.settings.padding_bottom }}px;
}

#shopify-section-{{ section.id }} .marquee-track{
display:flex;
width:max-content;
animation:marquee-scroll 25s linear infinite;
}

#shopify-section-{{ section.id }} .marquee-group{
display:flex;
}

#shopify-section-{{ section.id }} .marquee-item{
display:flex;
align-items:center;
gap:10px;
padding:0 40px;
white-space:nowrap;
}

#shopify-section-{{ section.id }} .marquee-icon{
  width:64px;
  height:64px;
}

#shopify-section-{{ section.id }} .marquee-text{
color:#fff;
font-size:32px;
font-weight:600;
text-transform:uppercase;
}


@keyframes marquee-scroll{

0%{
transform:translateX(0);
}

100%{
transform:translateX(-50%);
}

}

</style>



{% schema %}
{
"name": "OMNI Marquee",

"settings": [

{
"type": "color",
"id": "bg_color",
"label": "Background Color",
"default": "#355e9c"
},

{
"type": "range",
"id": "padding_top",
"label": "Padding Top",
"min": 0,
"max": 100,
"step": 2,
"default": 14
},

{
"type": "range",
"id": "padding_bottom",
"label": "Padding Bottom",
"min": 0,
"max": 100,
"step": 2,
"default": 14
}

],

"blocks":[

{
"type":"item",
"name":"Marquee Item",
"settings":[

{
"type":"image_picker",
"id":"icon",
"label":"Icon"
},

{
"type":"text",
"id":"text",
"label":"Text",
"default":"VEGAN FORMULA"
}

]
}

],

"presets":[
{
"name":"OMNI Marquee"
}
]

}
{% endschema %}