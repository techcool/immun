{% style %}
.section-modern-living-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg_color }};
}

.section-modern-living-{{ section.id }} .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}


{% endstyle %}

<section class="section-modern-living-{{ section.id }} {{ section.settings.custom_class }}">
  <div class="container page-width">
    <div class="modern-living-wrapper">

      <!-- LEFT CONTENT -->
      <div class="modern-living-content">
        
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="subheading">{{ section.settings.subheading }}</div>
        {% endif %}

        <div class="stats-wrapper">
          
          <div class="stat-item">
            <h3>{{ section.settings.stat_one_number }}</h3>
            <p>{{ section.settings.stat_one_text }}</p>
          </div>

          <div class="stat-item">
            <h3>{{ section.settings.stat_two_number }}</h3>
            <p>{{ section.settings.stat_two_text }}</p>
          </div>

        </div>

        {% if section.settings.button_label != blank %}
          <div class="modern-living-btn">
            <a href="{{ section.settings.button_link }}">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}

      </div>

      <!-- RIGHT IMAGE -->
      <div class="modern-living-image">
        {% if section.settings.image != blank %}
          <img 
            src="{{ section.settings.image | image_url: width: 800 }}" 
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
          >
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Modern Living Stats",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modern Living Leaves Our Bodies Deficient"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Grüns is the first smart gummy that fills the gaps."
    },
    {
      "type": "text",
      "id": "stat_one_number",
      "label": "First Stat Number",
      "default": "90%"
    },
    {
      "type": "textarea",
      "id": "stat_one_text",
      "label": "First Stat Description",
      "default": "of U.S. adults don’t meet recommended daily nutrient intake—including vitamins and minerals."
    },
    {
      "type": "text",
      "id": "stat_two_number",
      "label": "Second Stat Number",
      "default": "61%"
    },
    {
      "type": "textarea",
      "id": "stat_two_text",
      "label": "Second Stat Description",
      "default": "of Americans experience weekly digestive issues like bloating, abdominal pain, or irregularity."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Save 52% + Free Shipping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#dfeee6"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Modern Living Stats"
    }
  ]
}
{% endschema %}