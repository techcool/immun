{% style %}
.section-modern-living-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg_color }};
}

.section-modern-living-{{ section.id }} .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.modern-living-wrapper {
  display: flex;
  align-items: center;
  gap: 60px;
  background: #ffffff;
  border-radius: 20px;
  overflow: hidden;
}

.modern-living-content {
  flex: 1;
  padding: 60px;
}

.modern-living-content h2 {
  font-size: 42px;
  font-weight: 700;
  color: #0b6b3a;
  margin-bottom: 15px;
}

.modern-living-content .subheading {
  font-size: 18px;
  margin-bottom: 40px;
  color: #333;
}

.stats-wrapper {
  display: flex;
  gap: 50px;
  margin-bottom: 40px;
}

.stat-item h3 {
  font-size: 70px;
  color: #0b6b3a;
  margin: 0;
}

.stat-item p {
  font-size: 15px;
  color: #333;
  margin-top: 15px;
  line-height: 1.6;
}

.modern-living-btn a {
  display: inline-block;
  background: #0b6b3a;
  color: #fff;
  padding: 16px 35px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 600;
  transition: 0.3s ease;
}

.modern-living-btn a:hover {
  background: #084f2a;
}

.modern-living-image {
  flex: 1;
  height: 100%;
}

.modern-living-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Responsive */
@media (max-width: 991px) {
  .modern-living-wrapper {
    flex-direction: column;
  }

  .modern-living-content {
    padding: 40px 25px;
  }

  .stats-wrapper {
    flex-direction: column;
    gap: 30px;
  }

  .modern-living-content h2 {
    font-size: 32px;
  }

  .stat-item h3 {
    font-size: 48px;
  }
}
{% endstyle %}

<section class="section-modern-living-{{ section.id }} {{ section.settings.custom_class }}">
  <div class="container page-width">
    <div class="modern-living-wrapper">

      <!-- LEFT CONTENT -->
      <div class="modern-living-content">
        
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="subheading">{{ section.settings.subheading }}</div>
        {% endif %}

        <div class="stats-wrapper">
          
          <div class="stat-item">
            <h3>{{ section.settings.stat_one_number }}</h3>
            <p>{{ section.settings.stat_one_text }}</p>
          </div>

          <div class="stat-item">
            <h3>{{ section.settings.stat_two_number }}</h3>
            <p>{{ section.settings.stat_two_text }}</p>
          </div>

        </div>

        {% if section.settings.button_label != blank %}
          <div class="modern-living-btn">
            <a href="{{ section.settings.button_link }}">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}

      </div>

      <!-- RIGHT IMAGE -->
      <div class="modern-living-image">
        {% if section.settings.image != blank %}
          <img 
            src="{{ section.settings.image | image_url: width: 800 }}" 
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
          >
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Modern Living Stats",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modern Living Leaves Our Bodies Deficient"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Grüns is the first smart gummy that fills the gaps."
    },
    {
      "type": "text",
      "id": "stat_one_number",
      "label": "First Stat Number",
      "default": "90%"
    },
    {
      "type": "textarea",
      "id": "stat_one_text",
      "label": "First Stat Description",
      "default": "of U.S. adults don’t meet recommended daily nutrient intake—including vitamins and minerals."
    },
    {
      "type": "text",
      "id": "stat_two_number",
      "label": "Second Stat Number",
      "default": "61%"
    },
    {
      "type": "textarea",
      "id": "stat_two_text",
      "label": "Second Stat Description",
      "default": "of Americans experience weekly digestive issues like bloating, abdominal pain, or irregularity."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Save 52% + Free Shipping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#dfeee6"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Modern Living Stats"
    }
  ]
}
{% endschema %}