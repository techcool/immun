{% comment %} {% liquid
  assign selected_menu = linklists[section.settings.custom_menu]

  assign order = 'logo,menu,localization,search,drawer_search,actions'

  if shop.customer_accounts_enabled
    assign order = 'drawer_search,logo,menu,localization,search,actions'
  endif

  assign rows = 'top,bottom' | split: ','
  assign search_style = 'none'

  if section.settings.show_search
    assign search_style = 'modal'
  endif

  if section.settings.enable_transparent_header_home and template.name == 'index'
    assign transparent = 'always'
    assign transparent_color_scheme = section.settings.home_color_scheme
  elsif section.settings.enable_transparent_header_product and template.name == 'product'
    assign transparent = 'always'
    assign transparent_color_scheme = section.settings.product_color_scheme
  elsif section.settings.enable_transparent_header_collection and template.name == 'collection'
    assign transparent = 'always'
    assign transparent_color_scheme = section.settings.collection_color_scheme
  endif

  if section.settings.enable_sticky_header == 'always'
    assign sticky = 'always'
  elsif section.settings.enable_sticky_header == 'scroll-up'
    assign sticky = 'scroll-up'
  endif

  if transparent and sticky
    assign transparent = 'not-sticky'
  endif

  if transparent
    if transparent_color_scheme == 'inverse'
      assign transparent_color_scheme = 'color-' | append: section.settings.color_scheme_transparent
    else
      assign transparent_color_scheme = 'color-' | append: section.settings.color_scheme_top
    endif
  endif
%}

<header class="custom-common-header">
  <div class="header__row">
    <div class="header__columns">

      <!-- LEFT -->
      <div class="header__column header__column--left">
        <a href="{{ routes.root_url }}" class="header__logo">
          {% if settings.logo != blank %}
            <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}">
          {% else %}
            {{ shop.name }}
          {% endif %}
        </a>
      </div>

      <!-- CENTER MENU -->
      <div class="header__column header__column--center">
        {% if selected_menu != blank %}
          <nav class="custom-menu">
            <ul>
              {% for link in selected_menu.links %}
                <li>
                  <a href="{{ link.url }}">{{ link.title }}</a>

                  {% if link.links != blank %}
                    <ul class="submenu">
                      {% for child in link.links %}
                        <li>
                          <a href="{{ child.url }}">{{ child.title }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}

                </li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}
      </div>

      <!-- RIGHT -->
      <div class="header__column header__column--right">
        {% if section.settings.show_search %}
          <a href="{{ routes.search_url }}" class="header-icon">
            🔍
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" class="header-icon">
          🛒
        </a>
      </div>

    </div>
  </div>
</header>

<style>
.custom-common-header {
  width: 100%;
  background: #fff;
  border-bottom: 1px solid #eee;
}

.header__columns {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 15px 30px;
}

.header__column--center ul {
  display: flex;
  list-style: none;
  gap: 25px;
  margin: 0;
  padding: 0;
}

.header__column--center a {
  text-decoration: none;
  color: #000;
  font-weight: 500;
}

.submenu {
  display: none;
  position: absolute;
  background: #fff;
  padding: 10px;
  list-style: none;
}

.header__column--center li:hover .submenu {
  display: block;
}

.header__column--right {
  display: flex;
  justify-content: flex-end;
  gap: 15px;
}

.header-icon {
  text-decoration: none;
  font-size: 18px;
}

@media(max-width: 768px){
  .header__column--center {
    display:none;
  }
}
</style>

{% schema %}
{
  "name": "Custom Common Header",
  "tag": "header",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "custom_menu",
      "label": "Select Custom Menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Custom Common Header"
    }
  ]
}
{% endschema %} {% endcomment %}