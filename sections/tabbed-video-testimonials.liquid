{% schema %}
{
  "name": "Tabbed Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    }
  ],
  "blocks": [

    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "tab_id", "label": "Tab ID (unique)" },
        { "type": "text", "id": "tab_label", "label": "Tab Label" }
      ]
    },

    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "parent_tab", "label": "Parent Tab ID" },
        { "type": "richtext", "id": "content", "label": "Testimonial Content" },
        { "type": "text", "id": "author", "label": "Author Name" },
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "options": [
            { "value": "5", "label": "5 Stars" },
            { "value": "4", "label": "4 Stars" },
            { "value": "3", "label": "3 Stars" },
            { "value": "2", "label": "2 Stars" },
            { "value": "1", "label": "1 Star" }
          ],
          "default": "5"
        }
      ]
    },

    {
      "type": "review_video",
      "name": "Review Video",
      "settings": [
        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail" },
        { "type": "video", "id": "video_file", "label": "Upload Video (MP4)" },
        { "type": "text", "id": "video_url", "label": "Or YouTube/Vimeo URL" }
      ]
    }

  ],
  "presets": [
    { "name": "Advanced Tabbed Testimonials PRO" }
  ]
}
{% endschema %}


<section class="adv-tabs-pro" style="background: {{ section.settings.bg_color }}">
  <div class="container">

    <h2 class="section-heading">{{ section.settings.heading }}</h2>

    <!-- Tabs -->
    <div class="tabs">
      {% for block in section.blocks %}
        {% if block.type == 'tab' %}
          <button class="tab-btn {% if forloop.first %}active{% endif %}"
                  data-tab="{{ block.settings.tab_id }}">
            {{ block.settings.tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Tab Content -->
    {% for tab in section.blocks %}
      {% if tab.type == 'tab' %}
        <div class="tab-content {% if forloop.first %}active{% endif %}"
             id="{{ tab.settings.tab_id }}">

          <div class="testimonial-grid">
            {% for block in section.blocks %}
              {% if block.type == 'testimonial' and block.settings.parent_tab == tab.settings.tab_id %}
                <div class="testimonial-card">

                  <!-- Dynamic Rating -->
                  <div class="stars">
                    {% assign rating = block.settings.rating | plus: 0 %}
                    {% for i in (1..5) %}
                      {% if i <= rating %}
                        ★
                      {% else %}
                        ☆
                      {% endif %}
                    {% endfor %}
                  </div>

                  <div class="content">
                    {{ block.settings.content }}
                  </div>

                  <div class="author">
                    {{ block.settings.author }}
                  </div>

                </div>
              {% endif %}
            {% endfor %}
          </div>

        </div>
      {% endif %}
    {% endfor %}

    <!-- Video Section -->
    <div class="review-video-section">
      <div class="video-grid">

        {% for block in section.blocks %}
          {% if block.type == 'review_video' %}
            <div class="video-item">
              <div class="video-wrapper">

                {% if block.settings.video_file != blank %}
                  {{ block.settings.video_file | video_tag: controls: true, autoplay: false, loop: false }}

                {% elsif block.settings.video_url != blank %}
                  <iframe width="100%" height="315"
                    src="{{ block.settings.video_url }}"
                    frameborder="0"
                    allowfullscreen>
                  </iframe>

                {% endif %}

              </div>
            </div>
          {% endif %}
        {% endfor %}

      </div>
    </div>

  </div>
</section>


<style>
.adv-tabs-pro { padding:80px 20px; }
.container { max-width:1200px; margin:auto; }
.section-heading { text-align:center; margin-bottom:40px; }

.tabs {
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
  margin-bottom:40px;
}
.tab-btn {
  padding:10px 22px;
  border-radius:30px;
  border:1px solid #000;
  background:transparent;
  cursor:pointer;
}
.tab-btn.active { background:#000; color:#fff; }

.tab-content { display:none; }
.tab-content.active { display:block; }

.testimonial-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:30px;
  margin-bottom:60px;
}

.testimonial-card {
  background:#fff;
  padding:25px;
  border-radius:12px;
}

.stars {
  font-size:18px;
  color:#f5b301;
  margin-bottom:10px;
}

.review-video-section { margin-top:40px; }
.video-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

@media(max-width:991px){
  .testimonial-grid { grid-template-columns:repeat(2,1fr); }
  .video-grid { grid-template-columns:repeat(2,1fr); }
}

@media(max-width:600px){
  .testimonial-grid,
  .video-grid { grid-template-columns:1fr; }
}
</style>


<script>
document.addEventListener("DOMContentLoaded", function(){

  const tabs = document.querySelectorAll(".tab-btn");
  const contents = document.querySelectorAll(".tab-content");

  tabs.forEach(btn=>{
    btn.addEventListener("click", function(){
      tabs.forEach(b=>b.classList.remove("active"));
      contents.forEach(c=>c.classList.remove("active"));

      this.classList.add("active");
      document.getElementById(this.dataset.tab).classList.add("active");
    });
  });

});
</script>