{% schema %}
{
  "name": "Tabbed Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join 1,000,000+ Others Filling Nutrition Gaps"
    },
    {
      "type": "text",
      "id": "review_tab_id",
      "label": "Review Tab ID (must match one tab ID exactly)",
      "default": "review"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#dfe9e2"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_id",
          "label": "Tab ID (lowercase, no spaces)"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab Label"
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "parent_tab",
          "label": "Parent Tab ID"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Testimonial Text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ]
    },
    {
      "type": "review_video",
      "name": "Review Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "YouTube or MP4 URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Testimonials + Review Video"
    }
  ]
}
{% endschema %}

<section class="custom-tabs" style="background: {{ section.settings.bg_color }}">
  <div class="container">

    <h2 class="heading">{{ section.settings.heading }}</h2>

    <!-- Tabs -->
    <div class="tabs">
      {% for block in section.blocks %}
        {% if block.type == 'tab' %}
          <button class="tab-btn {% if forloop.first %}active{% endif %}"
                  data-tab="{{ block.settings.tab_id }}">
            {{ block.settings.tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Testimonials Content -->
    {% for tab in section.blocks %}
      {% if tab.type == 'tab' %}
        <div class="tab-content {% if forloop.first %}active{% endif %}"
             id="{{ tab.settings.tab_id }}">

          <div class="testimonial-grid">
            {% for block in section.blocks %}
              {% if block.type == 'testimonial' and block.settings.parent_tab == tab.settings.tab_id %}
                <div class="testimonial-item">
                  <div class="stars">★★★★★</div>
                  <p>{{ block.settings.content }}</p>
                  <strong>{{ block.settings.author }}</strong>
                </div>
              {% endif %}
            {% endfor %}
          </div>

        </div>
      {% endif %}
    {% endfor %}

    <!-- Review Video Section -->
    <div class="review-video-wrapper"
         id="review-video-wrapper"
         data-review-tab="{{ section.settings.review_tab_id }}">

      <div class="video-grid">
        {% for block in section.blocks %}
          {% if block.type == 'review_video' %}
            <div class="video-card">
              <div class="video-wrapper" data-video="{{ block.settings.video_url }}">
                <img src="{{ block.settings.thumbnail | image_url: width: 600 }}">
                <div class="play-btn">▶</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>

  </div>
</section>


<style>
.custom-tabs { padding:80px 20px; text-align:center; }
.container { max-width:1200px; margin:auto; }

.tabs { display:flex; justify-content:center; gap:10px; flex-wrap:wrap; margin-bottom:40px; }
.tab-btn {
  padding:10px 20px;
  border-radius:30px;
  border:1px solid #1b5e3c;
  background:transparent;
  cursor:pointer;
}
.tab-btn.active { background:#1b5e3c; color:#fff; }

.tab-content { display:none; }
.tab-content.active { display:block; }

.testimonial-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:30px;
}

.testimonial-item {
  background:#fff;
  padding:20px;
  border-radius:12px;
}

.review-video-wrapper { display:none; margin-top:50px; }

.video-grid {
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:20px;
}

.video-wrapper {
  position:relative;
  cursor:pointer;
}
.video-wrapper img {
  width:100%;
  border-radius:16px;
}
.play-btn {
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  font-size:30px;
  color:#fff;
}

@media(max-width:991px){
  .testimonial-grid { grid-template-columns:repeat(2,1fr); }
  .video-grid { grid-template-columns:repeat(2,1fr); }
}
@media(max-width:600px){
  .testimonial-grid,
  .video-grid { grid-template-columns:1fr; }
}
</style>


<script>
document.addEventListener("DOMContentLoaded", function(){

  const buttons = document.querySelectorAll(".tab-btn");
  const contents = document.querySelectorAll(".tab-content");
  const reviewWrapper = document.getElementById("review-video-wrapper");
  const reviewTabID = reviewWrapper.dataset.reviewTab;

  function checkReviewTab(activeID){
    if(activeID === reviewTabID){
      reviewWrapper.style.display = "block";
    } else {
      reviewWrapper.style.display = "none";
    }
  }

  buttons.forEach(btn=>{
    btn.addEventListener("click", function(){
      buttons.forEach(b=>b.classList.remove("active"));
      contents.forEach(c=>c.classList.remove("active"));

      this.classList.add("active");
      const activeID = this.dataset.tab;
      document.getElementById(activeID).classList.add("active");

      checkReviewTab(activeID);
    });
  });

  // Initial check
  const firstActive = document.querySelector(".tab-btn.active").dataset.tab;
  checkReviewTab(firstActive);

  // Video play
  document.querySelectorAll(".video-wrapper").forEach(wrapper=>{
    wrapper.addEventListener("click", function(){
      const videoURL = this.dataset.video;
      if(videoURL.includes("youtube")){
        this.innerHTML = `<iframe width="100%" height="315" src="${videoURL}?autoplay=1" frameborder="0" allowfullscreen></iframe>`;
      } else {
        this.innerHTML = `<video controls autoplay width="100%"><source src="${videoURL}" type="video/mp4"></video>`;
      }
    });
  });

});
</script>