{% schema %}
{
  "name": "Advanced Tabbed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Join 1,000,000+ Others Filling Nutrition Gaps"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    }
  ],
  "blocks": [

    /* ---------------- TAB BLOCK ---------------- */
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_id",
          "label": "Tab ID (unique, lowercase)"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab Label"
        },
        {
          "type": "select",
          "id": "layout_style",
          "label": "Tab Layout Style",
          "options": [
            { "value": "grid", "label": "Grid Layout" },
            { "value": "compact", "label": "Compact Layout" }
          ],
          "default": "grid"
        }
      ]
    },

    /* ---------------- TESTIMONIAL BLOCK ---------------- */
    {
      "type": "testimonial",
      "name": "Testimonial Item",
      "settings": [
        {
          "type": "text",
          "id": "parent_tab",
          "label": "Parent Tab ID"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Testimonial Content"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        }
      ]
    },

    /* ---------------- VIDEO BLOCK ---------------- */
    {
      "type": "review_video",
      "name": "Review Video Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Video Thumbnail"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "YouTube or MP4 URL"
        }
      ]
    }

  ],
  "presets": [
    {
      "name": "Advanced Tabbed Testimonials PRO"
    }
  ]
}
{% endschema %}

<section class="adv-tabs-pro" style="background: {{ section.settings.bg_color }};">
  <div class="container">

    <h2 class="section-heading">{{ section.settings.heading }}</h2>

    <!-- Tabs -->
    <div class="tabs">
      {% for block in section.blocks %}
        {% if block.type == 'tab' %}
          <button class="tab-btn {% if forloop.first %}active{% endif %}"
                  data-tab="{{ block.settings.tab_id }}">
            {{ block.settings.tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Tab Content -->
    {% for tab in section.blocks %}
      {% if tab.type == 'tab' %}
        <div class="tab-content {% if forloop.first %}active{% endif %}"
             id="{{ tab.settings.tab_id }}"
             data-layout="{{ tab.settings.layout_style }}">

          <div class="testimonial-wrapper layout-{{ tab.settings.layout_style }}">

            {% for block in section.blocks %}
              {% if block.type == 'testimonial' and block.settings.parent_tab == tab.settings.tab_id %}
                <div class="testimonial-card">

                  {% if block.settings.author_image != blank %}
                    <img class="author-img"
                         src="{{ block.settings.author_image | image_url: width: 80 }}"
                         alt="">
                  {% endif %}

                  <div class="stars">★★★★★</div>

                  <div class="content">
                    {{ block.settings.content }}
                  </div>

                  <div class="author">
                    {{ block.settings.author }}
                  </div>

                </div>
              {% endif %}
            {% endfor %}

          </div>

        </div>
      {% endif %}
    {% endfor %}

    <!-- Separate Video Section -->
    <div class="review-video-section">

      <div class="video-grid">
        {% for block in section.blocks %}
          {% if block.type == 'review_video' %}
            <div class="video-item">
              <div class="video-wrapper" data-video="{{ block.settings.video_url }}">
                {% if block.settings.thumbnail != blank %}
                  <img src="{{ block.settings.thumbnail | image_url: width: 600 }}">
                {% endif %}
                <span class="play-btn">▶</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>

  </div>
</section>

<style>
.adv-tabs-pro { padding:80px 20px; }
.container { max-width:1200px; margin:auto; }

.section-heading { text-align:center; margin-bottom:40px; }

.tabs {
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
  margin-bottom:40px;
}
.tab-btn {
  padding:10px 22px;
  border-radius:30px;
  border:1px solid #111;
  background:transparent;
  cursor:pointer;
}
.tab-btn.active {
  background:#111;
  color:#fff;
}

.tab-content { display:none; }
.tab-content.active { display:block; }

/* Layout Variations */
.layout-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:30px;
}
.layout-compact {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:20px;
}

.testimonial-card {
  background:#fff;
  padding:25px;
  border-radius:12px;
}
.author-img {
  width:60px;
  height:60px;
  border-radius:50%;
  margin-bottom:10px;
}
.stars { margin-bottom:10px; }
.author { margin-top:10px; font-weight:bold; }

/* Video Section */
.review-video-section {
  margin-top:60px;
}
.video-grid {
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:20px;
}
.video-wrapper {
  position:relative;
  cursor:pointer;
}
.video-wrapper img {
  width:100%;
  border-radius:16px;
}
.play-btn {
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  font-size:30px;
  color:#fff;
}

@media(max-width:991px){
  .layout-grid { grid-template-columns:repeat(2,1fr); }
  .video-grid { grid-template-columns:repeat(2,1fr); }
}
@media(max-width:600px){
  .layout-grid,
  .layout-compact,
  .video-grid { grid-template-columns:1fr; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){

  const tabs = document.querySelectorAll(".tab-btn");
  const contents = document.querySelectorAll(".tab-content");

  tabs.forEach(btn=>{
    btn.addEventListener("click", function(){
      tabs.forEach(b=>b.classList.remove("active"));
      contents.forEach(c=>c.classList.remove("active"));

      this.classList.add("active");
      document.getElementById(this.dataset.tab).classList.add("active");
    });
  });

  document.querySelectorAll(".video-wrapper").forEach(wrapper=>{
    wrapper.addEventListener("click", function(){
      const videoURL = this.dataset.video;

      if(videoURL.includes("youtube") || videoURL.includes("youtu.be")){
        this.innerHTML = `<iframe width="100%" height="315" src="${videoURL}?autoplay=1" frameborder="0" allowfullscreen></iframe>`;
      } else {
        this.innerHTML = `<video controls autoplay width="100%"><source src="${videoURL}" type="video/mp4"></video>`;
      }
    });
  });

});
</script>