{% style %}
.product-offer {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  max-width: 1200px;
  margin: auto;
  padding: 50px 20px;
}

.product-gallery img {
  width: 100%;
  border-radius: 12px;
}

.thumbnail-list {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.thumbnail-list img {
  width: 70px;
  cursor: pointer;
  border: 2px solid transparent;
  border-radius: 6px;
}

.thumbnail-list img.active {
  border-color: #0a7d3b;
}

.product-info h2 {
  font-size: 28px;
  margin-bottom: 10px;
}

.price {
  font-size: 22px;
  color: #0a7d3b;
  margin-bottom: 15px;
}

.variant-buttons button {
  padding: 10px 15px;
  margin-right: 10px;
  border: 1px solid #ddd;
  cursor: pointer;
  border-radius: 6px;
}

.variant-buttons button.active {
  background: #0a7d3b;
  color: #fff;
}

.qty-selector {
  display: flex;
  margin: 20px 0;
}

.qty-selector button {
  width: 40px;
}

.qty-selector input {
  width: 50px;
  text-align: center;
}

.subscribe-box {
  border: 1px solid #ddd;
  padding: 15px;
  border-radius: 10px;
  margin-top: 20px;
}

.add-to-cart {
  background: #0a7d3b;
  color: #fff;
  padding: 15px;
  width: 100%;
  border: none;
  border-radius: 8px;
  margin-top: 20px;
  cursor: pointer;
}

@media(max-width:768px){
  .product-offer {
    grid-template-columns: 1fr;
  }
}
{% endstyle %}

<div class="product-offer">

  <!-- LEFT: IMAGE GALLERY -->
  <div class="product-gallery">
    <img id="mainImage" src="{{ product.featured_image | img_url: '600x' }}">

    <div class="thumbnail-list">
      {% for image in product.images %}
        <img src="{{ image | img_url: '100x' }}" onclick="changeImage(this)">
      {% endfor %}
    </div>
  </div>

  <!-- RIGHT: PRODUCT INFO -->
  <div class="product-info">
    
    <h2>{{ product.title }}</h2>
    
    <div class="price">
      {{ product.price | money }}
    </div>

    <p>{{ product.description | strip_html | truncate: 120 }}</p>

    <!-- VARIANT BUTTONS -->
    {% if product.variants.size > 1 %}
    <div class="variant-buttons">
      {% for variant in product.variants %}
        <button onclick="selectVariant({{ variant.id }}, this)">
          {{ variant.title }}
        </button>
      {% endfor %}
    </div>
    {% endif %}

    <!-- QUANTITY -->
    <div class="qty-selector">
      <button onclick="changeQty(-1)">-</button>
      <input type="number" id="qty" value="1" min="1">
      <button onclick="changeQty(1)">+</button>
    </div>

    <!-- SUBSCRIBE BOX -->
    <div class="subscribe-box">
      <label>
        <input type="radio" name="purchase" checked> One-time purchase
      </label><br>
      <label>
        <input type="radio" name="purchase"> Subscribe & Save
      </label>
    </div>

    <!-- ADD TO CART -->
    <form method="post" action="/cart/add">
      <input type="hidden" name="id" id="variantId" value="{{ product.variants.first.id }}">
      <input type="hidden" name="quantity" id="cartQty" value="1">

      <button type="submit" class="add-to-cart">
        Add to Cart
      </button>
    </form>

  </div>

</div>

<script>
function changeImage(el){
  document.getElementById('mainImage').src = el.src;
}

function changeQty(val){
  let qty = document.getElementById('qty');
  let newVal = parseInt(qty.value) + val;
  if(newVal >= 1){
    qty.value = newVal;
    document.getElementById('cartQty').value = newVal;
  }
}

function selectVariant(id, el){
  document.getElementById('variantId').value = id;

  document.querySelectorAll('.variant-buttons button').forEach(btn=>{
    btn.classList.remove('active');
  });

  el.classList.add('active');
}
</script>

{% schema %}
{
  "name": "Product Offer Section",
  "settings": [],
  "presets": [
    {
      "name": "Product Offer"
    }
  ]
}
{% endschema %}