        "testimonial_VjUddP": {
          "type": "testimonial",
          "settings": {
            "parent_tab": "taste",
            "content": "<p><strong>10/10 would recommend. The convenience and taste are huge! Like mixed berries!</strong><br/><br/>Plus not having to clean a shaker bottle or extra dishes for greens stuff in powder form, is absolutely excellent!</p>",
            "author": "Dustin O.",
